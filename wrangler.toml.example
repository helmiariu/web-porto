# Example Cloudflare Wrangler configuration for Astro.js

name = "porto-astro-web"
pages_build_output_dir = ".vercel/output" # or "dist" (depending on build setup)

# KV namespaces required for rate limiting
[[kv_namespaces]]
binding = "CHAT_LIMITS"
id = "YOUR_KV_NAMESPACE_ID_HERE"
preview_id = "YOUR_KV_PREVIEW_NAMESPACE_ID_HERE" # Optional: for local development / preview

# Enable Cloudflare Workers AI binding
[ai]
binding = "AI"
