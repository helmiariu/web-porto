---
import { SidebarTrigger } from './ui/sidebar';
import { Separator } from './ui/separator';
import { ProfileDropdown } from './profile-dropdown';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="z-50 h-16 border-b bg-background sticky top-0 w-full header-fixed peer/header">
  <div class="relative flex h-full items-center gap-3 p-4 sm:gap-4">
    <!-- SidebarTrigger island -->
    <SidebarTrigger client:load className="max-md:scale-125 hover:bg-accent hover:text-accent-foreground" />
    
    <Separator orientation="vertical" className="h-6 bg-border" client:load />
    
    <div class="flex flex-1 items-center justify-between space-x-2 md:justify-end">
      <div class="w-full flex-1 md:w-auto md:flex-none">
        <span class="text-sm font-medium text-muted-foreground hidden md:inline-block">
          Dashboard Overview
        </span>
      </div>
      <nav class="flex items-center space-x-2">
        <ThemeToggle />
        <ProfileDropdown client:load />
      </nav>
    </div>
  </div>
</header>
