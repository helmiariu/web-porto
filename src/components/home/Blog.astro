---
import CardBlog from "@components/ui/CardBlog.astro";
import { getCollection } from "astro:content";
import { ArrowRight } from "@lucide/astro";

const allPosts = await getCollection("blogs");
const latestPosts = allPosts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3); // Mengambil 3 artikel terbaru agar pas dengan grid-cols-3 di desktop
---

<section
    class="mb-10 pt-0 py-0 px-0 bg-background text-foreground antialiased transition-colors duration-300"
>
    <div class="flex items-center w-full mb-5">
        <h2
            class="text-[clamp(1.3rem,6vw,1.4rem)] font-bold tracking-tight text-foreground"
        >
            Blog
        </h2>
    </div>

    <div
        class="flex flex-row overflow-x-auto snap-x snap-mandatory gap-4 pb-4 lg:grid lg:grid-cols-1 lg:gap-6 lg:pb-0 scrollbar-none"
    >
        {
            latestPosts.map((post) => (
                <div class="w-[85%] sm:w-[60%] shrink-0 snap-center lg:w-full flex">
                    <CardBlog
                        title={post.data.title}
                        description={post.data.description}
                        pubDate={post.data.pubDate}
                        slug={post.id}
                        layout="list" // <--- Ditambahkan agar otomatis berbentuk vertikal proporsional di home desktop
                    />
                </div>
            ))
        }

        <div
            class="w-[45%] sm:w-[30%] shrink-0 snap-center flex items-stretch pr-2 lg:hidden"
        >
            <a
                href="/blog"
                class="flex flex-col items-center justify-center gap-2 w-full border border-dashed border-border dark:border-foreground/20 rounded-xl bg-muted/30 text-muted-foreground hover:text-foreground active:scale-[0.98] transition-all p-4"
            >
                <div
                    class="p-3 rounded-full bg-background border border-border shadow-xs"
                >
                    <ArrowRight class="h-5 w-5 text-foreground" />
                </div>
                <span class="text-xs font-semibold tracking-wide uppercase">View All</span>
            </a>
        </div>
    </div>

    <div class="hidden lg:flex justify-center mt-8 w-full">
        <a
            href="/blog"
            class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium transition-all border border-border dark:border-foreground/20 bg-background text-foreground hover:bg-muted h-10 px-6 shadow-xs active:scale-[0.98]"
        >
            <span>View All Articles</span>
            <ArrowRight class="h-4 w-4 shrink-0" />
        </a>
    </div>
</section>