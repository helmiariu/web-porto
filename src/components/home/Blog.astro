---
import CardBlog from "@components/ui/CardBlog.astro";
import { getCollection } from "astro:content";
import { ArrowRight } from "@lucide/astro";

const allPosts = await getCollection("blogs");
const latestPosts = allPosts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3); // Mengambil 3 artikel terbaru agar pas dengan grid-cols-3 di desktop
---

<section
    class="mb-10 md:mb-10 pt-0 md:pt-0 py-0 md:py-0 px-0 md:px-0 bg-background text-foreground antialiased transition-colors duration-300"
>
    <!-- Header simpel yang serasi dengan Projects -->
    <div class="flex items-center w-full mb-4">
        <p
            class="text-[clamp(1.3rem,6vw,1.4rem)] font-bold tracking-tight text-foreground"
        >
            Latest Articles
        </p>
    </div>

    <!-- Grid / Carousel Blog -->
    <div
        class="flex flex-row overflow-x-auto snap-x snap-mandatory gap-4 pb-4 md:grid md:grid-cols-3 md:gap-6 md:pb-0 scrollbar-none"
    >
        {
            latestPosts.map((post) => (
                <div class="w-[85%] shrink-0 snap-center md:w-full">
                    <CardBlog
                        title={post.data.title}
                        description={post.data.description}
                        pubDate={post.data.pubDate}
                        slug={post.id}
                    />
                </div>
            ))
        }

        <!-- KARTU KHUSUS MOBILE: Muncul di akhir horizontal scroll -->
        <div
            class="w-[40%] shrink-0 snap-center flex items-center justify-center pr-4 md:hidden"
        >
            <a
                href="/blog"
                class="flex flex-col items-center justify-center gap-2 w-full h-full min-h-[150px] border border-dashed border-border dark:border-foreground/20 rounded-md bg-muted/30 text-muted-foreground hover:text-foreground active:scale-[0.98] transition-all"
            >
                <div
                    class="p-3 rounded-full bg-background border border-border shadow-xs"
                >
                    <ArrowRight class="h-5 w-5 text-foreground" />
                </div>
                <span class="text-xs font-medium">View All</span>
            </a>
        </div>
    </div>

    <!-- TOMBOL KHUSUS DESKTOP: Muncul di bawah grid -->
    <div class="hidden md:flex justify-center mt-8 w-full">
        <a
            href="/blog"
            class="inline-flex items-center justify-center gap-2 rounded-sm text-sm font-medium transition-all border border-border dark:border-foreground/20 bg-background text-foreground hover:bg-muted h-9 px-5 shadow-sm active:scale-[0.98]"
        >
            <span>View All Articles</span>
            <ArrowRight class="h-4 w-4 shrink-0" />
        </a>
    </div>
</section>
