---
import CardBlog from "@components/ui/CardBlog.astro";
import { getCollection } from "astro:content";
import { ArrowRight } from "@lucide/astro";

const allPosts = await getCollection("blogs");
const latestPosts = allPosts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);

const featuredPost = latestPosts[0];
const remainingPosts = latestPosts.slice(1);
---

<section
    class="mb-10 pt-0 py-0 px-0 bg-background text-foreground antialiased transition-colors duration-300"
>
    <div class="flex items-center w-full mb-4">
        <h2
            class="text-[clamp(1.4rem,5vw,1.75rem)] font-bold tracking-tight text-foreground relative after:w-12 after:h-[3px] after:bg-primary after:mt-1 after:rounded-full"
        >
            Latest Articles
        </h2>
    </div>

    <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch"
    >
        {
            featuredPost && (
                <div class="w-full flex h-full md:col-span-2 lg:col-span-1">
                    <CardBlog
                        title={featuredPost.data.title}
                        description={featuredPost.data.description}
                        pubDate={featuredPost.data.pubDate}
                        slug={featuredPost.id}
                        layout="grid"
                    />
                </div>
            )
        }

        <div class="grid grid-cols-1 gap-6 h-full md:col-span-2 lg:col-span-2">
            {
                remainingPosts.map((post) => (
                    <div class="w-full flex flex-col h-full">
                        <div class="block lg:hidden w-full">
                            <CardBlog
                                title={post.data.title}
                                description={post.data.description}
                                pubDate={post.data.pubDate}
                                slug={post.id}
                                layout="vertical"
                            />
                        </div>

                        <div class="hidden lg:flex flex-1 w-full h-full">
                            <CardBlog
                                title={post.data.title}
                                description={post.data.description}
                                pubDate={post.data.pubDate}
                                slug={post.id}
                                layout="list"
                            />
                        </div>
                    </div>
                ))
            }
        </div>
    </div>

    <div class="flex justify-center mt-10 w-full">
        <a
            href="/blog"
            class="inline-flex items-center justify-center gap-2 rounded-xl text-sm font-semibold transition-all border border-border bg-background text-foreground hover:bg-muted/80 h-11 px-6 shadow-sm hover:shadow-md active:scale-[0.98]"
        >
            <span>View All Articles</span>
            <ArrowRight
                class="h-4 w-4 shrink-0 transition-transform group-hover:translate-x-1"
            />
        </a>
    </div>
</section>
