---
// src/components/home/FeaturedSection.astro
import { getCollection } from "astro:content";
import { InteractiveFeatured } from "./InteractiveFeatured";
import { getCfEnv, getDB } from "@/lib/cloudflare";
import { drizzle } from "drizzle-orm/d1";
import { softwareTools, albumMetadata } from "../../db/schema";

// 1. Fetch Blogs (sorted by pubDate descending, take top 2)
const rawBlogs = await getCollection("blogs");
const blogs = rawBlogs
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// 2. Fetch Projects (sorted by isFeatured descending, take top 2)
const rawProjects = await getCollection("project");
const projects = rawProjects
  .sort((a, b) => (b.data.isFeatured ? 1 : 0) - (a.data.isFeatured ? 1 : 0))
  .slice(0, 2);

// 3. Fetch 3D Gallery Albums dari R2 & D1 (ambil 2 teratas)
const rawDb = getDB();
const db = drizzle(rawDb);

let allSoftware: any[] = [];
let allMeta: any[] = [];

try {
  allSoftware = await db.select().from(softwareTools);
  allMeta = await db.select().from(albumMetadata);
} catch (e) {
  console.error("Gagal mengambil data dari database D1 untuk FeaturedSection:", e);
}

// Buat Map pencarian cepat
const softwareMap = new Map(allSoftware.map((s) => [s.slug, s]));
const metaMap = new Map(allMeta.map((m) => [m.albumSlug, m]));

// Inisialisasi R2
const cfEnv = getCfEnv();
const bucket = cfEnv.GALLERY_BUCKET;

interface AlbumData {
  name: string;
  title?: string;
  images: string[];
  modelUrl?: string;
  wireframeUrl?: string;
  softwareTools: any[];
}

const albumsMap: Record<string, AlbumData> = {};

if (bucket) {
  try {
    const response = await bucket.list({ prefix: "assets/3Dgallery/" });
    
    for (const obj of response.objects) {
      const key = obj.key;
      const parts = key.split("/");
      
      if (parts.length >= 4) {
        const albumSlug = parts[2]; // "helmet"
        const fileName = parts[3];  // "model.glb"
        
        if (!albumSlug) continue;

        if (!albumsMap[albumSlug]) {
          const dbMeta = metaMap.get(albumSlug);
          let tools: any[] = [];
          
          if (dbMeta) {
            try {
              const slugList = JSON.parse(dbMeta.softwareList) as string[];
              tools = slugList
                .map((slug) => softwareMap.get(slug))
                .filter(Boolean);
            } catch (jsonErr) {
              console.error(`Gagal melakukan parse softwareList untuk ${albumSlug} di FeaturedSection:`, jsonErr);
            }
          }

          albumsMap[albumSlug] = {
            name: albumSlug,
            title: dbMeta?.title,
            images: [],
            softwareTools: tools,
          };
        }

        const fileUrl = `/api/assets/${key}`;

        // Kategorikan File
        if (fileName.endsWith(".glb")) {
          if (fileName.toLowerCase().includes("wireframe")) {
            albumsMap[albumSlug].wireframeUrl = fileUrl;
          } else {
            albumsMap[albumSlug].modelUrl = fileUrl;
          }
        } else if (/\.(jpg|jpeg|png|webp|avif|gif|svg)$/i.test(fileName)) {
          albumsMap[albumSlug].images.push(fileUrl);
        }
      }
    }
  } catch (r2Err) {
    console.error("Gagal melakukan list object R2 di FeaturedSection:", r2Err);
  }
}

// Ambil 2 album teratas
const featuredAlbums = Object.values(albumsMap).slice(0, 2);
---

<section class="w-full py-8 text-foreground antialiased">
  {/* Header Section */}
  <div class="flex items-center justify-between mb-8">
    <div class="flex flex-col gap-1">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl text-foreground relative after:block after:w-16 after:h-[3px] after:bg-primary after:mt-1.5 after:rounded-full">
        Featured Creations
      </h2>
      <p class="text-xs sm:text-sm text-muted-foreground">
        A handpicked selection of my latest projects, articles, and 3D models.
      </p>
    </div>
  </div>

  <InteractiveFeatured client:load projects={projects} blogs={blogs} albums={featuredAlbums} />
</section>

