---
// src/components/Skills.astro
import { Icon } from "astro-icon/components";

const row1Skills = [
  { name: "HTML5", icon: "logos:html-5" },
  { name: "CSS3", icon: "logos:css-3" },
  { name: "JavaScript", icon: "logos:javascript" },
  { name: "TypeScript", icon: "logos:typescript-icon" },
  { name: "React", icon: "logos:react" },
  { name: "Astro", icon: "simple-icons:astro", color: "text-[#FF5D01]" }, // Custom warna Astro
  { name: "Tailwind CSS", icon: "logos:tailwindcss-icon" },
  { name: "Blender", icon: "logos:blender" },
  {
    name: "3D Maya",
    icon: "simple-icons:autodeskmaya",
    color: "text-[#37A5CC]",
  }, // Custom warna Maya
  { name: "AutoCAD", icon: "simple-icons:autocad", color: "text-[#E2231A]" }, // Custom warna AutoCAD
];

const row2Skills = [
  { name: "Node.js", icon: "logos:nodejs-icon" },
  { name: "Express", icon: "simple-icons:express" },
  { name: "PostgreSQL", icon: "logos:postgresql" },
  { name: "MongoDB", icon: "logos:mongodb-icon" },
  { name: "Prisma", icon: "simple-icons:prisma" },
  { name: "Git", icon: "logos:git-icon" },
  { name: "Docker", icon: "logos:docker-icon" },
  { name: "Figma", icon: "logos:figma" },
  { name: "Bun", icon: "logos:bun" },
];
---

<section
  class="w-full py-6 mb-12 overflow-hidden text-foreground skill-section-contain"
>
  {/* Header Section */}
  <div class="flex flex-col gap-1 w-full mb-5">
    <h2
      class="scroll-m20 text-xl font-bold tracking-tight sm:text-3xl text-foreground"
    >
      Skills
    </h2>
  </div>

  {/* Marquee Wrapper Container - GAP VERTIKAL DIKUNCI DI SINI */}
  <div class="flex flex-col gap-y-1.5 sm:gap-y-2 w-full relative">
    {/* Gradient Fading Effect - Kiri & Kanan */}
    <div
      class="absolute inset-y-0 left-0 w-1/6 bg-gradient-to-r from-background to-transparent z-10 pointer-events-none"
    >
    </div>
    <div
      class="absolute inset-y-0 right-0 w-1/6 bg-gradient-to-l from-background to-transparent z-10 pointer-events-none"
    >
    </div>

    {/* ================= BARIS PERTAMA ================= */}
    <div
      class="flex overflow-hidden select-none group w-full py-0.5 items-center"
    >
      <div
        class="flex gap-2 sm:gap-3.5 max-[415px]:gap-1.5 pr-2 sm:pr-3.5 max-[415px]:pr-1.5 shrink-0 animate-marquee-left map-container will-change-transform whitespace-nowrap group-hover:[animation-play-state:paused]"
      >
        {
          row1Skills.map((skill) => (
            <div class="inline-flex items-center justify-center gap-1.5 px-2.5 py-1.5 sm:px-4 sm:py-2 max-[415px]:px-2 max-[415px]:py-1 rounded-xl border border-border bg-card text-card-foreground font-desc  text-xs sm:text-sm max-[415px]:text-[11px] transition-all duration-200 ease-out hover:bg-accent hover:text-accent-foreground shadow-xs hover:scale-105">
              <Icon
                name={skill.icon}
                class={`w-3.5 h-3.5 sm:w-4 sm:h-4 flex-shrink-0 object-contain antialiased ${skill.color || ""}`}
              />
              <span>{skill.name}</span>
            </div>
          ))
        }
      </div>

      {/* Duplikat Baris Pertama (Looping) */}
      <div
        class="flex gap-2 sm:gap-3.5 max-[415px]:gap-1.5 pr-2 sm:pr-3.5 max-[415px]:pr-1.5 shrink-0 animate-marquee-left map-container will-change-transform whitespace-nowrap group-hover:[animation-play-state:paused]"
        aria-hidden="true"
      >
        {
          row1Skills.map((skill) => (
            <div class="inline-flex items-center justify-center gap-1.5 px-2.5 py-1.5 sm:px-4 sm:py-2 max-[415px]:px-2 max-[415px]:py-1 rounded-xl border border-border bg-card text-card-foreground font-desc  text-xs sm:text-sm max-[415px]:text-[11px] transition-all duration-200 ease-out hover:bg-accent hover:text-accent-foreground shadow-xs hover:scale-105">
              <Icon
                name={skill.icon}
                class={`w-3.5 h-3.5 sm:w-4 sm:h-4 flex-shrink-0 object-contain antialiased ${skill.color || ""}`}
              />
              <span>{skill.name}</span>
            </div>
          ))
        }
      </div>
    </div>

    {/* ================= BARIS KEDUA ================= */}
    <div
      class="flex overflow-hidden select-none group w-full py-0.5 items-center"
    >
      <div
        class="flex gap-2 sm:gap-3.5 max-[415px]:gap-1.5 pr-2 sm:pr-3.5 max-[415px]:pr-1.5 shrink-0 animate-marquee-right map-container will-change-transform whitespace-nowrap group-hover:[animation-play-state:paused]"
      >
        {
          row2Skills.map((skill) => (
            <div class="inline-flex items-center justify-center gap-1.5 px-2.5 py-1.5 sm:px-4 sm:py-2 max-[415px]:px-2 max-[415px]:py-1 rounded-xl border border-border bg-card text-card-foreground font-desc  text-xs sm:text-sm max-[415px]:text-[11px] transition-all duration-200 ease-out hover:bg-accent hover:text-accent-foreground shadow-xs hover:scale-105">
              <Icon
                name={skill.icon}
                class={`w-3.5 h-3.5 sm:w-4 sm:h-4 flex-shrink-0 object-contain antialiased ${skill.color || ""}`}
              />
              <span>{skill.name}</span>
            </div>
          ))
        }
      </div>

      {/* Duplikat Baris Kedua (Looping) */}
      <div
        class="flex gap-2 sm:gap-3.5 max-[415px]:gap-1.5 pr-2 sm:pr-3.5 max-[415px]:pr-1.5 shrink-0 animate-marquee-right map-container will-change-transform whitespace-nowrap group-hover:[animation-play-state:paused]"
        aria-hidden="true"
      >
        {
          row2Skills.map((skill) => (
            <div class="inline-flex items-center justify-center gap-1.5 px-2.5 py-1.5 sm:px-4 sm:py-2 max-[415px]:px-2 max-[415px]:py-1 rounded-xl border border-border bg-card text-card-foreground font-desc  text-xs sm:text-sm max-[415px]:text-[11px] transition-all duration-200 ease-out hover:bg-accent hover:text-accent-foreground shadow-xs hover:scale-105">
              <Icon
                name={skill.icon}
                class={`w-3.5 h-3.5 sm:w-4 sm:h-4 flex-shrink-0 object-contain antialiased ${skill.color || ""}`}
              />
              <span>{skill.name}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Tetap mempertahankan optimasi performa Anda */
  .skill-section-contain {
    content-visibility: auto;
    contain-intrinsic-size: 200px;
  }

  .animate-marquee-left {
    animation: marqueeLeft 30s linear infinite;
  }

  .animate-marquee-right {
    animation: marqueeRight 30s linear infinite;
  }

  .will-change-transform {
    will-change: transform;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    perspective: 1000px;
  }

  @keyframes marqueeLeft {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-100%, 0, 0);
    }
  }

  @keyframes marqueeRight {
    0% {
      transform: translate3d(-100%, 0, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }
</style>
