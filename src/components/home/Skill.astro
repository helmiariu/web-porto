---
// src/components/Skills.astro
const getIconUrl = (icon: string, colorClass?: string) => {
  const [prefix, name] = icon.split(":");
  let url = `https://api.iconify.design/${prefix}/${name}.svg`;
  if (colorClass) {
    const hexMatch = colorClass.match(/#([A-Fa-f0-9]{6})/);
    if (hexMatch) {
      url += `?color=%23${hexMatch[1]}`;
    }
  }
  return url;
};

const row1Skills = [
  { name: "HTML5", icon: "logos:html-5" },
  { name: "CSS3", icon: "logos:css-3" },
  { name: "JavaScript", icon: "logos:javascript" },
  { name: "TypeScript", icon: "logos:typescript-icon" },
  { name: "React", icon: "logos:react" },
  { name: "Astro", icon: "simple-icons:astro", color: "text-[#FF5D01]" },
  { name: "Tailwind CSS", icon: "logos:tailwindcss-icon" },
  { name: "Blender", icon: "logos:blender" },
  {
    name: "3D Maya",
    icon: "simple-icons:autodeskmaya",
    color: "text-[#37A5CC]",
  },
  { name: "AutoCAD", icon: "simple-icons:autocad", color: "text-[#E2231A]" },
];

const row2Skills = [
  { name: "Node.js", icon: "logos:nodejs-icon" },
  { name: "Express", icon: "simple-icons:express" },
  { name: "PostgreSQL", icon: "logos:postgresql" },
  { name: "MongoDB", icon: "logos:mongodb-icon" },
  { name: "Prisma", icon: "simple-icons:prisma" },
  { name: "Git", icon: "logos:git-icon" },
  { name: "Docker", icon: "logos:docker-icon" },
  { name: "Figma", icon: "logos:figma" },
  { name: "Bun", icon: "logos:bun" },
  {
    name: "Cloudflare",
    icon: "simple-icons:cloudflare",
    color: "text-[#F38020]",
  },
  {
    name: "Supabase",
    icon: "simple-icons:supabase",
    color: "text-[#2ECC71]",
  },
];
---

<section class="w-full py-6 mb-12 overflow-hidden text-foreground">
  {/* Header Section */}
  <div class="flex flex-col gap-1 w-full mb-5">
    <h2
      class="scroll-m-20 text-xl font-bold tracking-tight sm:text-3xl text-foreground"
    >
      Skills
    </h2>
  </div>

  {/* Marquee Wrapper Container - SETTING VARIABEL GAP DI SINI */}
  <div
    class="flex flex-col gap-y-3 w-full relative [--gap:0.5rem] sm:[--gap:0.875rem] max-[415px]:[--gap:0.375rem]"
  >
    {/* Gradient Fading Effect - Kiri & Kanan */}
    <div
      class="absolute inset-y-0 left-0 w-1/6 bg-gradient-to-r from-background to-transparent z-10 pointer-events-none"
    >
    </div>
    <div
      class="absolute inset-y-0 right-0 w-1/6 bg-gradient-to-l from-background to-transparent z-10 pointer-events-none"
    >
    </div>

    {/* ================= BARIS PERTAMA ================= */}
    <div
      class="flex overflow-hidden select-none group w-full py-0.5 [gap:var(--gap)]"
    >
      {/* Asli */}
      <div
        class="flex shrink-0 [gap:var(--gap)] animate-marquee-left will-change-transform whitespace-nowrap group-hover:[animation-play-state:paused]"
      >
        {
          row1Skills.map((skill) => (
            <div class="inline-flex items-center justify-center gap-1.5 px-2.5 py-1.5 sm:px-4 sm:py-2 max-[415px]:px-2 max-[415px]:py-1 rounded-lg md:rounded-xl border border-border bg-card text-card-foreground text-xs sm:text-sm max-[415px]:text-[11px] transition-all duration-200 ease-out hover:bg-accent hover:text-accent-foreground shadow-xs hover:scale-105">
              <img
                src={getIconUrl(skill.icon, skill.color)}
                class="w-3.5 h-3.5 sm:w-4 sm:h-4 flex-shrink-0 object-contain antialiased"
                alt={skill.name}
                loading="lazy"
              />
              <span>{skill.name}</span>
            </div>
          ))
        }
      </div>

      {/* Duplikat 1 */}
      <div
        class="flex shrink-0 [gap:var(--gap)] animate-marquee-left will-change-transform whitespace-nowrap group-hover:[animation-play-state:paused]"
        aria-hidden="true"
      >
        {
          row1Skills.map((skill) => (
            <div class="inline-flex items-center justify-center gap-1.5 px-2.5 py-1.5 sm:px-4 sm:py-2 max-[415px]:px-2 max-[415px]:py-1 rounded-lg md:rounded-xl border border-border bg-card text-card-foreground text-xs sm:text-sm max-[415px]:text-[11px] transition-all duration-200 ease-out hover:bg-accent hover:text-accent-foreground shadow-xs hover:scale-105">
              <img
                src={getIconUrl(skill.icon, skill.color)}
                class="w-3.5 h-3.5 sm:w-4 sm:h-4 flex-shrink-0 object-contain antialiased"
                alt={skill.name}
                loading="lazy"
              />
              <span>{skill.name}</span>
            </div>
          ))
        }
      </div>

      {/* TAMBAHAN DUPLIKAT 2 (Untuk Layar Lebar) */}
      <div
        class="flex shrink-0 [gap:var(--gap)] animate-marquee-left will-change-transform whitespace-nowrap group-hover:[animation-play-state:paused]"
        aria-hidden="true"
      >
        {
          row1Skills.map((skill) => (
            /* Mengubah px-2.5 py-1.5 menjadi px-3 py-2 dan menghapus max-[415px] padding */
            <div class="inline-flex items-center justify-center gap-1.5 px-3 py-2 sm:px-4 sm:py-2 rounded-lg md:rounded-xl border border-border bg-card text-card-foreground text-xs sm:text-sm max-[415px]:text-[11px] transition-all duration-200 ease-out hover:bg-accent hover:text-accent-foreground shadow-xs hover:scale-105">
              <img
                src={getIconUrl(skill.icon, skill.color)}
                class="w-3.5 h-3.5 sm:w-4 sm:h-4 flex-shrink-0 object-contain antialiased"
                alt={skill.name}
                loading="lazy"
              />
              <span>{skill.name}</span>
            </div>
          ))
        }
      </div>

      {/* TAMBAHAN DUPLIKAT 3 (Untuk Layar Super Ultrawide) */}
      <div
        class="flex shrink-0 [gap:var(--gap)] animate-marquee-left will-change-transform whitespace-nowrap group-hover:[animation-play-state:paused]"
        aria-hidden="true"
      >
        {
          row1Skills.map((skill) => (
            <div class="inline-flex items-center justify-center gap-1.5 px-3 py-2 sm:px-4 sm:py-2 rounded-lg md:rounded-xl border border-border bg-card text-card-foreground text-xs sm:text-sm max-[415px]:text-[11px] transition-all duration-200 ease-out hover:bg-accent hover:text-accent-foreground shadow-xs hover:scale-105">
              <img
                src={getIconUrl(skill.icon, skill.color)}
                class="w-3.5 h-3.5 sm:w-4 sm:h-4 flex-shrink-0 object-contain antialiased"
                alt={skill.name}
                loading="lazy"
              />
              <span>{skill.name}</span>
            </div>
          ))
        }
      </div>
    </div>

    {/* ================= BARIS KEDUA ================= */}
    <div
      class="flex overflow-hidden select-none group w-full py-0.5 [gap:var(--gap)]"
    >
      {/* Asli */}
      <div
        class="flex shrink-0 [gap:var(--gap)] animate-marquee-right will-change-transform whitespace-nowrap group-hover:[animation-play-state:paused]"
      >
        {
          row2Skills.map((skill) => (
            <div class="inline-flex items-center justify-center gap-1.5 px-3 py-2 sm:px-4 sm:py-2 rounded-lg md:rounded-xl border border-border bg-card text-card-foreground text-xs sm:text-sm max-[415px]:text-[11px] transition-all duration-200 ease-out hover:bg-accent hover:text-accent-foreground shadow-xs hover:scale-105">
              <img
                src={getIconUrl(skill.icon, skill.color)}
                class="w-3.5 h-3.5 sm:w-4 sm:h-4 flex-shrink-0 object-contain antialiased"
                alt={skill.name}
                loading="lazy"
              />
              <span>{skill.name}</span>
            </div>
          ))
        }
      </div>

      {/* Duplikat 1 */}
      <div
        class="flex shrink-0 [gap:var(--gap)] animate-marquee-right will-change-transform whitespace-nowrap group-hover:[animation-play-state:paused]"
        aria-hidden="true"
      >
        {
          row2Skills.map((skill) => (
            <div class="inline-flex items-center justify-center gap-1.5 px-3 py-2 sm:px-4 sm:py-2 rounded-lg md:rounded-xl border border-border bg-card text-card-foreground text-xs sm:text-sm max-[415px]:text-[11px] transition-all duration-200 ease-out hover:bg-accent hover:text-accent-foreground shadow-xs hover:scale-105">
              <img
                src={getIconUrl(skill.icon, skill.color)}
                class="w-3.5 h-3.5 sm:w-4 sm:h-4 flex-shrink-0 object-contain antialiased"
                alt={skill.name}
                loading="lazy"
              />
              <span>{skill.name}</span>
            </div>
          ))
        }
      </div>

      {/* TAMBAHAN DUPLIKAT 2 (Untuk Layar Lebar) */}
      <div
        class="flex shrink-0 [gap:var(--gap)] animate-marquee-right will-change-transform whitespace-nowrap group-hover:[animation-play-state:paused]"
        aria-hidden="true"
      >
        {
          row2Skills.map((skill) => (
            <div class="inline-flex items-center justify-center gap-1.5 px-3 py-2 sm:px-4 sm:py-2 rounded-lg md:rounded-xl border border-border bg-card text-card-foreground text-xs sm:text-sm max-[415px]:text-[11px] transition-all duration-200 ease-out hover:bg-accent hover:text-accent-foreground shadow-xs hover:scale-105">
              <img
                src={getIconUrl(skill.icon, skill.color)}
                class="w-3.5 h-3.5 sm:w-4 sm:h-4 flex-shrink-0 object-contain antialiased"
                alt={skill.name}
                loading="lazy"
              />
              <span>{skill.name}</span>
            </div>
          ))
        }
      </div>

      {/* TAMBAHAN DUPLIKAT 3 (Untuk Layar Super Ultrawide) */}
      <div
        class="flex shrink-0 [gap:var(--gap)] animate-marquee-right will-change-transform whitespace-nowrap group-hover:[animation-play-state:paused]"
        aria-hidden="true"
      >
        {
          row2Skills.map((skill) => (
            <div class="inline-flex items-center justify-center gap-1.5 px-3 py-2 sm:px-4 sm:py-2 rounded-lg md:rounded-xl border border-border bg-card text-card-foreground text-xs sm:text-sm max-[415px]:text-[11px] transition-all duration-200 ease-out hover:bg-accent hover:text-accent-foreground shadow-xs hover:scale-105">
              <img
                src={getIconUrl(skill.icon, skill.color)}
                class="w-3.5 h-3.5 sm:w-4 sm:h-4 flex-shrink-0 object-contain antialiased"
                alt={skill.name}
                loading="lazy"
              />
              <span>{skill.name}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <style>
    .animate-marquee-left {
      animation: marqueeLeft 30s linear infinite;
    }

    .animate-marquee-right {
      animation: marqueeRight 30s linear infinite;
    }

    .will-change-transform {
      will-change: transform;
    }

    /* RUMUS UTAMA: Mengompensasi jarak gap yang fleksibel di berbagai device */
    @keyframes marqueeLeft {
      0% {
        transform: translate3d(0, 0, 0);
      }
      100% {
        transform: translate3d(calc(-100% - var(--gap)), 0, 0);
      }
    }

    @keyframes marqueeRight {
      0% {
        transform: translate3d(calc(-100% - var(--gap)), 0, 0);
      }
      100% {
        transform: translate3d(0, 0, 0);
      }
    }
  </style>
</section>
