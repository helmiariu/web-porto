---
// src/components/Hero.astro
import CTAButton from "@components/ui/CTAButton.astro";
import ResumeDropdown from "@components/ui/ResumeDropdown.astro";

const role = "About";
const bio =
  "Fokus membangun pengalaman web yang bersih, cepat, dan fungsional. Senang memecahkan masalah kompleks lewat baris kode yang minimalis dan terstruktur. Saya menggabungkan estetika desain dengan performa kode yang optimal untuk menciptakan produk digital yang berdampak.";
---

<section
  class="mb-10 md:mb-10 pt-4 md:pt-0 py-0 md:py-0 px-0 md:px-0 bg-background text-foreground antialiased transition-colors duration-300"
>
  <div class="flex items-center w-full mb-2">
    <h2
      class="text-[clamp(1.4rem,5vw,1.75rem)] font-bold tracking-tight text-foreground relative after:w-12 after:h-[3px] after:bg-primary after:mt-1 after:rounded-full"
    >
      {role}
    </h2>
  </div>
  <div class="w-full md:w-full md:max-w-full space-y-3">
    <p
      class="text-[clamp(0.90rem,1.5vw,1rem)] opacity-80 font-[450] text-muted-foreground leading-relaxed md:leading-relaxed"
    >
      {bio}
    </p>

    <div class="flex items-center gap-3 pt-1 w-full">
      <CTAButton text="Contact Me" link="/contact" variant="primary" />
      <ResumeDropdown />
    </div>
  </div>
</section>
