---
// src/components/Hero.astro
import { buttonVariants } from "@components/components/ui/button";
import ResumeDropdown from "@components/ui/ResumeDropdown.astro";
import { cn } from "@components/lib/utils";

const title = "About";
const bio =
  "Fokus membangun pengalaman web yang bersih, cepat, dan fungsional. Senang memecahkan masalah kompleks lewat baris kode yang minimalis dan terstruktur. Saya menggabungkan estetika desain dengan performa kode yang optimal untuk menciptakan produk digital yang berdampak.5";
---

<section
  class="mb-10 md:mb-10 pt-4 md:pt-0 py-0 md:py-0 px-0 md:px-0 text-foreground antialiased transition-colors duration-300"
>
  <div class="flex items-center w-full mb-2">
    <!-- Menghapus text-foreground redundan karena sudah diwariskan dari tag section di atasnya -->
    <h2
      class="text-[clamp(1.4rem,5vw,1.70rem)] font-bold tracking-tight relative after:w-12 after:h-[3px] after:bg-primary after:mt-1 after:rounded-full"
    >
      {title}
    </h2>
  </div>
  <div class="w-full md:w-full md:max-w-full space-y-3">
    <p
      class="text-foreground/80 text-sm md:text-base font-normal tracking-tight leading-relaxed md:leading-relaxed"
    >
      {bio}
    </p>

    <div class="flex items-center gap-3 pt-1 w-full">
      <a
        href="/contact"
        class={cn(
          buttonVariants({ variant: "default" }),
          "h-10 px-4 text-sm font-semibold gap-2 rounded-lg",
        )}
      >
        Contact
      </a>

      <ResumeDropdown />
    </div>
  </div>
</section>
