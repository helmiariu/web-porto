---
const role = "About";
const bio =
  "Fokus membangun pengalaman web yang bersih, cepat, dan fungsional. Senang memecahkan masalah kompleks lewat baris kode yang minimalis dan terstruktur. Saya menggabungkan estetika desain dengan performa kode yang optimal untuk menciptakan produk digital yang berdampak.";
---

<section
  class="mb-10 md:mb-10 pt-4 md:pt-0 py-0 md:py-0 px-0 md:px-0 bg-background text-foreground antialiased transition-colors duration-300"
>
  <div class="w-full md:w-full md:max-w-full space-y-3">
    <p
      class="text-[clamp(1.3rem,6vw,1.4rem)] font-bold tracking-tight text-foreground"
    >
      {role}
    </p>

    <p
      class="text-[clamp(1rem,1.5vw,1rem)] font-[450] text-muted-foreground leading-normal md:leading-relaxed"
    >
      {bio}
    </p>

    <div class="flex flex-wrap items-center gap-3 pt-1">
      <a
        href="#contact"
        class="inline-flex items-center justify-center rounded-lg text-sm font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-950 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-slate-900 text-slate-50 hover:bg-slate-900/90 h-10 px-4 py-2 shadow-sm active:scale-[0.98]"
      >
        Hubungi Saya
      </a>

      <a
        href="/blog"
        class="inline-flex items-center justify-center rounded-lg text-sm font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-950 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-slate-200 bg-white text-slate-900 hover:bg-slate-100 hover:text-slate-900 h-10 px-4 py-2 shadow-sm active:scale-[0.98]"
      >
        Lihat Karya
      </a>
    </div>
  </div>
</section>
