---
// Anda bisa menambahkan props jika ingin datanya dinamis
const name = "Hi, I'm Helmi Arimbawa";
const role = "Full-Stack Developer & Designer";
const bio = "Fokus membangun pengalaman web yang bersih, cepat, dan fungsional. Senang memecahkan masalah kompleks lewat baris kode yang minimalis dan terstruktur. Saya menggabungkan estetika desain dengan performa kode yang optimal untuk menciptakan produk digital yang berdampak.";
---

<section class="md:pt-0 py-12 md:py-20 px-2 sm:px-4 md:px-0 bg-background text-foreground transition-colors duration-300">
  <div class="space-y-6">

    <div class="space-y-2">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-primary">
        {name}
      </h1>
      <p class="text-lg md:text-xl font-semibold text-muted-foreground/90">
        {role}
      </p>
    </div>

    <p class="text-base text-muted-foreground leading-relaxed">
      {bio}
    </p>

    <div class="flex flex-wrap items-center gap-3 pt-2">
      <a 
        href="#contact" 
        class="px-4 py-2 text-sm font-medium bg-primary text-background hover:opacity-90 rounded-[var(--radius)] transition-all inline-flex items-center justify-center shadow-sm"
      >
        Hubungi Saya
      </a>
      <a 
        href="#projects" 
        class="px-4 py-2 text-sm font-medium bg-secondary text-foreground border border-border hover:bg-muted rounded-[var(--radius)] transition-all inline-flex items-center justify-center"
      >
        Lihat Karya
      </a>
    </div>
  </div>
</section>