---
// Anda bisa menambahkan props jika ingin datanya dinamis
const name = "Hi, I'm Helmi Arimbawa";
const role = "Full-Stack Developer & Designer";
const bio = "Fokus membangun pengalaman web yang bersih, cepat, dan fungsional. Senang memecahkan masalah kompleks lewat baris kode yang minimalis dan terstruktur. Saya menggabungkan estetika desain dengan performa kode yang optimal untuk menciptakan produk digital yang berdampak.";
---

<section class="md:pt-0 py-12 md:py-20 px-2 sm:px-4 md:px-0 bg-background text-foreground antialiased transition-colors duration-300">
  <div class="space-y-6 max-w-2xl"> <div class="space-y-2">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground">
        {name}
      </h1>
      <p class="text-lg md:text-xl font-medium text-muted-foreground">
        {role}
      </p>
    </div>

    <p class="text-base text-muted-foreground leading-relaxed">
      {bio}
    </p>

    <div class="flex flex-wrap items-center gap-3 pt-2">
      <a 
        href="#contact" 
        class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-55 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 shadow-sm"
      >
        Hubungi Saya
      </a>
      
      <a 
        href="#projects" 
        class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-55 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2"
      >
        Lihat Karya
      </a>
    </div>
  </div>
</section>