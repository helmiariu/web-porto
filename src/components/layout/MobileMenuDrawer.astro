---
// MobileMenuDrawer.astro
import { publicDashboardMenu } from "@lib/constants/navigation-menu.ts";
import { Menu, ArrowRight, User } from "@lucide/astro";

// Memanggil komponen utama ThemeToggle yang sudah optimal
import ThemeToggle from "@components/ui/ThemeToggle.astro";
---

<div
  id="mobile-dropdown-backdrop"
  class="md:hidden fixed inset-0 z-30 bg-zinc-900/40 dark:bg-black/50 backdrop-blur-[3px] opacity-0 pointer-events-none transition-opacity duration-300"
>
</div>

<div
  id="mobile-dropdown"
  class="md:hidden fixed inset-x-0 bottom-0 z-40 overflow-y-auto rounded-t-[2rem] border-t border-[hsl(var(--border))] bg-[hsl(var(--background))] p-5 shadow-2xl max-h-[75vh] opacity-0 pointer-events-none translate-y-4 transition-all duration-300"
>
  <div class="space-y-4 pb-22">
    <div
      class="rounded-2xl border border-[hsl(var(--border))] bg-[hsl(var(--secondary))/0.3] p-4"
    >
      <div class="flex items-center gap-3">
        <span
          class="grid h-12 w-12 place-items-center rounded-2xl bg-[hsl(var(--primary))]/10 text-[hsl(var(--foreground))]"
        >
          <span
            class="flex items-center justify-center h-5 w-5 [&>svg]:w-full [&>svg]:h-full [&>svg]:block"
          >
            <User />
          </span>
        </span>
        <div>
          <p class="text-sm font-semibold text-[hsl(var(--foreground))]">
            Helmi Arimbawa
          </p>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      {
        publicDashboardMenu.map((section) => (
          <div class="space-y-3">
            {section.groupLabel ? (
              <p class="text-[10px] font-semibold uppercase tracking-[.3em] text-[hsl(var(--foreground)/0.65)] pl-3">
                {section.groupLabel}
              </p>
            ) : null}
            <div class="flex flex-col gap-[6px]">
              {section.menus.map((item) => {
                const IconComponent = item.icon ?? Menu;

                return (
                  <a
                    href={item.href}
                    data-drawer-link
                    data-astro-prefetch="tap"
                    class="flex items-center justify-between rounded-xl border transition-all duration-200 cursor-pointer relative py-[6px] px-[12px] group border-transparent bg-transparent text-[hsl(var(--foreground)/0.6)] hover:bg-[hsl(var(--secondary))] hover:text-[hsl(var(--foreground))]"
                  >
                    <span class="flex items-center gap-3">
                      <span class="drawer-icon-span flex shrink-0 items-center justify-center transition-all duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[15px] [&>svg]:h-[15px] text-[hsl(var(--foreground)/0.6)] group-hover:text-[hsl(var(--foreground))]">
                        <IconComponent />
                      </span>
                      <span class="font-medium text-[14px]">{item.label}</span>
                    </span>
                    <span class="drawer-arrow-span items-center justify-center transition-all duration-200 absolute right-[12px] w-[19px] h-[19px] text-[hsl(var(--foreground))] [&>svg]:block [&>svg]:w-[13px] [&>svg]:h-[13px] hidden">
                      <ArrowRight />
                    </span>
                  </a>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>

    <div class="space-y-3">
      <ThemeToggle />
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const currentPath = window.location.pathname;
    const drawerLinks = document.querySelectorAll("[data-drawer-link]");

    drawerLinks.forEach((link) => {
      const href = link.getAttribute("href");
      const isActive =
        href === "/" ? currentPath === "/" : currentPath.startsWith(href || "");
      const iconSpan = link.querySelector(".drawer-icon-span");
      const arrowSpan = link.querySelector(".drawer-arrow-span");

      if (isActive) {
        link.className =
          "flex items-center justify-between rounded-xl border transition-all duration-200 cursor-pointer relative py-[6px] px-[12px] group border-[hsl(var(--border))] bg-[hsl(var(--secondary))] text-[hsl(var(--foreground))] shadow-sm";
        if (iconSpan)
          iconSpan.className =
            "drawer-icon-span flex shrink-0 items-center justify-center transition-all duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[15px] [&>svg]:h-[15px] text-[hsl(var(--foreground))]";
        if (arrowSpan)
          arrowSpan.className =
            "drawer-arrow-span items-center justify-center transition-all duration-200 absolute right-[12px] w-[19px] h-[19px] text-[hsl(var(--foreground))] [&>svg]:block [&>svg]:w-[13px] [&>svg]:h-[13px] flex";
      } else {
        link.className =
          "flex items-center justify-between rounded-xl border transition-all duration-200 cursor-pointer relative py-[6px] px-[12px] group border-transparent bg-transparent text-[hsl(var(--foreground)/0.6)] hover:bg-[hsl(var(--secondary))] hover:text-[hsl(var(--foreground))]";
        if (iconSpan)
          iconSpan.className =
            "drawer-icon-span flex shrink-0 items-center justify-center transition-all duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[15px] [&>svg]:h-[15px] text-[hsl(var(--foreground)/0.6)] group-hover:text-[hsl(var(--foreground))]";
        if (arrowSpan)
          arrowSpan.className =
            "drawer-arrow-span items-center justify-center transition-all duration-200 absolute right-[12px] w-[19px] h-[19px] text-[hsl(var(--foreground))] [&>svg]:block [&>svg]:w-[13px] [&>svg]:h-[13px] hidden";
      }
    });
  });
</script>
