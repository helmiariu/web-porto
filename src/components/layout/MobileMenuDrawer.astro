---
// MobileMenuDrawer.astro
import { publicDashboardMenu } from "@lib/constants/navigation-menu.ts";
import { Menu, ArrowRight, ChevronDown, ArrowUpRight } from "@lucide/astro";
import AvatarDropdown from "@components/ui/AvatarDropdown.astro";
import VerifiedBadge from "@components/ui/VerifiedBadge.astro";

// Memanggil komponen utama ThemeToggle yang sudah optimal
import ThemeToggle from "@components/ui/ThemeToggle.astro";
---

<div
  id="mobile-dropdown-backdrop"
  class="md:hidden fixed inset-0 z-30 bg-zinc-900/40 dark:bg-zinc-700/60 backdrop-blur-[3px] opacity-0 pointer-events-none transition-opacity duration-300"
>
</div>

<div
  id="mobile-dropdown"
  class="md:hidden fixed inset-x-0 bottom-0 z-40 overflow-y-auto rounded-t-3xl border-t border-border bg-background p-5 shadow-2xl max-h-[75vh] opacity-0 pointer-events-none translate-y-4 transition-all duration-300"
>
  <div class="space-y-4 pb-22">
    <AvatarDropdown
      sizeClass="h-16 w-16"
      showChevron={true}
      class="transition-all duration-50 ease-out"
    >
      <div class="flex items-center justify-between w-full pl-4 pr-3 py-1">
        <!-- Tambahkan gap-1 atau gap-0.5 di sini -->
        <div class="flex flex-col text-left gap-1">
          <p
            class="text-md font-semibold text-foreground leading-tight flex items-center gap-1"
          >
            Helmi Arimbawa
            <VerifiedBadge />
          </p>

          <!-- Hapus mt-0 atau biarkan saja karena gap sudah mengatur jaraknya -->
          <span
            class="flex items-center gap-1.5 text-xs text-muted-foreground font-sm"
          >
            me@domainku.my.id
          </span>
        </div>
      </div>
    </AvatarDropdown>
    <div
      class="flex flex-col rounded-2xl border border-border bg-background p-1 shadow-sm min-w-[260px]"
    >
      <div
        class="flex w-full items-center justify-between gap-4 p-3 pb-3 border-border/60"
      >
        <div class="flex flex-col text-left">
          <p class="text-sm font-semibold text-foreground leading-tight">
            Sign in
          </p>
          <span class="text-xs text-muted-foreground mt-1 leading-normal">
            To access all features and personalization
          </span>
        </div>

        <ArrowUpRight class="h-4 w-4 shrink-0 text-muted-foreground" />
      </div>
    </div>

    <div class="space-y-3">
      {
        publicDashboardMenu.map((section) => (
          <div class="space-y-3">
            {section.groupLabel ? (
              <p class="text-[10px] font-semibold uppercase tracking-[.3em] text-primary/85 pl-3">
                {section.groupLabel}
              </p>
            ) : null}
            <div class="flex flex-col gap-[6px]">
              {section.menus.map((item) => {
                const IconComponent = item.icon ?? Menu;

                return (
                  <a
                    href={item.href}
                    data-drawer-link
                    data-astro-prefetch="tap"
                    class="flex items-center justify-between rounded-lg border transition-all duration-200 cursor-pointer relative py-[6px] px-[12px] group border-transparent bg-transparent text-muted-foreground hover:bg-accent hover:text-accent-foreground"
                  >
                    <span class="flex items-center gap-3">
                      <span class="drawer-icon-span flex shrink-0 items-center justify-center transition-all duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[15px] [&>svg]:h-[15px] text-muted-foreground group-hover:text-accent-foreground">
                        <IconComponent />
                      </span>
                      <span class="font-medium text-[14px]">{item.label}</span>
                    </span>
                    <span class="drawer-arrow-span items-center justify-center transition-all duration-200 absolute right-[12px] w-[19px] h-[19px] text-accent-foreground [&>svg]:block [&>svg]:w-[13px] [&>svg]:h-[13px] hidden">
                      <ArrowRight />
                    </span>
                  </a>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>

    <div class="space-y-3">
      <ThemeToggle />
    </div>
  </div>
</div>
