---
// MobileMenuDrawer.astro
import { publicDashboardMenu } from "@lib/constants/navigation-menu.ts";
import { Menu, ArrowRight, ChevronDown } from "@lucide/astro";
import AvatarDropdown from "@components/ui/AvatarDropdown.astro";

// Memanggil komponen utama ThemeToggle yang sudah optimal
import ThemeToggle from "@components/ui/ThemeToggle.astro";
---

<div
  id="mobile-dropdown-backdrop"
  class="md:hidden fixed inset-0 z-30 bg-zinc-900/40 dark:bg-zinc-700/60 backdrop-blur-[3px] opacity-0 pointer-events-none transition-opacity duration-300"
>
</div>

<div
  id="mobile-dropdown"
  class="md:hidden fixed inset-x-0 bottom-0 z-40 overflow-y-auto rounded-t-[2rem] border-t border-border bg-background p-5 shadow-2xl max-h-[75vh] opacity-0 pointer-events-none translate-y-4 transition-all duration-300"
>
  <div class="space-y-4 pb-22">
    <AvatarDropdown
      sizeClass="h-13 w-13 rounded-2xl"
      showChevron={false}
      class="group-hover:scale-103 group-open:scale-103 group-open:border-foreground/25 rounded-2xl border border-border bg-muted/40 p-0 cursor-pointer hover:bg-muted block w-full transition-all duration-50 ease-out active:scale-98 active:bg-muted/80 group-open:shadow-sm group-open:bg-background"
    >
      <div class="flex items-center justify-between w-full pl-4 pr-3 py-1">
        <div class="flex flex-col text-left">
          <p class="text-md font-semibold text-foreground leading-tight">
            Helmi Arimbawa
          </p>

          <span
            class="flex items-center gap-1.5 text-xs text-muted-foreground font-medium mt-1"
          >
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2 w-2 bg-green-500"
              ></span>
            </span>

            Available for work
          </span>
        </div>

        <ChevronDown class="h-5 w-5 text-muted-foreground" />
      </div>
    </AvatarDropdown>

    <div class="space-y-3">
      {
        publicDashboardMenu.map((section) => (
          <div class="space-y-3">
            {section.groupLabel ? (
              <p class="text-[10px] font-semibold uppercase tracking-[.3em] text-primary lg:text-muted-foreground pl-3">
                {section.groupLabel}
              </p>
            ) : null}
            <div class="flex flex-col gap-[6px]">
              {section.menus.map((item) => {
                const IconComponent = item.icon ?? Menu;

                return (
                  <a
                    href={item.href}
                    data-drawer-link
                    data-astro-prefetch="tap"
                    class="flex items-center justify-between rounded-xl border transition-all duration-200 cursor-pointer relative py-[6px] px-[12px] group border-transparent bg-transparent text-muted-foreground hover:bg-accent hover:text-accent-foreground"
                  >
                    <span class="flex items-center gap-3">
                      <span class="drawer-icon-span flex shrink-0 items-center justify-center transition-all duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[15px] [&>svg]:h-[15px] text-muted-foreground group-hover:text-accent-foreground">
                        <IconComponent />
                      </span>
                      <span class="font-medium text-[14px]">{item.label}</span>
                    </span>
                    <span class="drawer-arrow-span items-center justify-center transition-all duration-200 absolute right-[12px] w-[19px] h-[19px] text-accent-foreground [&>svg]:block [&>svg]:w-[13px] [&>svg]:h-[13px] hidden">
                      <ArrowRight />
                    </span>
                  </a>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>

    <div class="space-y-3">
      <ThemeToggle />
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const currentPath = window.location.pathname;
    const drawerLinks = document.querySelectorAll("[data-drawer-link]");

    drawerLinks.forEach((link) => {
      const href = link.getAttribute("href");
      const isActive =
        href === "/" ? currentPath === "/" : currentPath.startsWith(href || "");
      const iconSpan = link.querySelector(".drawer-icon-span");
      const arrowSpan = link.querySelector(".drawer-arrow-span");

      if (isActive) {
        link.className =
          "flex items-center justify-between rounded-xl border transition-all duration-200 cursor-pointer relative py-[6px] px-[12px] group border-border bg-accent text-accent-foreground shadow-xs font-semibold";
        if (iconSpan)
          iconSpan.className =
            "drawer-icon-span flex shrink-0 items-center justify-center transition-all duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[15px] [&>svg]:h-[15px] text-accent-foreground";
        if (arrowSpan)
          arrowSpan.className =
            "drawer-arrow-span items-center justify-center transition-all duration-200 absolute right-[12px] w-[19px] h-[19px] text-accent-foreground [&>svg]:block [&>svg]:w-[13px] [&>svg]:h-[13px] flex";
      } else {
        link.className =
          "flex items-center justify-between rounded-xl border transition-all duration-200 cursor-pointer relative py-[6px] px-[12px] group border-transparent bg-transparent text-primary lg:text-muted-foreground hover:bg-accent hover:text-accent-foreground";
        if (iconSpan)
          iconSpan.className =
            "drawer-icon-span flex shrink-0 items-center justify-center transition-all duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[15px] [&>svg]:h-[15px] text-currentColor group-hover:text-accent-foreground";
        if (arrowSpan)
          arrowSpan.className =
            "drawer-arrow-span items-center justify-center transition-all duration-200 absolute right-[12px] w-[19px] h-[19px] text-accent-foreground [&>svg]:block [&>svg]:w-[13px] [&>svg]:h-[13px] hidden";
      }
    });
  });
</script>
