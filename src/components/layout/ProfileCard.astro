---
// ProfileCard.astro
import SocialLinks from "./SocialLinks.astro";

interface Props {
  variant?: "sidebar" | "mobile";
}

const { variant = "sidebar" } = Astro.props;
const isMobile = variant === "mobile";
---

{
  isMobile ? (
    <div class="md:hidden w-full mb-10 pb-8 border-b border-[hsl(var(--border))] animate-fade-in flex flex-col items-center text-center">
      <div class="w-28 h-28 rounded-full overflow-hidden mb-4 border border-[hsl(var(--border))]">
        <img
          src="/avatar.jpg"
          alt="Helmi Arimbawa"
          class="w-full h-full object-cover"
          loading="eager"
          decoding="sync"
          onerror="this.src='data:image/svg+xml;base64,'"
        />
      </div>

      <div class="space-y-1 flex flex-col items-center">
        <h2 class="text-2xl font-bold tracking-tight text-[hsl(var(--foreground))]">
          Helmi Arimbawa
        </h2>
        <div class="flex items-center justify-center gap-2 pt-1 pb-4">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75 animate-ping" />
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500" />
          </span>
          <span class="text-xs font-medium text-[hsl(var(--foreground)/0.65)]">
            Online
          </span>
        </div>
      </div>

      <SocialLinks />
    </div>
  ) : (
    <div class=" mb-5 pl-2 flex flex-col">
      <div class="relative">
        <div class="w-24 h-24 rounded-full overflow-hidden mb-4 border border-[hsl(var(--border))]">
          <img
            src="/avatar.jpg"
            alt="Profile"
            class="w-full h-full object-cover"
            loading="eager"
            decoding="sync"
            onerror="this.src='data:image/svg+xml;base64,'"
          />
        </div>
      </div>

      <div class="space-y-1">
        <h1 class="text-xl font-bold tracking-tight text-[hsl(var(--foreground))]">
          Helmi Arimbawa
        </h1>
        <div class="flex items-center gap-2 pt-0">
          <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-500 dark:bg-emerald-400 opacity-75 animate-ping" />
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500 dark:bg-emerald-400" />
          </span>
          <span class="text-xs font-medium text-[hsl(var(--foreground)/0.65)]">
            Online
          </span>
        </div>

        <SocialLinks />
      </div>
    </div>
  )
}


