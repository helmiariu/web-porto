---
---
<div class="rounded-[2rem] border border-[hsl(var(--border))] bg-[hsl(var(--secondary))] p-5 shadow-sm">
  <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[hsl(var(--foreground)/0.65)] mb-4">
    Theming
  </p>
  <button
    id="theme-toggle-button"
    type="button"
    aria-pressed="false"
    class="flex w-full items-center justify-between rounded-[1.75rem] border border-[hsl(var(--border))] bg-[hsl(var(--background))] px-4 py-3 text-sm font-medium text-[hsl(var(--foreground))] transition-colors duration-200 hover:bg-[hsl(var(--secondary)/0.92)] hover:border-[hsl(var(--border))]"
  >
    <span>Dark Mode</span>
    <span id="theme-toggle-track" class="inline-flex h-8 min-w-[3.5rem] items-center rounded-full border px-1.5 text-[11px] transition-colors duration-200 border-[hsl(var(--border))] bg-[hsl(var(--secondary))] text-[hsl(var(--foreground))]">
      <span id="theme-toggle-state" class="text-[hsl(var(--foreground))]">Off</span>
      <span id="theme-toggle-handle" class="ml-auto inline-block h-5 w-5 rounded-full bg-[hsl(var(--background))] shadow-sm transition-transform duration-200"></span>
    </span>
  </button>
</div>
<script>
  const storageKey = 'astro-theme';
  const html = document.documentElement;
  const button = document.getElementById('theme-toggle-button');
  const handle = document.getElementById('theme-toggle-handle');
  const stateText = document.getElementById('theme-toggle-state');
  const track = document.getElementById('theme-toggle-track');

  const setTheme = (dark: boolean) => {
    html.classList.toggle('dark', dark);
    if (button) button.setAttribute('aria-pressed', dark ? 'true' : 'false');
    if (stateText) {
      stateText.textContent = dark ? 'On' : 'Off';
    }
    if (track) {
      track.classList.toggle('bg-emerald-600', dark);
      track.classList.toggle('border-emerald-600', dark);
      track.classList.toggle('bg-[hsl(var(--secondary))]', !dark);
      track.classList.toggle('border-[hsl(var(--border))]', !dark);
      track.classList.toggle('border-zinc-800', dark);
    }
    if (handle) {
      handle.style.transform = dark ? 'translateX(1rem)' : 'translateX(0)';
      handle.classList.toggle('bg-zinc-950', dark);
      handle.classList.toggle('bg-white', !dark);
    }
  };

  const getSavedTheme = () => {
    try {
      return localStorage.getItem(storageKey);
    } catch {
      return null;
    }
  };

  const getPreferredTheme = () => window.matchMedia?.('(prefers-color-scheme: dark)').matches;
  const savedTheme = getSavedTheme();
  const isDark = savedTheme ? savedTheme === 'dark' : getPreferredTheme();
  setTheme(isDark);

  button?.addEventListener('click', () => {
    const nextTheme = !html.classList.contains('dark');
    try {
      localStorage.setItem(storageKey, nextTheme ? 'dark' : 'light');
    } catch {
      // ignore
    }
    setTheme(nextTheme);
  });
</script>
