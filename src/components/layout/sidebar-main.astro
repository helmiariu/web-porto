---
// sidebar-main.astro
import SidebarSecondary from "./sidebar-secondary.astro";
import SocialLinks from "./social-links.astro";
---

<aside
  id="main-sidebar"
  class="hidden md:flex flex-col sticky top-8 w-72 lg:w-80 max-h-screen md:pt-3 pb-6 px-3 md:border-none select-none"
>
  <div class="mb-6 px-4">
    <div class="relative">
      <div
        class="w-24 h-24 rounded-full overflow-hidden mb-4 border border-[hsl(var(--border))]"
      >
        <img
          src="/avatar.jpg"
          alt="Profile"
          class="w-full h-full object-cover"
          loading="eager"
          decoding="sync"
          onerror="this.src='data:image/svg+xml;base64,'"
        />
      </div>
    </div>

    <div class="space-y-1">
      <h1
        class="text-xl font-bold tracking-tight text-[hsl(var(--foreground))]"
      >
        Helmi Arimbawa
      </h1>
      <div class="flex items-center gap-2 pt-2">
        <span class="relative flex h-2.5 w-2.5">
          <span
            class="absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75 animate-ping"
          ></span>
          <span
            class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"
          ></span>
        </span>
        <span class="text-xs font-medium text-[hsl(var(--foreground)/0.65)]"
          >Available for work</span
        >
      </div>

      <!-- Social Media Icons directly under Available for Work -->
      <SocialLinks />
    </div>
  </div>

  <SidebarSecondary />
</aside>

<script>
  const sidebar = document.getElementById("main-sidebar");

  if (sidebar) {
    // Sidebar tidak punya scroll sendiri.
    // Teruskan semua wheel event ke halaman utama agar
    // hanya konten yang bergerak saat scroll di area sidebar.
    sidebar.addEventListener(
      "wheel",
      (e) => {
        e.preventDefault();
        window.scrollBy({ top: e.deltaY, left: e.deltaX });
      },
      { passive: false }
    );
  }
</script>
