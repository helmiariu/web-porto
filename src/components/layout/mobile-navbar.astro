---
// mobile-navbar.astro
import { mainNavData, publicDashboardMenu } from "../../commons/constants/navigation-menu.ts";
import { Home, Briefcase, FileText, Brain, MessageCircle, Wrench, MapPin, User, Menu } from "lucide-static";
const navItems = mainNavData(false);
const iconMap = {
  "/": Home,
  "/project": Briefcase,
  "/blog": FileText,
  "/auth": User,
  "/profile": User,
  "/ai": Brain,
  "/chat": MessageCircle,
  "/tools": Wrench,
  "/roadmap": MapPin,
};
---
<nav class="md:hidden fixed bottom-6 inset-x-4 z-[60] rounded-full border border-[hsl(var(--border))] bg-[hsl(var(--secondary))/0.95] px-3 py-3 shadow-2xl backdrop-blur-xl">
  <div class="flex items-center gap-2">
    {navItems.map((item) => {
      const iconMarkup = iconMap[item.href] ?? Menu;
      return (
        <a
          href={item.href}
          aria-label={item.label}
          class="flex-1 flex h-11 items-center justify-center rounded-2xl bg-[hsl(var(--background))] text-[hsl(var(--foreground))] hover:bg-[hsl(var(--secondary))] transition-colors"
        >
          <span class="h-5 w-5" set:html={iconMarkup}></span>
        </a>
      );
    })}

    <details class="relative">
      <summary class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-[hsl(var(--background))] text-[hsl(var(--foreground))] hover:bg-[hsl(var(--secondary))] transition-colors ring-1 ring-[hsl(var(--border))] shadow-sm ml-auto" aria-label="Open menu" set:html={Menu}></summary>
      <div class="fixed inset-x-0 bottom-0 z-40 overflow-hidden rounded-[2rem] bg-[hsl(var(--secondary))/0.98] p-4 pb-32 shadow-2xl backdrop-blur-xl max-h-[60vh] pointer-events-none">
        <div class="space-y-4 pointer-events-auto">
          <div class="rounded-3xl border-x border-t-0 border-b-0 border-[hsl(var(--border))] bg-[hsl(var(--background))] p-4">
            <div class="flex items-center gap-3">
              <span class="grid h-14 w-14 place-items-center rounded-3xl bg-[hsl(var(--primary))]/15 text-[hsl(var(--primary))]">
                <span class="h-6 w-6" set:html={User}></span>
              </span>
              <div>
                <p class="text-sm font-semibold text-[hsl(var(--foreground))]">Eleanor Pena</p>
                <p class="text-xs text-[hsl(var(--foreground)/0.65)]">Product Designer</p>
              </div>
            </div>
          </div>

          <div class="space-y-3 overflow-y-auto max-h-[calc(60vh-7rem)] pr-1">
            {publicDashboardMenu.map((section) => (
              <div class="space-y-3">
                {section.groupLabel ? (
                  <p class="text-[0.63rem] font-semibold uppercase tracking-[0.3em] text-[hsl(var(--foreground)/0.65)]">
                    {section.groupLabel}
                  </p>
                ) : null}
                <div class="space-y-2">
                  {section.menus.map((item) => {
                    const iconMarkup = iconMap[item.href] ?? Menu;
                    return (
                      <a
                        href={item.href}
                        class="flex items-center gap-3 rounded-2xl border border-[hsl(var(--border))] bg-[hsl(var(--background))] px-3 py-3 text-sm font-medium text-[hsl(var(--foreground))] hover:bg-[hsl(var(--secondary)/0.92)] transition-colors"
                      >
                        <span class="h-5 w-5" set:html={iconMarkup}></span>
                        <span>{item.label}</span>
                      </a>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </details>
  </div>
</nav>