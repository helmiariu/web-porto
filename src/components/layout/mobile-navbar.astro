---
// mobile-navbar.astro
import { mainNavData, publicDashboardMenu } from "../../commons/constants/navigation-menu.ts";
import { Home, Briefcase, FileText, Brain, MessageCircle, Wrench, MapPin, User, Menu } from "lucide-static";
const navItems = mainNavData(false);
const iconMap = {
  "/": Home,
  "/project": Briefcase,
  "/blog": FileText,
  "/auth": User,
  "/profile": User,
  "/ai": Brain,
  "/chat": MessageCircle,
  "/tools": Wrench,
  "/roadmap": MapPin,
};
---
<nav class="md:hidden fixed bottom-6 inset-x-4 z-50 rounded-full border border-[hsl(var(--border))] bg-[hsl(var(--secondary))/0.95] px-3 py-3 shadow-2xl backdrop-blur-xl">
  <div class="flex items-center gap-2">
    <details class="relative">
      <summary class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-[hsl(var(--background))] text-[hsl(var(--foreground))] hover:bg-[hsl(var(--secondary))] transition-colors ring-1 ring-[hsl(var(--border))] shadow-sm" aria-label="Open menu" set:html={Menu}></summary>
      <div class="absolute bottom-full mb-3 left-0 w-72 rounded-3xl border border-[hsl(var(--border))] bg-[hsl(var(--secondary))/0.97] p-3 shadow-2xl backdrop-blur-xl">
        {publicDashboardMenu.map((section) => (
          <div class="space-y-3 mb-3 last:mb-0">
            {section.groupLabel ? (
              <p class="text-[0.63rem] font-semibold uppercase tracking-[0.3em] text-[hsl(var(--foreground)/0.65)]">
                {section.groupLabel}
              </p>
            ) : null}
            <div class="space-y-2">
              {section.menus.map((item) => {
                const iconMarkup = iconMap[item.href] ?? Menu;
                return (
                  <a
                    href={item.href}
                    class="flex items-center gap-3 rounded-2xl border border-[hsl(var(--border))] bg-[hsl(var(--background))] px-3 py-3 text-sm font-medium text-[hsl(var(--foreground))] hover:bg-[hsl(var(--secondary)/0.92)] transition-colors"
                  >
                    <span class="h-5 w-5" set:html={iconMarkup}></span>
                    <span>{item.label}</span>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </details>

    {navItems.map((item) => {
      const iconMarkup = iconMap[item.href] ?? Menu;
      return (
        <a
          href={item.href}
          aria-label={item.label}
          class="flex-1 flex h-11 items-center justify-center rounded-2xl bg-[hsl(var(--background))] text-[hsl(var(--foreground))] hover:bg-[hsl(var(--secondary))] transition-colors"
        >
          <span class="h-5 w-5" set:html={iconMarkup}></span>
        </a>
      );
    })}
  </div>
</nav>