---
// mobile-navbar.astro
import { mainNavData } from "../../commons/constants/navigation-menu.ts";
const navItems = mainNavData(false);
---
<nav class="md:hidden fixed bottom-6 inset-x-4 z-50 rounded-full border border-zinc-800 bg-zinc-950/95 px-3 py-3 shadow-2xl backdrop-blur-xl">
  <div class="flex items-center gap-2">
    {navItems.slice(0, 2).map((item) => (
      <a
        href={item.href}
        class="flex-1 rounded-2xl bg-zinc-900 px-3 py-3 text-center text-xs font-medium text-white hover:bg-zinc-800 transition-colors"
      >
        {item.label}
      </a>
    ))}

    <details class="relative">
      <summary class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-zinc-900 text-sm font-semibold text-white hover:bg-zinc-800 transition-colors">
        ...
      </summary>
      <div class="absolute bottom-14 right-0 w-52 rounded-3xl border border-zinc-800 bg-zinc-950/95 p-3 shadow-2xl backdrop-blur-xl">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="block rounded-2xl px-3 py-3 text-sm font-medium text-white hover:bg-zinc-900 transition-colors"
          >
            {item.label}
          </a>
        ))}
      </div>
    </details>
  </div>
</nav>