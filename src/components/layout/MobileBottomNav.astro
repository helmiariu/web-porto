---
// mobile-navbar-icons.astro
import { mainNavData } from "@lib/constants/navigation-menu.ts";
import { ChevronUp } from "@lucide/astro";
const navItems = mainNavData(false);
---

<nav
  class="md:hidden fixed bottom-5 left-1/2 -translate-x-1/2 w-max max-w-[calc(100%-2rem)] z-[60] rounded-2xl border border-border bg-background p-1.5 shadow-lg"
>
  <div class="flex items-center gap-1.5">
    <div class="flex items-center gap-1">
      {
        navItems.map((item) => {
          const IconComponent = item.icon ?? ChevronUp;
          
          return (
            <a
              href={item.href}
              data-nav-link
              aria-label={item.label}
              /* MENGGUNAKAN text-primary SECARA DEFAULT DAN lg:text-muted-foreground SAAT LAYAR BESAR */
              class="w-11 h-11 flex items-center justify-center rounded-xl transition-all duration-200 border text-primary lg:text-muted-foreground border-transparent bg-transparent hover:text-accent-foreground hover:bg-accent"
            >
              <span class="flex items-center justify-center h-5 w-5 [&>svg]:w-full [&>svg]:h-full [&>svg]:block">
                <IconComponent />
              </span>
            </a>
          );
        })
      }
    </div>

    <div class="h-9 w-[1px] bg-border dark:bg-muted-foreground/20 shrink-0 mx-1"></div>

    <button
      id="mobile-menu-trigger"
      class="group inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-border bg-secondary text-secondary-foreground transition-colors shadow-xs hover:bg-secondary/80"
      
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span class="flex items-center justify-center h-5.5 w-5.5 [&>svg]:w-full [&>svg]:h-full [&>svg]:block transition-transform duration-200 group-aria-expanded:rotate-180">
        <ChevronUp />
      </span>
    </button>
  </div>
</nav>


<script>
  // Fungsi untuk mengecek dan memasang status bounce
  function handleBounce() {
    const trigger = document.getElementById("mobile-menu-trigger");
    if (!trigger) return;

    // Cek apakah di sesi ini user sudah pernah melihat/berinteraksi dengan menu
    const isBouncedInSession = sessionStorage.getItem("menu-bounced-session");

    if (!isBouncedInSession) {
      // Jika belum pernah di sesi ini, berikan efek bounce
      trigger.classList.add("animate-bounce");
    } else {
      // Jika sudah pernah (pindah halaman lewat Astro), pastikan bounce mati
      trigger.classList.remove("animate-bounce");
    }
  }

  // 1. Jalankan setiap kali halaman dimuat (baik via refresh maupun transisi Astro)
  document.addEventListener("astro:page-load", () => {
    const currentPath = window.location.pathname;

    // --- 1A. LOGIKA UPDATE LINK NAVIGASI BAWAH (w-11 h-11) ---
    const navLinks = document.querySelectorAll("[data-nav-link]");
    navLinks.forEach((link) => {
      const href = link.getAttribute("href");
      const isActive = href === "/" ? currentPath === "/" : currentPath.startsWith(href || "");

      if (isActive) {
        link.className = "w-11 flex h-11 items-center justify-center rounded-xl transition-all duration-200 border border-border bg-accent text-accent-foreground shadow-xs font-medium";
      } else {
        link.className = "w-11 flex h-11 items-center justify-center rounded-xl transition-all duration-200 border border-transparent bg-transparent text-primary lg:text-muted-foreground hover:text-accent-foreground hover:bg-accent";
      }
    });

    // --- 1B. LOGIKA UPDATE LINK DI DALAM DRAWER (Memanjang/Rapi) ---
    const drawerLinks = document.querySelectorAll("[data-drawer-link]");
    drawerLinks.forEach((link) => {
      const href = link.getAttribute("href");
      const isActive = href === "/" ? currentPath === "/" : currentPath.startsWith(href || "");
      const iconSpan = link.querySelector(".drawer-icon-span");
      const arrowSpan = link.querySelector(".drawer-arrow-span");

      if (isActive) {
        link.className = "flex items-center justify-between rounded-lg border transition-all duration-200 cursor-pointer relative py-[6px] px-[12px] group border-border bg-accent text-accent-foreground shadow-xs font-semibold";
        if (iconSpan) iconSpan.className = "drawer-icon-span flex shrink-0 items-center justify-center transition-all duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[15px] [&>svg]:h-[15px] text-accent-foreground";
        if (arrowSpan) arrowSpan.className = "drawer-arrow-span items-center justify-center transition-all duration-200 absolute right-[12px] w-[19px] h-[19px] text-accent-foreground [&>svg]:block [&>svg]:w-[13px] [&>svg]:h-[13px] flex";
      } else {
        link.className = "flex items-center justify-between rounded-lg border transition-all duration-200 cursor-pointer relative py-[6px] px-[12px] group border-transparent bg-transparent text-primary/85 hover:bg-accent hover:text-accent-foreground";
        if (iconSpan) iconSpan.className = "drawer-icon-span flex shrink-0 items-center justify-center transition-all duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[15px] [&>svg]:h-[15px] text-primary/85  group-hover:text-accent-foreground";
        if (arrowSpan) arrowSpan.className = "drawer-arrow-span items-center justify-center transition-all duration-200 absolute right-[12px] w-[19px] h-[19px] text-accent-foreground [&>svg]:block [&>svg]:w-[13px] [&>svg]:h-[13px] hidden";
      }
    });

    // --- 2. LOGIKA UTAMA DRAWER & KUNCI SCROLL ---
    const trigger = document.getElementById("mobile-menu-trigger");
    const dropdown = document.getElementById("mobile-dropdown");
    const backdrop = document.getElementById("mobile-dropdown-backdrop");

    // Jalankan pengecekan bounce untuk tombol trigger
    handleBounce();

    if (trigger && dropdown && backdrop) {
      const closeDropdown = () => {
        dropdown.classList.add("opacity-0", "pointer-events-none", "translate-y-4");
        dropdown.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
        backdrop.classList.add("opacity-0", "pointer-events-none");
        backdrop.classList.remove("opacity-100", "pointer-events-auto");
        document.body.classList.remove("overflow-hidden");
        trigger.setAttribute("aria-expanded", "false");
        
        // DI SINI DIUBAH: Jangan masukkan lagi class 'animate-bounce' saat menu ditutup
      };

      const openDropdown = () => {
        dropdown.classList.remove("opacity-0", "pointer-events-none", "translate-y-4");
        dropdown.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
        backdrop.classList.remove("opacity-0", "pointer-events-none");
        backdrop.classList.add("opacity-100", "pointer-events-auto");
        document.body.classList.add("overflow-hidden");
        trigger.setAttribute("aria-expanded", "true");
        
        // Matikan bounce karena user sudah berinteraksi klik
        if (trigger.classList.contains("animate-bounce")) {
          trigger.classList.remove("animate-bounce");
        }
        // Tandai sesi bahwa bounce tidak perlu diulang saat pindah halaman
        sessionStorage.setItem("menu-bounced-session", "true");
      };

      trigger.addEventListener("click", () => {
        const isOpen = dropdown.classList.contains("opacity-100");
        if (isOpen) {
          closeDropdown();
        } else {
          openDropdown();
        }
      });

      backdrop.addEventListener("click", closeDropdown);

      dropdown.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          // Tandai juga di sini jika user langsung klik link internal
          sessionStorage.setItem("menu-bounced-session", "true");
          closeDropdown();
        });
      });
    }
  });

  // 2. Antisipasi bawaan Astro View Transitions agar animasi tidak bocor saat proses swap halaman
  document.addEventListener("astro:after-swap", () => {
    const trigger = document.getElementById("mobile-menu-trigger");
    if (trigger && sessionStorage.getItem("menu-bounced-session")) {
      trigger.classList.remove("animate-bounce");
    }
  });
</script>


