---
// mobile-navbar-icons.astro
import { mainNavData } from "../../commons/constants/navigation-menu.ts";
import {
  Home,
  Briefcase,
  FileText,
  Brain,
  MessageCircle,
  Wrench,
  MapPin,
  User,
  Menu,
} from "lucide-static";

const currentPath = Astro.url.pathname;
const navItems = mainNavData(false);
const iconMap = {
  "/": Home,
  "/project": Briefcase,
  "/blog": FileText,
  "/auth": User,
  "/profile": User,
  "/ai": Brain,
  "/chat": MessageCircle,
  "/tools": Wrench,
  "/roadmap": MapPin,
};
---

<nav
  class="md:hidden fixed bottom-3 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-xs z-[60] rounded-3xl border border-[hsl(var(--border))] bg-[hsl(var(--background))] px-3 py-2.5 shadow-lg"
>
  <div class="flex items-center gap-2">
    {
      navItems.map((item) => {
        const isActive =
          item.href === "/"
            ? currentPath === "/"
            : currentPath.startsWith(item.href);
        const iconMarkup = iconMap[item.href] ?? Menu;
        return (
          <a
            href={item.href}
            aria-label={item.label}
            class={`flex-1 flex h-11 items-center justify-center rounded-2xl transition-all duration-200 border ${
              isActive
                ? "border-[hsl(var(--border))] bg-[hsl(var(--secondary))] text-[hsl(var(--foreground))] shadow-sm"
                : "border-transparent bg-transparent text-[hsl(var(--foreground)/0.6)] hover:text-[hsl(var(--foreground))] hover:bg-[hsl(var(--secondary))]"
            }`}
          >
            <span
              class="flex items-center justify-center h-5 w-5 [&>svg]:w-full [&>svg]:h-full [&>svg]:block"
              set:html={iconMarkup}
            />
          </a>
        );
      })
    }

    <button
      id="mobile-menu-trigger"
      class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-[hsl(var(--border))] bg-transparent text-[hsl(var(--foreground)/0.6)] hover:text-[hsl(var(--foreground))] hover:bg-[hsl(var(--secondary))] transition-colors shadow-sm ml-auto"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span
        class="flex items-center justify-center h-5 w-5 [&>svg]:w-full [&>svg]:h-full [&>svg]:block"
        set:html={Menu}></span>
    </button>
  </div>
</nav>

<script>
  const trigger = document.getElementById("mobile-menu-trigger");
  const dropdown = document.getElementById("mobile-dropdown");
  const backdrop = document.getElementById("mobile-dropdown-backdrop");

  const closeDropdown = () => {
    if (dropdown && trigger && backdrop) {
      dropdown.classList.add(
        "opacity-0",
        "pointer-events-none",
        "translate-y-4"
      );
      dropdown.classList.remove(
        "opacity-100",
        "pointer-events-auto",
        "translate-y-0"
      );
      backdrop.classList.add("opacity-0", "pointer-events-none");
      backdrop.classList.remove("opacity-100", "pointer-events-auto");
      document.body.classList.remove("overflow-hidden");
      trigger.setAttribute("aria-expanded", "false");
    }
  };

  const openDropdown = () => {
    if (dropdown && trigger && backdrop) {
      dropdown.classList.remove(
        "opacity-0",
        "pointer-events-none",
        "translate-y-4"
      );
      dropdown.classList.add(
        "opacity-100",
        "pointer-events-auto",
        "translate-y-0"
      );
      backdrop.classList.remove("opacity-0", "pointer-events-none");
      backdrop.classList.add("opacity-100", "pointer-events-auto");
      document.body.classList.add("overflow-hidden");
      trigger.setAttribute("aria-expanded", "true");
    }
  };

  if (trigger && dropdown && backdrop) {
    trigger.addEventListener("click", () => {
      const isOpen = dropdown.classList.contains("opacity-100");
      if (isOpen) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });

    backdrop.addEventListener("click", () => {
      closeDropdown();
    });
  }
</script>
