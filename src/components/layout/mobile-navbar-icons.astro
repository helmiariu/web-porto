---
// mobile-navbar-icons.astro
import { mainNavData } from "../../commons/constants/navigation-menu.ts";
import { Home, Briefcase, FileText, Brain, MessageCircle, Wrench, MapPin, User, Menu } from "lucide-static";

const currentPath = Astro.url.pathname;
const navItems = mainNavData(false);
const iconMap = {
  "/": Home,
  "/project": Briefcase,
  "/blog": FileText,
  "/auth": User,
  "/profile": User,
  "/ai": Brain,
  "/chat": MessageCircle,
  "/tools": Wrench,
  "/roadmap": MapPin,
};
---

<nav class="md:hidden fixed bottom-6 inset-x-4 z-[60] rounded-full border border-[hsl(var(--border))] bg-[hsl(var(--secondary))/0.95] px-3 py-3 shadow-2xl backdrop-blur-xl">
  <div class="flex items-center gap-2">
    {navItems.map((item) => {
      const isActive = item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href);
      const iconMarkup = iconMap[item.href] ?? Menu;
      return (
        <a
          href={item.href}
          aria-label={item.label}
          class={`flex-1 flex h-11 items-center justify-center rounded-full transition-all duration-200 border ${
            isActive
              ? 'border-[hsl(var(--primary))] bg-[hsl(var(--primary)/0.08)] text-[hsl(var(--foreground))] shadow-[0_4px_12px_rgba(0,0,0,0.1)]'
              : 'border-transparent bg-[hsl(var(--background))] text-[hsl(var(--foreground))] hover:bg-[hsl(var(--secondary))]'
          }`}
        >
          <span class="flex items-center justify-center h-5 w-5 [&>svg]:w-full [&>svg]:h-full [&>svg]:block" set:html={iconMarkup}></span>
        </a>
      );
    })}

    <button
      id="mobile-menu-trigger"
      class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[hsl(var(--background))] text-[hsl(var(--foreground))] hover:bg-[hsl(var(--secondary))] transition-colors ring-1 ring-[hsl(var(--border))] shadow-sm ml-auto"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span class="flex items-center justify-center h-5 w-5 [&>svg]:w-full [&>svg]:h-full [&>svg]:block" set:html={Menu}></span>
    </button>
  </div>
</nav>

<script>
  const trigger = document.getElementById("mobile-menu-trigger");
  const dropdown = document.getElementById("mobile-dropdown");

  if (trigger && dropdown) {
    trigger.addEventListener("click", () => {
      const isOpen = dropdown.classList.contains("opacity-100");
      
      if (isOpen) {
        dropdown.classList.add("opacity-0", "pointer-events-none", "translate-y-4");
        dropdown.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
        trigger.setAttribute("aria-expanded", "false");
      } else {
        dropdown.classList.remove("opacity-0", "pointer-events-none", "translate-y-4");
        dropdown.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
        trigger.setAttribute("aria-expanded", "true");
      }
    });
  }
</script>
