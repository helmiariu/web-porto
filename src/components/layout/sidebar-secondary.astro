---
import { publicDashboardMenu } from "../../commons/constants/navigation-menu.ts";
import SidebarTheming from "./sidebar-theming.astro";
import pkg from "lucide-static";
const { Home, Briefcase, FileText, Brain, MessageCircle, Wrench, MapPin, ArrowRight, Github, Linkedin, Instagram, Twitter } = pkg;

const currentPath = Astro.url.pathname;
const icons = {
  "/": Home,
  "/project": Briefcase,
  "/blog": FileText,
  "/ai": Brain,
  "/chat": MessageCircle,
  "/tools": Wrench,
  "/roadmap": MapPin,
};
---
<nav class="space-y-4 px-4 pb-6">

  {publicDashboardMenu.map((section) => (
    <div class="space-y-2">
      {section.groupLabel ? (
        <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-[hsl(var(--foreground)/0.65)] pl-1">
          {section.groupLabel}
        </p>
      ) : null}

      <div class="space-y-1.5">
        {section.menus.map((item) => {
          const isActive = item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href);
          const iconMarkup = icons[item.href] ?? Home;
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class={`flex items-center justify-between rounded-xl border px-3 py-2 text-sm font-medium transition-all duration-200 ${
                isActive
                  ? 'border-[hsl(var(--border))] bg-[hsl(var(--secondary))] text-[hsl(var(--foreground))] shadow-sm'
                  : 'border-transparent bg-transparent text-[hsl(var(--foreground)/0.6)] hover:bg-[hsl(var(--secondary))] hover:text-[hsl(var(--foreground))]'
              }`}
            >
              <span class="flex items-center gap-2.5">
                <span class={`flex h-8 w-8 shrink-0 items-center justify-center transition-all duration-200 ${
                  isActive
                    ? 'text-[hsl(var(--foreground))]'
                    : 'text-[hsl(var(--foreground)/0.6)]'
                } [&>svg]:w-4 [&>svg]:h-4 [&>svg]:block`} set:html={iconMarkup}></span>
                <span>{item.label}</span>
              </span>
              {isActive ? (
                <span class="text-[hsl(var(--foreground))] mr-1.5 [&>svg]:w-3.5 [&>svg]:h-3.5 [&>svg]:block" set:html={ArrowRight}></span>
              ) : null}
            </a>
          );
        })}
      </div>
    </div>
  ))}

  <SidebarTheming />
</nav>
