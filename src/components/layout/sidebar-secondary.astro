---
import { publicDashboardMenu } from "../../commons/constants/navigation-menu.ts";
import ProfileSideCard from "./profile-side-card.astro";
import SidebarTheming from "./sidebar-theming.astro";
import { Home, Briefcase, FileText, Brain, MessageCircle, Wrench, MapPin, ArrowRight } from "lucide-static";

const currentPath = Astro.url.pathname;
const icons = {
  "/": Home,
  "/project": Briefcase,
  "/blog": FileText,
  "/ai": Brain,
  "/chat": MessageCircle,
  "/tools": Wrench,
  "/roadmap": MapPin,
};
---
<nav class="space-y-6 px-4 pb-6">
  <ProfileSideCard />

  {publicDashboardMenu.map((section) => (
    <div class="space-y-4">
      {section.groupLabel ? (
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[hsl(var(--foreground)/0.65)]">
          {section.groupLabel}
        </p>
      ) : null}

      <div class="space-y-3">
        {section.menus.map((item) => {
          const isActive = currentPath === item.href;
          const iconMarkup = icons[item.href] ?? Home;
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class={`flex items-center justify-between rounded-[1.75rem] border px-4 py-3 text-sm font-medium transition-all duration-200 ${
                isActive
                  ? 'border-[hsl(var(--primary))] bg-[hsl(var(--primary)/0.08)] text-[hsl(var(--foreground))] shadow-[0_14px_40px_-22px_rgba(15,23,42,0.35)]'
                  : 'border-[hsl(var(--border))] bg-[hsl(var(--secondary))] text-[hsl(var(--foreground))] hover:border-[hsl(var(--foreground)/0.18)] hover:bg-[hsl(var(--secondary)/0.82)]'
              }`}
            >
              <span class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-[hsl(var(--background))] text-[hsl(var(--foreground))]" set:html={iconMarkup}></span>
                <span>{item.label}</span>
              </span>
              {isActive ? (
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[hsl(var(--primary)/0.16)] text-[hsl(var(--primary))]" set:html={ArrowRight}></span>
              ) : null}
            </a>
          );
        })}
      </div>
    </div>
  ))}

  <SidebarTheming />
</nav>
