---
import { publicDashboardMenu } from "../../lib/constants/navigation-menu.ts";
import ThemeToggle from "./ThemeToggle.astro";
import pkg from "lucide-static";
const {
  Home,
  Briefcase,
  FileText,
  Brain,
  MessageCircle,
  Wrench,
  MapPin,
  ArrowRight,
  Github,
  Linkedin,
  Instagram,
  Twitter,
} = pkg;

const currentPath = Astro.url.pathname;
const icons = {
  "/": Home,
  "/project": Briefcase,
  "/blog": FileText,
  "/ai": Brain,
  "/chat": MessageCircle,
  "/tools": Wrench,
  "/roadmap": MapPin,
};
---

<nav class="space-y-4 px-0 pb-0">
  {
    publicDashboardMenu.map((section) => (
      <div class="space-y-2">
        {section.groupLabel ? (
          <p class="text-[10px] font-semibold uppercase tracking-[.3em] text-[hsl(var(--foreground)/0.65)] pl-3">
            {section.groupLabel}
          </p>
        ) : null}

        <div class="flex flex-col gap-[6px]">
          {section.menus.map((item) => {
            const isActive =
              item.href === "/"
                ? currentPath === "/"
                : currentPath.startsWith(item.href);
            const iconMarkup = icons[item.href] ?? Home;
            return (
              <a
                href={item.href}
                aria-current={isActive ? "page" : undefined}
                class={`flex items-center justify-between rounded-xl border transition-all duration-200 cursor-pointer relative py-[6px] px-[12px] group ${
                  isActive
                    ? "border-[hsl(var(--border))] bg-[hsl(var(--secondary))] text-[hsl(var(--foreground))] shadow-sm"
                    : "border-transparent bg-transparent text-[hsl(var(--foreground)/0.6)] hover:bg-[hsl(var(--secondary))] hover:text-[hsl(var(--foreground))]"
                }`}
              >
                <span class="flex items-center gap-3">
                  <span
                    class={`flex shrink-0 items-center justify-center transition-all duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[15px] [&>svg]:h-[15px] ${
                      isActive
                        ? "text-[hsl(var(--foreground))]"
                        : "text-[hsl(var(--foreground)/0.6)] group-hover:text-[hsl(var(--foreground))]"
                    }`}
                    set:html={iconMarkup}
                  />
                  <span class="font-medium text-[13px]">{item.label}</span>
                </span>
                <span
                  class={`items-center justify-center transition-all duration-200 absolute right-[12px] w-[19px] h-[19px] text-[hsl(var(--foreground))] [&>svg]:block [&>svg]:w-[13px] [&>svg]:h-[13px] ${
                    isActive ? "flex" : "hidden"
                  }`}
                  set:html={ArrowRight}
                />
              </a>
            );
          })}
        </div>
      </div>
    ))
  }

  <ThemeToggle />
</nav>

