---
import { publicDashboardMenu } from "@lib/constants/navigation-menu.ts";
import ThemeToggle from "@components/ui/ThemeToggle.astro";
import { Menu, ArrowRight } from "@lucide/astro";
---

<nav class="space-y-4 px-0 pb-0">
  {
    publicDashboardMenu.map((section) => (
      <div class="space-y-2">
        {section.groupLabel ? (
          <p class="text-[10px] font-semibold uppercase tracking-[.3em] text-primary lg:text-foreground/70 pl-3">
            {section.groupLabel}
          </p>
        ) : null}

        <div class="flex flex-col gap-[6px]">
          {section.menus.map((item) => {
            const IconComponent = item.icon ?? Menu;

            return (
              <a
                href={item.href}
                data-sidebar-link
                data-astro-prefetch="tap"
                /* PERBAIKAN 1: Ganti py-[6px] dengan h-10 (Kunci tinggi tombol jadi tepat 40px) */
                class="flex items-center justify-between rounded-lg border transition-colors duration-200 cursor-pointer relative h-10 px-[12px] group border-transparent bg-transparent text-muted-foreground hover:bg-accent hover:text-accent-foreground"
              >
                <span class="flex items-center gap-3">
                  <span class="sidebar-icon-span flex shrink-0 items-center justify-center transition-colors duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[16px] [&>svg]:h-[16px] text-muted-foreground group-hover:text-accent-foreground">
                    <IconComponent />
                  </span>
                  {/* PERBAIKAN 2: Tambahkan leading-[26px] agar tinggi kotak teks sama persis dengan tinggi kotak icon */}
                  <span class="font-medium text-[14px] leading-[26px] select-none">{item.label}</span>
                </span>

                <span class="sidebar-arrow-span items-center justify-center transition-colors duration-200 absolute right-[12px] top-1/2 -translate-y-1/2 w-[18px] h-[18px] text-accent-foreground [&>svg]:block [&>svg]:w-[12px] [&>svg]:h-[12px] hidden">
                  <ArrowRight />
                </span>
              </a>
            );
          })}
        </div>
      </div>
    ))
  }

  <ThemeToggle />
</nav>

<script>
  document.addEventListener("astro:page-load", () => {
    const currentPath = window.location.pathname;
    const sidebarLinks = document.querySelectorAll("[data-sidebar-link]");

    sidebarLinks.forEach((link) => {
      const href = link.getAttribute("href");
      const isActive =
        href === "/" ? currentPath === "/" : currentPath.startsWith(href || "");

      const iconSpan = link.querySelector(".sidebar-icon-span");
      const arrowSpan = link.querySelector(".sidebar-arrow-span");

      if (isActive) {
        link.setAttribute("aria-current", "page");
        /* PERBAIKAN 3: Terapkan h-10 di JavaScript Active State */
        link.className =
          "flex items-center justify-between rounded-lg border transition-colors duration-200 cursor-pointer relative h-10 px-[12px] group border-border bg-accent text-accent-foreground shadow-xs font-semibold";
        if (iconSpan)
          iconSpan.className =
            "sidebar-icon-span flex shrink-0 items-center justify-center transition-colors duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[16px] [&>svg]:h-[16px] text-accent-foreground";
        if (arrowSpan)
          arrowSpan.className =
            "sidebar-arrow-span items-center justify-center transition-colors duration-200 absolute right-[12px] top-1/2 -translate-y-1/2 w-[18px] h-[18px] text-accent-foreground [&>svg]:block [&>svg]:w-[12px] [&>svg]:h-[12px] flex";
      } else {
        link.removeAttribute("aria-current");
        /* PERBAIKAN 4: Terapkan h-10 di JavaScript Inactive State */
        link.className =
          "flex items-center justify-between rounded-lg border transition-colors duration-200 cursor-pointer relative h-10 px-[12px] group border-transparent bg-transparent text-foreground/70 hover:bg-accent hover:text-accent-foreground";
        if (iconSpan)
          iconSpan.className =
            "sidebar-icon-span flex shrink-0 items-center justify-center transition-colors duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[16px] [&>svg]:h-[16px] text-foreground/70 group-hover:text-accent-foreground ";
        if (arrowSpan)
          arrowSpan.className =
            "sidebar-arrow-span items-center justify-center transition-colors duration-200 absolute right-[12px] top-1/2 -translate-y-1/2 w-[18px] h-[18px] text-foreground/70 [&>svg]:block [&>svg]:w-[12px] [&>svg]:h-[12px] hidden";
      }
    });
  });
</script>