---
import { publicDashboardMenu } from "@lib/constants/navigation-menu.ts";
import ThemeToggle from "@components/ui/ThemeToggle.astro";
import { Menu, ArrowRight } from "@lucide/astro";
---

<nav class="space-y-4 px-0 pb-0">
  {
    publicDashboardMenu.map((section) => (
      <div class="space-y-2">
        {section.groupLabel ? (
          /* Menggunakan text-muted-foreground/70 khas label sidebar shadcn */
          <p class="text-[10px] font-semibold uppercase tracking-[.3em] text-primary lg:text-foreground/70 pl-3">
            {section.groupLabel}
          </p>
        ) : null}

        <div class="flex flex-col gap-[6px]">
          {section.menus.map((item) => {
            const IconComponent = item.icon ?? Menu;

            return (
              <a
                href={item.href}
                data-sidebar-link
                data-astro-prefetch="tap"
                /* DEFAULT STATE: menggunakan text-muted-foreground dan hover:bg-accent / hover:text-accent-foreground */
                class="flex items-center justify-between rounded-lg border transition-colors duration-200 cursor-pointer relative py-[6px] px-[12px] group border-transparent bg-transparent text-muted-foreground hover:bg-accent hover:text-accent-foreground"
              >
                <span class="flex items-center gap-3">
                  <span class="sidebar-icon-span flex shrink-0 items-center justify-center transition-colors duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[15px] [&>svg]:h-[15px] text-muted-foreground group-hover:text-accent-foreground">
                    <IconComponent />
                  </span>
                  <span class="font-medium text-[14px]">{item.label}</span>
                </span>

                <span class="sidebar-arrow-span items-center justify-center transition-colors duration-200 absolute right-[12px] w-[19px] h-[19px] text-accent-foreground [&>svg]:block [&>svg]:w-[13px] [&>svg]:h-[13px] hidden">
                  <ArrowRight />
                </span>
              </a>
            );
          })}
        </div>
      </div>
    ))
  }

  <ThemeToggle />
</nav>

<script>
  document.addEventListener("astro:page-load", () => {
    const currentPath = window.location.pathname;
    const sidebarLinks = document.querySelectorAll("[data-sidebar-link]");

    sidebarLinks.forEach((link) => {
      const href = link.getAttribute("href");
      const isActive =
        href === "/" ? currentPath === "/" : currentPath.startsWith(href || "");

      const iconSpan = link.querySelector(".sidebar-icon-span");
      const arrowSpan = link.querySelector(".sidebar-arrow-span");

      if (isActive) {
        link.setAttribute("aria-current", "page");
        /* ACTIVE STATE: Menggunakan border-border, bg-accent, text-accent-foreground, dan bayangan tipis */
        link.className =
          "flex items-center justify-between rounded-lg border transition-colors duration-200 cursor-pointer relative py-[6px] px-[12px] group border-border bg-accent text-accent-foreground shadow-xs font-semibold";
        if (iconSpan)
          iconSpan.className =
            "sidebar-icon-span flex shrink-0 items-center justify-center transition-colors duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[15px] [&>svg]:h-[15px] text-accent-foreground";
        if (arrowSpan)
          arrowSpan.className =
            "sidebar-arrow-span items-center justify-center transition-colors duration-200 absolute right-[12px] w-[19px] h-[19px] text-accent-foreground [&>svg]:block [&>svg]:w-[13px] [&>svg]:h-[13px] flex";
      } else {
        link.removeAttribute("aria-current");
        /* INACTIVE STATE RESTORATION */
        link.className =
          "flex items-center justify-between rounded-lg border transition-colors duration-200 cursor-pointer relative py-[6px] px-[12px] group border-transparent bg-transparent text-foreground/70 hover:bg-accent hover:text-accent-foreground";
        if (iconSpan)
          iconSpan.className =
            "sidebar-icon-span flex shrink-0 items-center justify-center transition-colors duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[15px] [&>svg]:h-[15px] text-foreground/70 group-hover:text-accent-foreground ";
        if (arrowSpan)
          arrowSpan.className =
            "sidebar-arrow-span items-center justify-center transition-colors duration-200 absolute right-[12px] w-[19px] h-[19px] text-foreground/70 [&>svg]:block [&>svg]:w-[13px] [&>svg]:h-[13px] hidden";
      }
    });
  });
</script>