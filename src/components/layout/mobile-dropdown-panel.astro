---
// mobile-dropdown-panel.astro
import { publicDashboardMenu } from "../../commons/constants/navigation-menu.ts";
import { Home, Briefcase, FileText, Brain, MessageCircle, Wrench, MapPin, User, Menu, ArrowRight } from "lucide-static";

const currentPath = Astro.url.pathname;
const iconMap = {
  "/": Home,
  "/project": Briefcase,
  "/blog": FileText,
  "/auth": User,
  "/profile": User,
  "/ai": Brain,
  "/chat": MessageCircle,
  "/tools": Wrench,
  "/roadmap": MapPin,
};
---

<div
  id="mobile-dropdown"
  class="md:hidden fixed inset-x-0 bottom-0 z-40 overflow-y-auto rounded-t-[2rem] bg-[hsl(var(--secondary))/0.98] p-4 shadow-2xl backdrop-blur-xl max-h-[70vh] opacity-0 pointer-events-none translate-y-4 transition-all duration-300"
>
  <div class="space-y-4 pb-24">
    <div class="rounded-3xl border-x border-t-0 border-b-0 border-[hsl(var(--border))] bg-[hsl(var(--background))] p-4">
      <div class="flex items-center gap-3">
        <span class="grid h-14 w-14 place-items-center rounded-3xl bg-[hsl(var(--primary))]/15 text-[hsl(var(--primary))]">
          <span class="flex items-center justify-center h-6 w-6 [&>svg]:w-full [&>svg]:h-full [&>svg]:block" set:html={User}></span>
        </span>
        <div>
          <p class="text-sm font-semibold text-[hsl(var(--foreground))]">Helmi Arimbawa</p>
          <p class="text-xs text-[hsl(var(--foreground)/0.65)]">Frontend Developer</p>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      {publicDashboardMenu.map((section) => (
        <div class="space-y-3">
          {section.groupLabel ? (
            <p class="text-[0.63rem] font-semibold uppercase tracking-[0.3em] text-[hsl(var(--foreground)/0.65)]">
              {section.groupLabel}
            </p>
          ) : null}
          <div class="space-y-2">
            {section.menus.map((item) => {
              const isActive = item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href);
              const iconMarkup = iconMap[item.href] ?? Menu;
              return (
                <a
                  href={item.href}
                  aria-current={isActive ? 'page' : undefined}
                  class={`flex items-center justify-between rounded-2xl border px-3 py-3 text-sm font-medium transition-all duration-200 ${
                    isActive
                      ? 'border-[hsl(var(--primary))] bg-[hsl(var(--primary)/0.08)] text-[hsl(var(--foreground))] shadow-[0_10px_30px_-15px_rgba(15,23,42,0.25)]'
                      : 'border-[hsl(var(--border))] bg-[hsl(var(--background))] text-[hsl(var(--foreground))] hover:bg-[hsl(var(--secondary)/0.92)]'
                  }`}
                >
                  <span class="flex items-center gap-3">
                    <span class="flex items-center justify-center h-5 w-5 shrink-0 [&>svg]:w-full [&>svg]:h-full [&>svg]:block" set:html={iconMarkup}></span>
                    <span>{item.label}</span>
                  </span>
                  {isActive ? (
                    <span class="flex h-5 w-5 items-center justify-center rounded-full bg-[hsl(var(--primary)/0.16)] text-[hsl(var(--primary))] [&>svg]:h-3.5 [&>svg]:w-3.5 [&>svg]:block" set:html={ArrowRight}></span>
                  ) : null}
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
