---
// mobile-dropdown-panel.astro
import { publicDashboardMenu } from "../../commons/constants/navigation-menu.ts";
import { Home, Briefcase, FileText, Brain, MessageCircle, Wrench, MapPin, User, Menu, ArrowRight } from "lucide-static";

const currentPath = Astro.url.pathname;
const iconMap = {
  "/": Home,
  "/project": Briefcase,
  "/blog": FileText,
  "/auth": User,
  "/profile": User,
  "/ai": Brain,
  "/chat": MessageCircle,
  "/tools": Wrench,
  "/roadmap": MapPin,
};
---

<div
  id="mobile-dropdown"
  class="md:hidden fixed inset-x-0 bottom-0 z-40 overflow-y-auto rounded-t-[2rem] border-t border-[hsl(var(--border))] bg-[hsl(var(--background))] p-5 shadow-2xl max-h-[75vh] opacity-0 pointer-events-none translate-y-4 transition-all duration-300"
>
  <div class="space-y-4 pb-28">
    <div class="rounded-2xl border border-[hsl(var(--border))] bg-[hsl(var(--secondary))/0.3] p-4">
      <div class="flex items-center gap-3">
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-[hsl(var(--primary))]/10 text-[hsl(var(--foreground))]">
          <span class="flex items-center justify-center h-5 w-5 [&>svg]:w-full [&>svg]:h-full [&>svg]:block" set:html={User}></span>
        </span>
        <div>
          <p class="text-sm font-semibold text-[hsl(var(--foreground))]">Helmi Arimbawa</p>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      {publicDashboardMenu.map((section) => (
        <div class="space-y-3">
          {section.groupLabel ? (
            <p class="text-[0.63rem] font-semibold uppercase tracking-[0.3em] text-[hsl(var(--foreground)/0.5)]">
              {section.groupLabel}
            </p>
          ) : null}
          <div class="space-y-2">
            {section.menus.map((item) => {
              const isActive = item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href);
              const iconMarkup = iconMap[item.href] ?? Menu;
              return (
                <a
                  href={item.href}
                  aria-current={isActive ? 'page' : undefined}
                  class={`flex items-center justify-between rounded-xl border px-3 py-3 text-sm font-medium transition-all duration-200 ${
                    isActive
                      ? 'border-[hsl(var(--border))] bg-[hsl(var(--secondary))] text-[hsl(var(--foreground))] shadow-sm'
                      : 'border-transparent bg-transparent text-[hsl(var(--foreground)/0.6)] hover:bg-[hsl(var(--secondary))] hover:text-[hsl(var(--foreground))]'
                  }`}
                >
                  <span class="flex items-center gap-3">
                    <span class="flex items-center justify-center h-5 w-5 shrink-0 [&>svg]:w-full [&>svg]:h-full [&>svg]:block" set:html={iconMarkup}></span>
                    <span>{item.label}</span>
                  </span>
                  {isActive ? (
                    <span class="flex h-5 w-5 items-center justify-center rounded-full bg-[hsl(var(--primary)/0.1)] text-[hsl(var(--foreground))] [&>svg]:h-3.5 [&>svg]:w-3.5 [&>svg]:block" set:html={ArrowRight}></span>
                  ) : null}
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <!-- New Dark Mode Toggle -->
    <!-- New Dark Mode Toggle -->
    <div class="space-y-3">
      <p class="text-[0.63rem] font-semibold uppercase tracking-[0.3em] text-[hsl(var(--foreground)/0.5)] pl-1">
        THEMING
      </p>
      <div class="space-y-2">
        <label
          for="mobile-theme-switch"
          class="flex items-center justify-between rounded-xl border border-transparent bg-transparent px-3 py-3 text-sm font-medium text-[hsl(var(--foreground)/0.6)] hover:bg-[hsl(var(--secondary))] hover:text-[hsl(var(--foreground))] transition-all duration-200 cursor-pointer select-none"
        >
          <span class="flex items-center gap-3">
            <span class="flex items-center justify-center h-5 w-5 shrink-0 animate-fade-in [&>svg]:w-full [&>svg]:h-full [&>svg]:block" id="mobile-theme-icon"></span>
            <span>Dark Mode</span>
          </span>
          <div class="relative inline-block w-11 h-5 shrink-0 pointer-events-none mr-1">
            <input 
              id="mobile-theme-switch" 
              type="checkbox" 
              class="peer appearance-none w-11 h-5 bg-slate-200 dark:bg-zinc-800 rounded-full checked:bg-slate-800 dark:checked:bg-emerald-500 cursor-pointer transition-colors duration-300" 
            />
            <span 
              class="absolute top-0 left-0 w-5 h-5 bg-white rounded-full border border-slate-300 dark:border-zinc-700 shadow-sm transition-transform duration-300 peer-checked:translate-x-6 peer-checked:border-slate-800 dark:peer-checked:border-emerald-500 cursor-pointer"
            >
            </span>
            <script is:inline>
              (function () {
                try {
                  const theme = localStorage.getItem('astro-theme');
                  const isDark = theme ? theme === 'dark' : window.matchMedia?.('(prefers-color-scheme: dark)').matches;
                  if (isDark) {
                    document.getElementById('mobile-theme-switch').checked = true;
                  }
                } catch (e) {
                  // ignore
                }
              })();
            </script>
          </div>
        </label>
      </div>
    </div>

  </div>
</div>

<script>
  const storageKey = 'astro-theme';
  const html = document.documentElement;
  
  const mCheckbox = document.getElementById('mobile-theme-switch') as HTMLInputElement;
  const mIcon = document.getElementById('mobile-theme-icon');

  const SunIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sun"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>`;
  const MoonIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>`;

  const setMobileTheme = (dark: boolean) => {
    if (mCheckbox) mCheckbox.checked = dark;
    if (mIcon) {
      mIcon.innerHTML = dark ? MoonIcon : SunIcon;
    }
  };

  const syncTheme = () => {
    const isDark = html.classList.contains('dark');
    setMobileTheme(isDark);
  };

  // Initial Sync
  syncTheme();

  // Watch for html class changes (sync with desktop theme changes)
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === 'class') {
        syncTheme();
      }
    });
  });
  observer.observe(html, { attributes: true });

  mCheckbox?.addEventListener('change', () => {
    const nextTheme = mCheckbox.checked;
    try {
      localStorage.setItem(storageKey, nextTheme ? 'dark' : 'light');
    } catch {
      // ignore
    }
    html.classList.toggle('dark', nextTheme);
    setMobileTheme(nextTheme);
  });
</script>
