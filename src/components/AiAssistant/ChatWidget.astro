---
// src/components/AiAssistant/ChatWidget.astro
---

<!-- Floating Toggle Button -->
<button
  id="ai-chat-toggle"
  class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 rounded-full bg-black border border-neutral-800 text-white shadow-2xl hover:scale-105 active:scale-95 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-neutral-700"
  aria-label="Tanya Asisten AI"
>
  <svg
    id="chat-icon-open"
    class="w-6 h-6 transition-transform duration-300"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.5"
      d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
    ></path>
  </svg>
  <svg
    id="chat-icon-close"
    class="hidden w-6 h-6 transition-transform duration-300"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.5"
      d="M6 18L18 6M6 6l12 12"
    ></path>
  </svg>
</button>

<!-- Chat Widget Container -->
<div
  id="ai-chat-widget"
  class="hidden fixed bottom-24 right-6 z-50 w-[90vw] sm:w-[380px] h-[500px] flex-col rounded-2xl bg-[#000000] border border-neutral-900 shadow-2xl overflow-hidden transition-all duration-300 transform scale-95 opacity-0 origin-bottom-right"
>
  <!-- Header -->
  <div class="flex items-center justify-between px-4 py-3 bg-[#0a0a0a] border-b border-neutral-900">
    <div class="flex items-center gap-2.5">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <div>
        <h3 class="text-xs font-semibold text-neutral-200 tracking-wide">PORTFOLIO ASSISTANT</h3>
        <p class="text-[10px] text-neutral-500">Powered by Llama-3-8B AI</p>
      </div>
    </div>
    <button
      id="ai-chat-close-btn"
      class="text-neutral-500 hover:text-neutral-300 focus:outline-none"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Messages Container -->
  <div
    id="ai-chat-messages"
    class="flex-1 overflow-y-auto p-4 space-y-4 text-sm scrollbar-thin scrollbar-thumb-neutral-900 scrollbar-track-transparent"
  >
    <!-- Welcome message will be inserted dynamically -->
  </div>

  <!-- Error Alert (Rate Limiting, etc) -->
  <div
    id="ai-chat-error"
    class="hidden px-4 py-2 bg-red-950/40 border-t border-red-900/50 text-red-400 text-xs flex items-center gap-2"
  >
    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
    </svg>
    <span id="ai-chat-error-text">Batas harian tercapai. Silakan coba lagi besok.</span>
  </div>

  <!-- Typing Indicator -->
  <div
    id="ai-chat-typing"
    class="hidden px-4 py-2 text-xs text-neutral-500 flex items-center gap-1.5 bg-[#030303]"
  >
    <span>AI sedang mengetik</span>
    <span class="flex gap-0.5">
      <span class="w-1 h-1 rounded-full bg-neutral-500 animate-bounce" style="animation-delay: 0ms"></span>
      <span class="w-1 h-1 rounded-full bg-neutral-500 animate-bounce" style="animation-delay: 150ms"></span>
      <span class="w-1 h-1 rounded-full bg-neutral-500 animate-bounce" style="animation-delay: 300ms"></span>
    </span>
  </div>

  <!-- Input Form -->
  <form
    id="ai-chat-form"
    class="p-3 bg-[#050505] border-t border-neutral-900 flex gap-2 items-center"
  >
    <input
      id="ai-chat-input"
      type="text"
      placeholder="Tanyakan keahlian Helmi..."
      autocomplete="off"
      class="flex-1 px-3.5 py-2 bg-neutral-950 border border-neutral-900 text-white placeholder-neutral-600 text-xs rounded-xl focus:outline-none focus:border-neutral-700 transition-colors"
      required
    />
    <button
      type="submit"
      id="ai-chat-submit"
      class="flex items-center justify-center w-8 h-8 rounded-xl bg-white text-black hover:bg-neutral-200 transition-colors focus:outline-none"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </button>
  </form>
</div>

<script>
  interface Message {
    role: "user" | "assistant";
    content: string;
  }

  const WELCOME_MESSAGE = "Halo! Saya adalah asisten AI Helmi. Silakan tanyakan apa saja tentang keahlian teknis Helmi di bidang DevOps, Web Development, Infrastruktur Server, atau CAD & 3D Modeling.";

  function initChat() {
    const toggleBtn = document.getElementById("ai-chat-toggle");
    const closeBtn = document.getElementById("ai-chat-close-btn");
    const widget = document.getElementById("ai-chat-widget");
    const openIcon = document.getElementById("chat-icon-open");
    const closeIcon = document.getElementById("chat-icon-close");

    const chatForm = document.getElementById("ai-chat-form") as HTMLFormElement;
    const chatInput = document.getElementById("ai-chat-input") as HTMLInputElement;
    const messagesContainer = document.getElementById("ai-chat-messages");
    const typingIndicator = document.getElementById("ai-chat-typing");
    const errorAlert = document.getElementById("ai-chat-error");
    const errorText = document.getElementById("ai-chat-error-text");

    if (!toggleBtn || !widget || !openIcon || !closeIcon || !chatForm || !chatInput || !messagesContainer) {
      return;
    }

    let chatHistory: Message[] = [];

    // Load chat history from Session Storage to persist across pages
    try {
      const stored = sessionStorage.getItem("ai_assistant_chats");
      if (stored) {
        chatHistory = JSON.parse(stored);
      }
    } catch (e) {
      console.error("Failed to load chat history", e);
    }

    // Toggle Chat Widget Visibility
    function toggleChat(forceOpen?: boolean) {
      const isHidden = widget.classList.contains("hidden");
      const shouldOpen = forceOpen !== undefined ? forceOpen : isHidden;

      if (shouldOpen) {
        widget.classList.remove("hidden");
        widget.classList.add("flex");
        // Trigger reflow for transition animation
        widget.offsetHeight;
        widget.classList.remove("scale-95", "opacity-0");
        widget.classList.add("scale-100", "opacity-100");
        openIcon.classList.add("hidden");
        closeIcon.classList.remove("hidden");
        renderMessages();
        scrollToBottom();
      } else {
        widget.classList.remove("scale-100", "opacity-100");
        widget.classList.add("scale-95", "opacity-0");
        openIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");
        // Delay hiding element to let transitions finish
        setTimeout(() => {
          if (widget.classList.contains("opacity-0")) {
            widget.classList.remove("flex");
            widget.classList.add("hidden");
          }
        }, 300);
      }
    }

    toggleBtn.addEventListener("click", () => toggleChat());
    if (closeBtn) {
      closeBtn.addEventListener("click", () => toggleChat(false));
    }

    // Helper to scroll messages list to bottom
    function scrollToBottom() {
      if (messagesContainer) {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }
    }

    // Render all messages in the history
    function renderMessages() {
      if (!messagesContainer) return;
      messagesContainer.innerHTML = "";

      // Add Welcome Message if history is empty
      const messagesToRender = chatHistory.length === 0 
        ? [{ role: "assistant", content: WELCOME_MESSAGE } as Message] 
        : chatHistory;

      messagesToRender.forEach((msg) => {
        const messageDiv = document.createElement("div");
        messageDiv.className = `flex ${msg.role === "user" ? "justify-end" : "justify-start"}`;

        const bubble = document.createElement("div");
        bubble.className = msg.role === "user"
          ? "max-w-[85%] px-3.5 py-2.5 bg-neutral-900 border border-neutral-800 text-neutral-100 rounded-2xl rounded-tr-sm text-xs leading-relaxed"
          : "max-w-[85%] px-3.5 py-2.5 bg-[#000000] border border-neutral-900 text-neutral-300 rounded-2xl rounded-tl-sm text-xs leading-relaxed";

        bubble.textContent = msg.content;
        messageDiv.appendChild(bubble);
        messagesContainer.appendChild(messageDiv);
      });
    }

    // Form Submission
    chatForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const text = chatInput.value.trim();
      if (!text) return;

      // Clear input and hide any previous error
      chatInput.value = "";
      if (errorAlert) errorAlert.classList.add("hidden");

      // Append user message
      chatHistory.push({ role: "user", content: text });
      renderMessages();
      scrollToBottom();
      saveHistory();

      // Show typing indicator
      if (typingIndicator) typingIndicator.classList.remove("hidden");
      scrollToBottom();

      try {
        const response = await fetch("/api/chat", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            messages: chatHistory
          }),
        });

        const data = await response.json();

        if (typingIndicator) typingIndicator.classList.add("hidden");

        if (response.status === 429) {
          showError(data.error || "Batas harian tercapai. Silakan coba lagi besok.");
          return;
        }

        if (!response.ok) {
          throw new Error(data.error || "Gagal mendapatkan respon.");
        }

        const reply = data.response?.response || data.response || "Maaf, terjadi kendala saat memproses jawaban.";
        chatHistory.push({ role: "assistant", content: reply });
        renderMessages();
        scrollToBottom();
        saveHistory();
      } catch (err: any) {
        if (typingIndicator) typingIndicator.classList.add("hidden");
        showError("Terjadi kesalahan koneksi. Silakan coba lagi nanti.");
        console.error("Chat error:", err);
      }
    });

    function showError(message: string) {
      if (errorAlert && errorText) {
        errorText.textContent = message;
        errorAlert.classList.remove("hidden");
        scrollToBottom();
      }
    }

    function saveHistory() {
      try {
        sessionStorage.setItem("ai_assistant_chats", JSON.stringify(chatHistory));
      } catch (e) {
        console.error("Failed to save chat history", e);
      }
    }
  }

  // Support Astro View Transitions (ClientRouter)
  document.addEventListener("astro:page-load", initChat);
</script>
