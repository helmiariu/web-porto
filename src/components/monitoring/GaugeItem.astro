---
// @components/ui/GaugeItem.astro
interface Props {
    id: string;
    label: string;
    unit: string;
    initialValue: number;
    maxLimit: number;
    precision?: number;
    class?: string;
}

const {
    id,
    label,
    unit,
    initialValue,
    maxLimit,
    precision = 0,
    class: className,
} = Astro.props;
const initialPct = Math.min(Math.max((initialValue / maxLimit) * 100, 0), 100);
---

<div
    class={`relative w-full h-full aspect-square gauge-container ${className || ""}`}
    data-type={id}
    data-max={maxLimit}
    data-precision={precision}
    data-target-percentage={initialPct}
>
    <svg class="w-full h-full" viewBox="0 0 200 200">
        <!-- Background Track -->
        <path
            class="fill-none stroke-[hsl(var(--border))] stroke-[4] stroke-linecap-round transition-colors duration-300"
            d="M 40 160 A 75 75 0 1 1 160 160"></path>

        <!-- Start Tick Base -->
        <line
            class="stroke-[hsl(var(--border))] transition-colors duration-300"
            x1="44.6"
            y1="156.55"
            x2="43.4"
            y2="154.95"
            stroke-width="7.5"></line>

        <!-- Start Tick Active -->
        <line
            class="tick-start stroke-[hsl(var(--primary))] transition-colors duration-300"
            x1="44.6"
            y1="156.55"
            x2="43.4"
            y2="154.95"
            stroke-width="7.5"
            stroke-dasharray="2"
            stroke-dashoffset="2"></line>

        <!-- End Tick Base -->
        <line
            class="stroke-[hsl(var(--border))] transition-colors duration-300"
            x1="155.4"
            y1="156.55"
            x2="156.6"
            y2="154.95"
            stroke-width="7.5"></line>

        <!-- End Tick Active -->
        <line
            class="tick-end stroke-[hsl(var(--primary))] transition-colors duration-300"
            x1="155.4"
            y1="156.55"
            x2="156.6"
            y2="154.95"
            stroke-width="7.5"
            stroke-dasharray="2"
            stroke-dashoffset="2"></line>

        <!-- Main Progress Path -->
        <path
            class="progress-path fill-none stroke-[hsl(var(--primary))] stroke-[4] stroke-linecap-round transition-colors duration-300"
            d="M 40 160 A 75 75 0 1 1 160 160"></path>

        <!-- Label -->
        <text
            x="100"
            y="82"
            text-anchor="middle"
            class="fill-[hsl(var(--foreground))] font-mono font-bold tracking-[2px] transition-colors duration-300"
            font-size="14"
        >
            {label}
        </text>

        <!-- Value -->
        <text
            x="100"
            y="128"
            text-anchor="middle"
            class="fill-[hsl(var(--foreground))] font-mono font-bold value-text tracking-tight transition-colors duration-300"
            font-size="42"
        >
            {initialValue.toFixed(precision)}
        </text>

        <!-- Unit -->
        <text
            x="100"
            y="162"
            text-anchor="middle"
            class="fill-[hsl(var(--foreground))] font-mono font-bold tracking-wider transition-colors duration-300"
            font-size="18"
        >
            {unit}
        </text>
    </svg>
</div>
