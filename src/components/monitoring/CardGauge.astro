---
// @components/ui/CardGauge.astro
import LoadTestButton from "@components/monitoring/LoadTestButton.astro";

interface Props {
    title: string;
}
const { title } = Astro.props;
---

<div
    class="bg-[hsl(var(--muted)/0.4)] border border-[hsl(var(--border))] p-4 rounded-[var(--radius)] shadow-lg flex flex-col items-center backdrop-blur-sm transition-colors duration-300"
>
    <h3
        class="text-[hsl(var(--foreground)/0.6)] font-semibold mb-2 text-sm uppercase tracking-wider"
    >
        {title}
    </h3>
    <slot />
    <LoadTestButton />
</div>
