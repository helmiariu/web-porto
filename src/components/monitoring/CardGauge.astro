---
// @components/ui/CardGauge.astro
import LoadTestButton from "@components/monitoring/LoadTestButton.astro";

interface Props {
    title: string;
}
const { title } = Astro.props;
---

<div
    class="bg-card border p-4 rounded-lg shadow-lg flex flex-col items-center backdrop-blur-sm transition-colors duration-300"
>
    <h3
        class="text-muted-foreground font-semibold mb-2 text-sm uppercase tracking-wider"
    >
        {title}
    </h3>
    <slot />
    <LoadTestButton />
</div>
