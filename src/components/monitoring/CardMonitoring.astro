---
import MetricDashboard from "@components/monitoring/MetricDashboard.astro";
import { serverMetrics } from "@components/monitoring/utils/config";

import WatchingBadge from "@components/monitoring/WatchingBadge.astro";
---

<main class="min-h-screen p-0">
    <!-- Kontainer dengan grid 3 kolom agar judul benar-benar di tengah -->
    <div class="grid grid-cols-3 items-center px-4 mb-6">
        <div class="justify-self-start">
            <WatchingBadge />
        </div>
    </div>

    <MetricDashboard metrics={serverMetrics} />
</main>
