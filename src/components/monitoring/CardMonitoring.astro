---
import MetricDashboard from "@components/ui/MatricDashboard.astro";

// Sesuaikan URL ini dengan domain Cloudflare atau IP OpenWrt kamu
const LIVE_API_URL = "https://api-status-stb1.helmiari.my.id/stream-status";

const serverMetrics = [
    {
        id: "cpu",
        label: "CPU USAGE",
        unit: "%",
        initialValue: 0,
        maxLimit: 100,
        precision: 1,
    },
    {
        id: "temp",
        label: "CORE TEMP",
        unit: "°C",
        initialValue: 0,
        maxLimit: 100,
        precision: 0,
    },
    {
        id: "download",
        label: "DOWNLOAD",
        unit: "KB/s",
        initialValue: 0,
        maxLimit: 5000,
        precision: 1,
    },
    {
        id: "upload",
        label: "UPLOAD",
        unit: "KB/s",
        initialValue: 0,
        maxLimit: 1000,
        precision: 1,
    },
];
---

<main class="min-h-screen bg-[#0b0c0d] p-8 text-white">
    <h1 class="text-center text-xl font-mono mb-6 tracking-widest">
        REYRE-WRT REALTIME MONITOR
    </h1>

    <MetricDashboard metrics={serverMetrics} apiUrl={LIVE_API_URL} />
</main>
