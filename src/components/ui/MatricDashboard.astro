---
// @components/ui/MatricDashboard.astro
import GaugeItem from "@components/ui/GaugeItem.astro";
import Card from "@components/ui/CardGauge.astro";

interface MetricConfig {
    id: string;
    label: string;
    unit: string;
    initialValue: number;
    maxLimit: number;
    precision?: number;
}

interface Props {
    metrics: MetricConfig[];
    apiUrl: string;
}

const { metrics, apiUrl } = Astro.props;
---

<div
    id="dashboard-container"
    data-api-url={apiUrl}
    class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-2 p-2 rounded-xl"
>
    {
        metrics.map((metric) => (
            /* Di sini Anda bisa membungkusnya dengan Card dan memberikan class style khusus jika dibutuhkan */
            <Card title={`${metric.label} Monitor`}>
                <GaugeItem
                    id={metric.id}
                    label={metric.label}
                    unit={metric.unit}
                    initialValue={metric.initialValue}
                    maxLimit={metric.maxLimit}
                    precision={metric.precision}
                    class="mx-auto scale-95 hover:scale-100 transition-transform"
                />
            </Card>
        ))
    }
</div>

<style>
    .progress-path {
        will-change: stroke-dashoffset;
    }
</style>

<script>
    class GaugeController {
        private path: SVGPathElement;
        private tickStart: SVGLineElement;
        private tickEnd: SVGLineElement;
        private valueText: SVGTextElement;

        private totalLength: number;
        private tickLength: number;
        private currentPercentage: number = 0;
        private targetPercentage: number = 0;
        private animationId: number | null = null;

        public maxLimit: number;
        public precision: number;

        constructor(container: HTMLElement) {
            this.path = container.querySelector(
                ".progress-path",
            ) as SVGPathElement;
            this.tickStart = container.querySelector(
                ".tick-start",
            ) as SVGLineElement;
            this.tickEnd = container.querySelector(
                ".tick-end",
            ) as SVGLineElement;
            this.valueText = container.querySelector(
                ".value-text",
            ) as SVGTextElement;

            // Setup gauge utama
            this.totalLength = this.path.getTotalLength();
            this.path.style.strokeDasharray = String(this.totalLength);
            this.path.style.strokeDashoffset = String(this.totalLength);

            // Setup panjang potongan untuk Tick berdasarkan ukuran fisik aslinya (2px)
            this.tickLength = this.tickStart.getTotalLength();

            this.tickStart.style.strokeDasharray = String(this.tickLength);
            this.tickStart.style.strokeDashoffset = String(this.tickLength);

            this.tickEnd.style.strokeDasharray = String(this.tickLength);
            this.tickEnd.style.strokeDashoffset = String(this.tickLength);

            this.maxLimit = parseFloat(
                container.getAttribute("data-max") || "100",
            );
            this.precision = parseInt(
                container.getAttribute("data-precision") || "0",
                10,
            );

            const initialPct = parseFloat(
                container.getAttribute("data-target-percentage") || "0",
            );
            this.update(initialPct, this.valueText.textContent || "0");
        }

        public update(percentage: number, rawValue: string) {
            this.targetPercentage = Math.min(Math.max(percentage, 0), 100);
            this.valueText.textContent = rawValue;

            if (!this.animationId) {
                this.animationId = requestAnimationFrame(this.animate);
            }
        }

        private animate = () => {
            const ease = 0.15;
            const diff = this.targetPercentage - this.currentPercentage;

            if (Math.abs(diff) < 0.05) {
                this.currentPercentage = this.targetPercentage;
                this.animationId = null;
            } else {
                this.currentPercentage += diff * ease;
                this.animationId = requestAnimationFrame(this.animate);
            }

            // 1. Update jalannya progress bar utama
            const offset =
                this.totalLength -
                (this.currentPercentage / 100) * this.totalLength;
            this.path.style.strokeDashoffset = String(offset);

            // 2. HITUNG PIKSEL AKTIF SECARA REAL-TIME (Untuk Sinkronisasi Sub-Piksel)
            const pikselMenyala =
                (this.currentPercentage / 100) * this.totalLength;

            // 3. ANIMASI TICK START (Mengisi linear pixel-by-pixel dari 0px sampai 2px pertama)
            const tickStartFilledPx = Math.min(pikselMenyala, this.tickLength);
            this.tickStart.style.strokeDashoffset = String(
                this.tickLength - tickStartFilledPx,
            );

            // 4. ANIMASI TICK END (Mengisi linear pixel-by-pixel pada sisa 2px terakhir sebelum 100%)
            const jarakAwalTickEnd = this.totalLength - this.tickLength;
            const tickEndFilledPx = Math.min(
                Math.max(pikselMenyala - jarakAwalTickEnd, 0),
                this.tickLength,
            );
            this.tickEnd.style.strokeDashoffset = String(
                this.tickLength - tickEndFilledPx,
            );
        };
    }

    let eventSource: EventSource | null = null;

    document.addEventListener("astro:page-load", () => {
        const mainContainer = document.getElementById(
            "dashboard-container",
        ) as HTMLElement;
        if (!mainContainer) return;

        const targetApiUrl = mainContainer.getAttribute("data-api-url") || "";
        const gauges: Record<string, GaugeController> = {};

        document.querySelectorAll(".gauge-container").forEach((el) => {
            const htmlEl = el as HTMLElement;
            const type = htmlEl.getAttribute("data-type") || "";
            gauges[type] = new GaugeController(htmlEl);
        });

        if (targetApiUrl) {
            if (eventSource) eventSource.close();
            eventSource = new EventSource(targetApiUrl);

            eventSource.onmessage = (event) => {
                try {
                    const data = JSON.parse(event.data);
                    for (const key in data) {
                        const gauge = gauges[key];
                        if (gauge) {
                            const rawValue = data[key];
                            const pct = (rawValue / gauge.maxLimit) * 100;
                            gauge.update(
                                pct,
                                rawValue.toFixed(gauge.precision),
                            );
                        }
                    }
                } catch (error) {
                    console.error("Gagal memproses data SSE:", error);
                }
            };

            eventSource.onerror = (err) => {
                console.error("Koneksi SSE terputus:", err);
            };
        }
    });

    document.addEventListener("astro:before-swap", () => {
        if (eventSource) {
            eventSource.close();
            eventSource = null;
        }
    });
</script>
