---
// ProfileCard.astro
import VerifiedBadge from "@components/ui/VerifiedBadge.astro";
import AvatarDropdown from "@components/ui/AvatarDropdown.astro";
import { Bot } from "@lucide/astro";

interface Props {
  variant?: "sidebar" | "mobile";
}

const { variant = "sidebar" } = Astro.props;
const isMobile = variant === "mobile";
---

{
  isMobile ? (
    /* Tampilan khusus Handphone (di atas halaman home) */
    <div class="md:hidden w-full mb-0 pr-3 sm:pr-10 pl-0 pb-4 pt-2 border-[hsl(var(--border))] animate-fade-in flex flex-col items-start gap-4 text-left">
      <AvatarDropdown sizeClass="w-22 h-22" />

      <div class="flex items-center gap-1.5">
        <h2 class="text-[clamp(1.3rem,6vw,1.5rem)] font-bold tracking-tight text-foreground">
          Helmi Arimbawa
        </h2>
        <VerifiedBadge />
      </div>
      <span class="flex items-center gap-2.5 text-[14px] text-muted-foreground font-sm -mt-3">
        <a
          href="/myAI"
          class="flex items-center gap-1 px-2 py-0.5 rounded-md bg-muted hover:bg-muted/80 text-foreground border border-border text-[11px] font-medium transition-colors"
        >
          <Bot class="h-3 w-3 text-blue-500" />
          My AI
        </a>
        <a href="#" class="email-display">
          Load...
        </a>
      </span>
    </div>
  ) : (
    /* Tampilan khusus Desktop (di Sidebar) */
    <div class="mb-5 pl-2 flex flex-col">
      <div class="relative mb-1">
        <AvatarDropdown sizeClass="w-24 h-24" />
      </div>

      <div class="space-y-1">
        <h1 class="text-lg lg:text-xl font-bold tracking-tight text-[hsl(var(--foreground))] flex items-center gap-1.5 whitespace-nowrap">
          Helmi Arimbawa
          <VerifiedBadge />
        </h1>

        <span class="flex items-center gap-1.5 text-xs text-muted-foreground font-sm mt-1.5 ">
          <a
            href="/myAI"
            class="flex items-center gap-1 px-2 py-0.5 rounded-sm bg-muted hover:bg-muted/80 text-foreground border border-border text-[10px] font-medium transition-colors"
          >
            <Bot class="h-3 w-3 text-blue-500" />
            My AI
          </a>
          <a href="#" class="email-display">
            Load...
          </a>
        </span>
      </div>
    </div>
  )
}

<script>
  document.addEventListener("astro:page-load", async () => {
    // DIUBAH: Mengambil semua elemen dengan class .email-display
    const emailLinks = document.querySelectorAll(".email-display");

    try {
      const response = await fetch("/api/get-email");
      const data = await response.json();

      if (data.email) {
        // DIUBAH: Melakukan looping untuk mengubah semua elemen yang ditemukan
        emailLinks.forEach((link) => {
          const anchor = link as HTMLAnchorElement;
          anchor.textContent = data.email;
          anchor.href = `mailto:${data.email}`;
        });
      }
    } catch (err) {
      emailLinks.forEach((link) => {
        link.textContent = "...";
      });
    }
  });
</script>
