---
// ProfileCard.astro
import SocialLinks from "@components/ui/SocialLinks.astro";

interface Props {
  variant?: "sidebar" | "mobile";
}

const { variant = "sidebar" } = Astro.props;
const isMobile = variant === "mobile";
---

{
  isMobile ? (
    <div class="md:hidden w-full mb-0 pb-6 border-b border-[hsl(var(--border))] animate-fade-in flex flex-col items-center text-center">
<div class="relative w-28 h-28 mb-4">
  <div class="w-full h-full rounded-full overflow-hidden border border-[hsl(var(--border))]">
    <img
      src="/avatar.jpg"
      alt="Helmi Arimbawa"
      class="w-full h-full object-cover"
      loading="eager"
      decoding="sync"
      onerror="this.src='data:image/svg+xml;base64,'"
    />
  </div>

  <span class="absolute bottom-1 right-1 flex justify-center items-center h-6 w-6 translate-x-[5%] translate-y-[5%]">
    <span class="relative inline-flex h-4 w-4 rounded-full bg-[hsl(var(--background))] shadow-sm ring-1 ring-black/5 dark:ring-white/10">
      <span class="absolute inset-0.5 rounded-full bg-emerald-500 animate-pulse"></span>
    </span>
  </span>
</div>

{/* <div class="space-y-1 flex flex-col items-center">
  <h2 class="text-2xl font-bold tracking-tight text-[hsl(var(--foreground))]">
    Helmi Arimbawa
  </h2>
</div> */}
    </div>
  ) : (
    <div class="mb-5 pl-2 flex flex-col">
      <div class="relative">
        <div class="w-24 h-24 rounded-full overflow-hidden mb-4 border border-[hsl(var(--border))]">
          <img
            src="/avatar.jpg"
            alt="Profile"
            class="w-full h-full object-cover"
            loading="eager"
            decoding="sync"
            onerror="this.src='data:image/svg+xml;base64,'"
          />
        </div>
      </div>

      <div class="space-y-1">
        <h1 class="text-xl font-bold tracking-tight text-[hsl(var(--foreground))]">
          Helmi Arimbawa
        </h1>
        <div class="flex items-center gap-2 pt-0">
          <span class="relative flex h-2.5 w-2.5">
            <!-- Titik tunggal yang berkedip smooth di tempat -->
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse" />
          </span>
          <span class="text-xs font-medium text-[hsl(var(--foreground)/0.65)]">
            Online
          </span>
        </div>

        <SocialLinks />
      </div>
    </div>
  )
}


