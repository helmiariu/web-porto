---
// @components/ui/CardGauge.astro

interface Props {
    title: string;
}
const { title } = Astro.props;
---

<div
    class="bg-[#1a1d20] border border-[#2a2d30] p-4 rounded-xl shadow-lg flex flex-col items-center"
>
    <h3
        class="text-gray-400 font-semibold mb-2 text-sm uppercase tracking-wider"
    >
        {title}
    </h3>
    <slot />
</div>
