---
// src/components/ui/CardBlog.astro
import { ClockIcon, Calendar } from "lucide-react";

// Mengambil data post lewat Astro.props
const { post } = Astro.props;

if (!post || !post.data) {
  console.warn("⚠️ Peringatan: Data 'post' tidak valid!");
}

const {
  title = "Untitled Post",
  description = "No description available.",
  category = "General",
  image = "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=150",
  readTime = "5 min read",
  pubDate = new Date(),
} = post?.data || {};

const formattedDate = new Date(pubDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

{
  post && post.data && (
    /* 100% Menggunakan Base Style Komponen <Card> Asli Shadcn */
    <div class="w-full flex flex-col overflow-hidden rounded-lg border bg-card text-card-foreground shadow-xs py-0 sm:flex-row sm:items-center border-none shadow-none">
      {/* --- WADAH GAMBAR --- */}
      <div class="relative aspect-video shrink-0 grow overflow-hidden rounded-lg sm:aspect-square sm:w-56">
        <img
          alt={title}
          class="absolute inset-0 h-full w-full object-cover"
          src={image}
          loading="lazy"
        />

        {/* BADGE KHUSUS HP (Menggunakan Base Style & Ukuran Eksak Shadcn Badge) */}
        <span class="absolute top-3 left-3 sm:hidden inline-flex items-center rounded-md border border-transparent bg-background/90 dark:bg-background/80 text-foreground backdrop-blur-xs text-[10px] font-semibold px-2.5 py-0.5 transition-colors focus:outline-hidden focus:ring-2 focus:ring-ring focus:ring-offset-2">
          {category}
        </span>
      </div>

      {/* --- WADAH KONTEN TEKS --- */}
      {/* 100% Menggunakan Base Style Komponen <CardContent> Asli Shadcn */}
      <div class="w-full flex flex-col p-6 px-4 sm:px-0 pt-3 sm:pt-0 pb-1 sm:p-0 sm:pl-6">
        {/* BADGE KHUSUS LAPTOP/DESKTOP (Menggunakan Base Style & Ukuran Eksak Shadcn Badge) */}
        <div class="hidden sm:flex items-center gap-6">
          <span class="inline-flex items-center rounded-md border border-transparent bg-primary/5 text-primary text-[10px] sm:text-xs font-semibold px-2.5 py-0.5 transition-colors focus:outline-hidden focus:ring-2 focus:ring-ring focus:ring-offset-2">
            {category}
          </span>
        </div>

        {/* OPTIMASI JUDUL ARTIKEL */}
        <h3 class="-mt-2 sm:mt-0 sm:mt-2 lg:mt-2 xl:mt-4 font-semibold tracking-tight leading-snug text-foreground text-lg lg:text-xl xl:text-[1.5rem]">
          {title}
        </h3>

        {/* OPTIMASI DESKRIPSI ARTIKEL */}
        <p class="mt-2 lg:mt-1.5 text-muted-foreground leading-relaxed text-sm xl:text-base line-clamp-2 xl:line-clamp-3 text-ellipsis">
          {description}
        </p>

        {/* OPTIMASI METADATA (WAKTU & TANGGAL) */}
        <div class="pb-3 mt-3 lg:mt-3 xl:mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 font-medium text-muted-foreground text-xs xl:text-sm">
          <div class="flex items-center gap-1.5">
            <ClockIcon class="h-3.5 w-3.5 shrink-0" size={14} />
            {readTime}
          </div>
          <div class="flex items-center gap-1.5">
            <Calendar class="h-3.5 w-3.5 shrink-0" size={14} />
            {formattedDate}
          </div>
        </div>
      </div>
    </div>
  )
}
