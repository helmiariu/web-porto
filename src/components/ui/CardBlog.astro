---
// CardBlog.astro
export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  image?: string;
  layout?: "grid" | "list"; // BEST PRACTICE: Kontrol layout diserahkan ke Parent
  featured?: boolean; // Fokus untuk styling/penanda artikel utama
}

const {
  title,
  description,
  pubDate,
  slug,
  image,
  layout = "grid", // Default berbentuk kotak/vertikal agar aman di dalam grid
  featured = false,
} = Astro.props;

const fallbackImage =
  "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1471&q=80";

const isList = layout === "list";
---

<a
  href={`/blog/${slug}`}
  class:list={[
    "bg-muted/30 group flex w-full h-full rounded-xl border border-solid bg-background text-foreground shadow-xs overflow-hidden transition-all duration-300",
    // Efek hover & penanda jika artikel ini featured
    featured
      ? "border-primary/50 shadow-md bg-primary/[0.02]"
      : "border-border/60 hover:border-primary/40 hover:bg-muted/20",
    // Pengkondisian layout berdasarkan prop `layout`
    isList ? "flex-col sm:flex-row items-stretch" : "flex-col",
  ]}
>
  <div
    class:list={[
      "relative m-0 shrink-0 overflow-hidden bg-muted aspect-[16/10]",
      // Jika mode list, gambar memanjang di kiri saat layar sm ke atas. Jika grid, penuhi lebar atas.
      isList ? "w-full sm:w-48 md:w-56" : "w-full",
    ]}
  >
    {
      featured && (
        <span class="absolute top-3 left-3 z-10 bg-primary text-primary-content text-[10px] font-extrabold uppercase tracking-wider px-2 py-1 rounded-md shadow-sm">
          Featured
        </span>
      )
    }
    <img
      src={image || fallbackImage}
      alt={title}
      class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
    />
  </div>

  <div class="flex flex-col justify-between flex-1 p-4 sm:p-5 gap-3">
    <div class="flex flex-col justify-center flex-1 gap-2">
      <h3
        class="font-bold tracking-tight text-foreground group-hover:text-primary transition-colors line-clamp-2 text-base md:text-lg leading-snug"
      >
        {title}
      </h3>

      <p
        class="text-[hsl(var(--foreground)/0.7)] leading-relaxed text-xs sm:text-sm line-clamp-2"
      >
        {description}
      </p>
    </div>

    <div
      class="flex items-center justify-between pt-3 border-t border-border/40 w-full mt-auto"
    >
      <div
        class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase text-primary tracking-wider"
      >
        Read More
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          stroke="currentColor"
          class="h-3 w-3 transform group-hover:translate-x-1 transition-transform duration-200"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"></path>
        </svg>
      </div>

      <time
        datetime={pubDate.toISOString()}
        class="text-[11px] text-muted-foreground/80 font-medium"
      >
        {
          pubDate.toLocaleDateString("id-ID", {
            year: "numeric",
            month: "short",
            day: "numeric",
          })
        }
      </time>
    </div>
  </div>
</a>
