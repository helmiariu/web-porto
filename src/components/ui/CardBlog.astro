---
// CardBlog.astro
export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  image?: string;
  featured?: boolean; // Cukup gunakan true/false untuk membedakan kartu utama
}

const {
  title,
  description,
  pubDate,
  slug,
  image,
  featured = false, // Default-nya adalah kartu biasa (bukan utama)
} = Astro.props;

const fallbackImage =
  "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1471&q=80";
---

<a
  href={`/blog/${slug}`}
  class:list={[
    "bg-muted/30 group flex w-full h-full rounded-xl border border-solid border-border/60 bg-background text-foreground shadow-xs overflow-hidden hover:border-primary/40 hover:bg-muted/20 transition-all duration-300",
    // Jika kartu utama (featured) = vertikal murni. Jika kartu biasa = vertikal di mobile, horizontal di laptop (lg)
    featured ? "flex-col" : "flex-col lg:flex-row items-stretch",
  ]}
>
  <div
    class:list={[
      "relative m-0 shrink-0 overflow-hidden bg-muted aspect-[16/10]",
      // Ukuran gambar otomatis proporsional tanpa ternary teks yang panjang
      featured ? "w-full" : "w-full lg:w-48 xl:w-56",
    ]}
  >
    <img
      src={image || fallbackImage}
      alt={title}
      class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
    />
  </div>

  <div class="flex flex-col justify-between flex-1 p-4 sm:p-5 gap-3">
    <div class="flex flex-col justify-center flex-1 gap-2">
      <h3
        class="font-bold tracking-tight text-foreground group-hover:text-primary transition-colors line-clamp-2 text-base md:text-lg leading-snug"
      >
        {title}
      </h3>

      <p
        class="text-muted-foreground leading-relaxed text-xs sm:text-sm line-clamp-2"
      >
        {description}
      </p>
    </div>

    <div
      class="flex items-center justify-between pt-3 border-t border-border/40 w-full mt-auto"
    >
      <div
        class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase text-primary tracking-wider"
      >
        Read More
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          stroke="currentColor"
          class="h-3 w-3 transform group-hover:translate-x-1 transition-transform duration-200"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"></path>
        </svg>
      </div>

      <time
        datetime={pubDate.toISOString()}
        class="text-[11px] text-muted-foreground/80 font-medium"
      >
        {
          pubDate.toLocaleDateString("id-ID", {
            year: "numeric",
            month: "short",
            day: "numeric",
          })
        }
      </time>
    </div>
  </div>
</a>
