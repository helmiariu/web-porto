---
// CardBlog.astro
export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  image?: string;
  layout?: "grid" | "list";
  featured?: boolean;
  isCompact?: boolean;
}

const {
  title,
  description,
  pubDate,
  slug,
  image,
  layout = "grid",
  featured = false,
  isCompact = false,
} = Astro.props;

const fallbackImage =
  "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1471&q=80";

const isList = layout === "list";
---

<a
  href={`/blog/${slug}`}
  class:list={[
    "bg-muted/30 group flex w-full h-full rounded-xl border border-solid bg-background text-foreground shadow-xs overflow-hidden transition-all duration-300 hover:-translate-y-0.5",
    featured
      ? "border-border/60 hover:border-primary/30 hover:bg-muted/10"
      : "border-border/60 hover:border-primary/30 hover:bg-muted/10",
    isList ? "flex-col sm:flex-row items-stretch" : "flex-col",
  ]}
>
  <div
    class:list={[
      "relative m-0 shrink-0 overflow-hidden bg-muted",
      "aspect-[3/2]",
      isList
        ? isCompact
          ? "w-full sm:w-36 md:w-40 lg:w-44 sm:h-auto"
          : "w-full sm:w-48 md:w-56 sm:h-auto"
        : "w-full",
    ]}
  >
    {
      featured && (
        <span class="absolute top-3 left-3 z-10 bg-primary text-background text-[10px] font-extrabold uppercase tracking-wider px-2 py-1 rounded-md shadow-xs">
          Featured
        </span>
      )
    }
    <img
      src={image || fallbackImage}
      alt={title}
      class="h-full w-full object-cover group-hover:scale-103 transition-transform duration-500 ease-out"
      loading={featured ? "eager" : "lazy"}
    />
  </div>

  <div
    class:list={[
      "flex flex-col justify-between flex-1 gap-4",
      isCompact ? "p-4 sm:p-4 lg:p-3.5 lg:gap-2" : "p-4 sm:p-5",
    ]}
  >
    <div class="flex flex-col justify-center flex-1 gap-1.5">
      <h3
        class:list={[
          "font-bold tracking-tight text-foreground group-hover:text-primary transition-colors leading-snug",
          featured ? "text-lg md:text-xl" : "text-base md:text-lg",
          isCompact && "lg:text-base",
        ]}
      >
        <span class="line-clamp-2">{title}</span>
      </h3>

      <p
        class:list={[
          "text-xs sm:text-sm text-[hsl(var(--foreground)/0.7)] leading-relaxed text-primary lg:opacity-80",
          isCompact
            ? "line-clamp-2 lg:line-clamp-2 lg:text-xs"
            : "line-clamp-2 md:line-clamp-3",
        ]}
      >
        {description}
      </p>
    </div>

    <div
      class:list={[
        "flex items-center justify-between border-t border-border/40 w-full mt-auto pt-3",
        isCompact && "lg:pt-2",
      ]}
    >
      <div
        class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase text-primary lg:opacity-80 lg:group-hover:opacity-100 pl-1 pt-2 border-t border-solid border-border/40"
      >
        Read More
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          stroke="currentColor"
          class="h-3 w-3 transform group-hover:translate-x-1 transition-transform duration-200"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"></path>
        </svg>
      </div>

      <time
        datetime={pubDate.toISOString()}
        class="text-[11px] text-muted-foreground/70 font-medium"
      >
        {
          pubDate.toLocaleDateString("id-ID", {
            year: "numeric",
            month: "short",
            day: "numeric",
          })
        }
      </time>
    </div>
  </div>
</a>
