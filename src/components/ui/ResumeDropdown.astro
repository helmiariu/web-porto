---
// src/components/ResumeDropdown.astro
import { ChevronDown, Download } from "@lucide/astro";
import { buttonVariants } from "@components/components/ui/button";
---

<details class="relative inline-block text-left group" id="resume-dropdown">
    <!-- Trigger menggunakan tag <summary> yang bergaya tombol outline/secondary Shadcn -->
    <summary
        class={buttonVariants({ variant: "secondary", size: "default" }) +
            " gap-2 rounded-xl border border-border list-none cursor-pointer select-none [&::-webkit-details-marker]:hidden"}
    >
        <span>Resume</span>
        <ChevronDown
            class="h-4 w-4 shrink-0 transition-transform duration-200 group-open:rotate-180"
        />
    </summary>

    <!-- Konten Dropdown Menu khas Shadcn -->
    <div
        class="absolute left-0 mt-2 w-36 origin-top rounded-xl border border-border bg-background p-1.5 text-foreground shadow-md z-50 animate-in fade-in slide-in-from-top-1"
    >
        <a
            href="/resume-en.pdf"
            download
            class="group/item flex w-full items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground transition-colors cursor-pointer"
        >
            <span>English</span>
            <Download
                class="h-4 w-4 transition-transform group-hover/item:translate-y-[1px]"
            />
        </a>

        <a
            href="/resume-id.pdf"
            download
            class="group/item flex w-full items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground transition-colors cursor-pointer"
        >
            <span>Indonesia</span>
            <Download
                class="h-4 w-4 transition-transform group-hover/item:translate-y-[1px]"
            />
        </a>
    </div>
</details>

<script>
    // Opsional: Hanya jika ingin menu menutup otomatis saat pengguna mengeklik area luar web
    document.addEventListener("click", (e) => {
        const dropdown = document.getElementById(
            "resume-dropdown",
        ) as HTMLDetailsElement;
        if (dropdown && !dropdown.contains(e.target as Node)) {
            dropdown.removeAttribute("open");
        }
    });
</script>
