---
export interface Props {
  title: string;
  description: string;
  image?: string;
  tags: string[];
  slug: string;
  featured?: boolean;
}

const { title, description, image, tags, slug, featured } = Astro.props;
---

<a
  href={`/project/${slug}`}
  class="group flex flex-col w-full rounded-xl border border-transparent bg-background text-foreground shadow-xs overflow-hidden hover:border-[hsl(var(--border))] hover:bg-[hsl(var(--secondary))] transition-all duration-200"
>
  <div
    class="relative m-0 w-full shrink-0 overflow-hidden bg-muted aspect-video rounded-t-xl"
  >
    {
      image ? (
        <img
          src={image}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <img
          src="/no-image.jpg"
          alt="No image"
          class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
          onerror="this.src='data:image/svg+xml;base64,'"
        />
      )
    }
  </div>

  <div class="p-5 flex flex-col justify-between flex-1 gap-3">
    <div class="flex flex-col gap-2">
      <div class="flex items-center justify-between gap-2">
        <h3
          class="text-base font-bold tracking-tight text-[hsl(var(--foreground))] group-hover:text-[hsl(var(--primary))] transition-colors line-clamp-1"
        >
          {title}
        </h3>
        {
          featured && (
            <span class="shrink-0 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-medium text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              Featured
            </span>
          )
        }
      </div>

      <p
        class="text-xs text-[hsl(var(--foreground)/0.7)] line-clamp-2 leading-relaxed"
      >
        {description}
      </p>

      <div class="mt-1 flex flex-wrap gap-1.5">
        {
          tags.slice(0, 3).map(
            (
              tag, // Membatasi max 3 tag agar card tetap rapi di grid
            ) => (
              <span class="rounded-md bg-muted/60 px-2 py-0.5 text-[10px] font-medium text-[hsl(var(--foreground)/0.8)] border border-[hsl(var(--border))]">
                {tag}
              </span>
            ),
          )
        }
        {
          tags.length > 3 && (
            <span class="text-[10px] text-[hsl(var(--foreground)/0.5)] self-center ml-0.5">
              +{tags.length - 3} more
            </span>
          )
        }
      </div>
    </div>

    <div
      class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase text-[hsl(var(--primary))] opacity-80 group-hover:opacity-100 pt-2 mt-auto border-t border-[hsl(var(--border))/40]"
    >
      View Project
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        class="h-3 w-3 transform group-hover:translate-x-1 transition-transform"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"></path>
      </svg>
    </div>
  </div>
</a>
