---
export interface Props {
  title: string;
  description: string;
  image?: string;
  tags: string[];
  slug: string;
  featured?: boolean;
}

const { title, description, image, tags, slug, featured } = Astro.props;
---

<a
  href={`/project/${slug}`}
  class="bg-muted/30 group flex flex-col w-full h-full rounded-xl border border-solid border-border/60 bg-background text-foreground shadow-xs overflow-hidden hover:border-primary/40 hover:bg-muted/20 transition-all duration-300"
>
  <div
    class="relative m-0 w-full shrink-0 overflow-hidden bg-muted aspect-video rounded-t-xl"
  >
    {
      featured && (
        <span class="absolute top-3 left-3 z-10 rounded-full bg-emerald-600 px-2.5 py-0.5 text-[10px] font-semibold text-white dark:bg-emerald-500/20 dark:text-emerald-400 border border-emerald-500/20 shadow-xs backdrop-blur-md">
          Featured
        </span>
      )
    }
    {
      image ? (
        <img
          src={image}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <img
          src="/no-image.jpg"
          alt="No image"
          class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
        />
      )
    }
  </div>

  <div class="p-5 flex flex-col flex-1 gap-4 overflow-hidden">
    <div class="flex flex-col gap-2.5 flex-1 overflow-hidden" data-card-body>
      <h3
        class="font-bold tracking-tight text-foreground group-hover:text-primary transition-colors line-clamp-2 text-base md:text-lg leading-snug"
      >
        {title}
      </h3>

      <p
        data-card-desc
        class="text-xs sm:text-sm text-[hsl(var(--foreground)/0.7)] leading-relaxed line-clamp-4"
      >
        {description}
      </p>
    </div>

    <div class="flex flex-col gap-3 mt-auto">
      <div
        class="flex flex-wrap gap-1.5 max-h-[46px] overflow-hidden relative"
        data-card-tags
      >
        {
          tags.map((tag) => (
            <span
              data-tag
              class="rounded-md bg-muted/60 px-2 py-0.5 text-[10px] font-medium text-[hsl(var(--foreground)/0.8)] border border-border/60 whitespace-nowrap"
            >
              {tag}
            </span>
          ))
        }
        <span
          data-more
          class="hidden rounded-md bg-muted/60 px-2 py-0.5 text-[10px] font-medium text-[hsl(var(--foreground)/0.8)] border border-border/60 whitespace-nowrap shadow-xs"
        >
          +<span data-more-count>0</span> more
        </span>
      </div>

      <div
        class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase text-primary lg:opacity-80 lg:group-hover:opacity-100 pt-2 border-t border-solid border-border/40"
      >
        View Project
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          stroke="currentColor"
          class="h-3 w-3 transform group-hover:translate-x-1 transition-transform"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"></path>
        </svg>
      </div>
    </div>
  </div>
</a>

<script>
  const obOptions = {
    root: null,
    rootMargin: "60px",
    threshold: 0,
  };

  const observer = new IntersectionObserver((entries, self) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;

      const container = entry.target as HTMLElement;
      const cardContent = container.closest(".p-5") as HTMLElement;

      if (!cardContent) return;

      const cardBody = cardContent.querySelector(
        "[data-card-body]",
      ) as HTMLElement;
      const descEl = cardContent.querySelector(
        "[data-card-desc]",
      ) as HTMLElement;
      const tags = container.querySelectorAll("[data-tag]");
      const moreBadge = container.querySelector("[data-more]") as HTMLElement;
      const moreCount = container.querySelector("[data-more-count]");

      // OPTIMASI: Bungkus dalam requestAnimationFrame agar dieksekusi di frame berikutnya yang lega
      requestAnimationFrame(() => {
        // ==========================================
        // 1. KONTROL DESCRIPTION (Binary Search)
        // ==========================================
        if (cardBody && descEl) {
          const titleEl = cardBody.querySelector("h3") as HTMLElement;

          if (titleEl) {
            const titleComputed = window.getComputedStyle(titleEl);
            const titleLineHeight = parseFloat(titleComputed.lineHeight) || 24;
            const titleLines = Math.round(
              titleEl.clientHeight / titleLineHeight,
            );
            descEl.style.webkitLineClamp = titleLines >= 2 ? "2" : "3";
          }

          if (
            cardBody.scrollHeight - cardBody.clientHeight > 1 ||
            descEl.scrollHeight - descEl.clientHeight > 1
          ) {
            let words = descEl.textContent.trim().split(/\s+/);
            let left = 0;
            let right = words.length;
            let bestFit = 0;

            while (left <= right) {
              let mid = Math.floor((left + right) / 2);
              descEl.textContent = words.slice(0, mid).join(" ") + "...";

              if (
                cardBody.scrollHeight - cardBody.clientHeight <= 1 &&
                descEl.scrollHeight - descEl.clientHeight <= 1
              ) {
                bestFit = mid;
                left = mid + 1;
              } else {
                right = mid - 1;
              }
            }
            descEl.textContent = words.slice(0, bestFit).join(" ") + "...";
          }
        }

        // ==========================================
        // 2. KONTROL TAGS (Hybrid Batching)
        // ==========================================
        if (tags.length) {
          const maxContentHeight = 46;
          const tagElements = Array.from(tags) as HTMLElement[];

          tagElements.forEach((t) => (t.style.display = "inline-block"));
          if (moreBadge) moreBadge.style.display = "none";

          let firstOverflowIndex = -1;
          for (let i = 0; i < tagElements.length; i++) {
            if (
              tagElements[i].offsetTop + tagElements[i].offsetHeight >
              maxContentHeight
            ) {
              firstOverflowIndex = i;
              break;
            }
          }

          if (firstOverflowIndex !== -1 && moreBadge && moreCount) {
            for (let i = firstOverflowIndex; i < tagElements.length; i++) {
              tagElements[i].style.display = "none";
            }

            moreBadge.style.display = "inline-block";

            let lastVisibleIndex = firstOverflowIndex - 1;
            while (
              lastVisibleIndex >= 0 &&
              moreBadge.offsetTop + moreBadge.offsetHeight > maxContentHeight
            ) {
              tagElements[lastVisibleIndex].style.display = "none";
              lastVisibleIndex--;
            }

            const totalHidden = tagElements.length - (lastVisibleIndex + 1);
            moreCount.textContent = totalHidden.toString();
          }
        }
      });

      // Tetap unobserve setelah dijadwalkan agar tidak berjalan berulang kali
      self.unobserve(container);
    });
  }, obOptions);

  function initTagsObserver() {
    const containers = document.querySelectorAll("[data-card-tags]");
    containers.forEach((c) => observer.observe(c));
  }

  initTagsObserver();
  document.addEventListener("astro:page-load", initTagsObserver);
</script>
