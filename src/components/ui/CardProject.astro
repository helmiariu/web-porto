---
export interface Props {
  title: string;
  description: string;
  image?: string;
  tags: string[];
  slug: string;
  featured?: boolean;
}

const { title, description, image, tags, slug, featured } = Astro.props;
---

<a
  href={`/project/${slug}`}
  class="bg-muted/30 group flex flex-col w-full h-full rounded-xl border border-solid border-border/60 bg-background text-foreground shadow-xs overflow-hidden hover:border-primary/40 hover:bg-muted/20 transition-all duration-300"
>
  <!-- Image Container dengan Badge Absolute -->
  <div
    class="relative m-0 w-full shrink-0 overflow-hidden bg-muted aspect-video rounded-t-xl"
  >
    {
      featured && (
        <span class="absolute top-3 left-3 z-10 rounded-full bg-emerald-600 px-2.5 py-0.5 text-[10px] font-semibold text-white dark:bg-emerald-500/20 dark:text-emerald-400 border border-emerald-500/20 shadow-xs backdrop-blur-md">
          Featured
        </span>
      )
    }
    {
      image ? (
        <img
          src={image}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <img
          src="/no-image.jpg"
          alt="No image"
          class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
        />
      )
    }
  </div>

  <!-- Content Container -->
  <div class="p-5 flex flex-col justify-between flex-1 gap-4">
    <div class="flex flex-col gap-2.5">
      <!-- Judul -->
      <h3
        class="text-lg font-bold tracking-tight text-[hsl(var(--foreground))] group-hover:text-primary transition-colors line-clamp-2 leading-snug"
      >
        {title}
      </h3>

      <!-- Deskripsi -->
      <p
        class="text-sm text-[hsl(var(--foreground)/0.7)] line-clamp-2 leading-relaxed"
      >
        {description}
      </p>

      <!-- Tags Area -->
      <div class="mt-1 flex flex-wrap gap-1.5">
        {
          tags
            .slice(0, 3)
            .map((tag) => (
              <span class="rounded-md bg-muted/60 px-2 py-0.5 text-[10px] font-medium text-[hsl(var(--foreground)/0.8)] border border-border/60">
                {tag}
              </span>
            ))
        }
        {
          tags.length > 3 && (
            <span class="text-[10px] text-[hsl(var(--foreground)/0.5)] self-center ml-0.5">
              +{tags.length - 3} more
            </span>
          )
        }
      </div>
    </div>

    <!-- Footer Card (Border disesuaikan agar solid & senada) -->
    <div
      class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase text-primary opacity-80 group-hover:opacity-100 pt-2 mt-auto border-t border-solid border-border/40"
    >
      View Project
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        class="h-3 w-3 transform group-hover:translate-x-1 transition-transform"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"></path>
      </svg>
    </div>
  </div>
</a>
