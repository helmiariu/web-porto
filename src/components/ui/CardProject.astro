---
export interface Props {
  title: string;
  description: string;
  image?: string;
  tags: string[];
  slug: string;
  featured?: boolean;
}

const { title, description, image, tags, slug, featured } = Astro.props;
---

<a
  href={`/project/${slug}`}
  class="bg-muted/30 group flex flex-col w-full h-full rounded-xl border border-solid border-border/60 bg-background text-foreground shadow-xs overflow-hidden hover:border-primary/40 hover:bg-muted/20 transition-all duration-300 project-card-item hover:-translate-y-0.5"
>
  <div
    class="relative m-0 w-full shrink-0 overflow-hidden bg-muted aspect-video rounded-t-xl"
  >
    {
      featured && (
        <span class="absolute top-3 left-3 z-10 rounded-full bg-emerald-600 px-2.5 py-0.5 text-[10px] font-semibold text-white dark:bg-emerald-500/20 dark:text-emerald-400 border border-emerald-500/20 shadow-xs backdrop-blur-md">
          Featured
        </span>
      )
    }
    {
      image ? (
        <img
          src={image}
          alt={title}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <img
          src="/no-image.jpg"
          alt="No image"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
        />
      )
    }
  </div>

  <div class="p-5 flex flex-col flex-1 gap-4 overflow-hidden">
    <div class="flex flex-col gap-2.5 flex-1 overflow-hidden" data-card-body>
      <h3
        data-card-title
        class="font-bold tracking-tight text-foreground group-hover:text-primary transition-colors line-clamp-2 text-base md:text-lg leading-snug"
      >
        {title}
      </h3>

      <p
        data-card-desc
        class="text-xs sm:text-sm text-[hsl(var(--foreground)/0.7)] leading-relaxed text-primary lg:opacity-80 line-clamp-3"
      >
        {description}
      </p>
    </div>

    <div class="flex flex-col gap-3 mt-auto">
      <div
        class="flex flex-wrap gap-1.5 max-h-[46px] overflow-hidden relative"
        data-card-tags
      >
        {
          tags.map((tag) => (
            <span
              data-tag
              class="rounded-md bg-muted/60 px-2 py-0.5 text-[10px] font-medium text-[hsl(var(--foreground)/0.8)] border border-border whitespace-nowrap"
            >
              {tag}
            </span>
          ))
        }
        <span
          data-more
          class="hidden rounded-md bg-muted/60 px-2 py-0.5 text-[10px] font-medium text-[hsl(var(--foreground)/0.8)] border border-border/60 whitespace-nowrap shadow-xs"
        >
          +<span data-more-count>0</span> more
        </span>
      </div>

      <div
        class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase text-primary lg:opacity-80 lg:group-hover:opacity-100 pl-1 pt-2 border-t border-solid border-border/40"
      >
        View Project
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          stroke="currentColor"
          class="h-3 w-3 transform group-hover:translate-x-1 transition-transform"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"></path>
        </svg>
      </div>
    </div>
  </div>
</a>

<script>
  let resizeTimeout: number;

  function tuneAllCards() {
    const cards = document.querySelectorAll(".project-card-item");
    if (cards.length === 0) return;

    // Array untuk menyimpan hasil pengukuran (Fase Membaca / Read Phase)
    const measurements: any[] = [];

    // FASE 1: BACA DOM (Semua operasi baca dikelompokkan di sini untuk menghindari reflow berulang)
    cards.forEach((card) => {
      const titleEl = card.querySelector("[data-card-title]") as HTMLElement;
      const descEl = card.querySelector("[data-card-desc]") as HTMLElement;
      const tagsContainer = card.querySelector(
        "[data-card-tags]",
      ) as HTMLElement;
      const tags = card.querySelectorAll(
        "[data-tag]",
      ) as NodeListOf<HTMLElement>;
      const moreBadge = card.querySelector("[data-more]") as HTMLElement;

      if (!titleEl || !descEl) return;

      // 1. Tentukan jumlah baris judul berdasarkan tingginya
      const titleHeight = titleEl.clientHeight;
      const isMultiLineTitle = titleHeight > 28; // Lebih dari 28px biasanya berarti > 1 baris

      // 2. Deteksi indeks tag pertama yang meluap (overflow)
      let firstOverflowIndex = -1;
      const maxContentHeight = 46;

      if (tagsContainer && tags.length > 0) {
        for (let i = 0; i < tags.length; i++) {
          // offsetTop diukur relatif terhadap kontainer
          if (tags[i].offsetTop + tags[i].offsetHeight > maxContentHeight) {
            firstOverflowIndex = i;
            break;
          }
        }
      }

      measurements.push({
        descEl,
        isMultiLineTitle,
        tags,
        moreBadge,
        firstOverflowIndex,
        totalTags: tags.length,
      });
    });

    // FASE 2: TULIS DOM (Browser hanya melakukan 1 kali render ulang)
    requestAnimationFrame(() => {
      measurements.forEach((m) => {
        // 1. Sesuaikan line clamp deskripsi secara instan menggunakan class
        if (m.isMultiLineTitle) {
          m.descEl.classList.replace("line-clamp-3", "line-clamp-2");
        } else {
          m.descEl.classList.replace("line-clamp-2", "line-clamp-3");
        }

        // 2. Atur visibilitas tag & badge "+X more" jika terjadi luapan
        if (m.firstOverflowIndex !== -1 && m.moreBadge) {
          // Sembunyikan tag yang meluap
          for (let i = 0; i < m.totalTags; i++) {
            if (i >= m.firstOverflowIndex) {
              m.tags[i].style.display = "none";
            } else {
              m.tags[i].style.display = "inline-block";
            }
          }

          // Tampilkan badge "+X more"
          m.moreBadge.style.display = "inline-block";
          const moreCountEl = m.moreBadge.querySelector("[data-more-count]");
          if (moreCountEl) {
            const hiddenCount = m.totalTags - m.firstOverflowIndex;
            moreCountEl.textContent = hiddenCount.toString();
          }

          // Kalibrasi pengaman: jika badge "+X more" sendiri ternyata meluap, sembunyikan tag sebelumnya satu per satu
          let lastVisibleIndex = m.firstOverflowIndex - 1;
          while (
            lastVisibleIndex >= 0 &&
            m.moreBadge.offsetTop + m.moreBadge.offsetHeight > 46
          ) {
            m.tags[lastVisibleIndex].style.display = "none";
            lastVisibleIndex--;
            if (moreCountEl) {
              moreCountEl.textContent = (
                m.totalTags -
                (lastVisibleIndex + 1)
              ).toString();
            }
          }
        } else {
          // Jika tidak ada luapan, pastikan semua tag tampil
          m.tags.forEach((t: HTMLElement) => {
            t.style.display = "inline-block";
          });
          if (m.moreBadge) {
            m.moreBadge.style.display = "none";
          }
        }
      });
    });
  }

  // Jalankan optimasi saat pertama kali dimuat
  tuneAllCards();

  // Jalankan saat View Transitions selesai memuat halaman baru
  document.addEventListener("astro:page-load", tuneAllCards);

  // Gunakan debounce pada event resize agar tidak menembak fungsi ratusan kali per detik
  window.addEventListener("resize", () => {
    cancelAnimationFrame(resizeTimeout);
    resizeTimeout = requestAnimationFrame(tuneAllCards);
  });
</script>
