<!-- src/components/TopProgressBar.astro -->
<div
    id="top-progress-bar"
    class="fixed top-0 left-0 z-9999 h-[3px] w-0 bg-primary opacity-0 pointer-events-none shadow-[0_0_10px_rgba(var(--primary),0.5)] transition-[width,opacity] duration-300 ease-out"
>
</div>

<script>
    let progressInterval: Astro.NodeJS.Timeout | number;
    let currentProgress = 0;

    // 1. Saat SEBELUM pindah halaman (Halaman Lama)
    document.addEventListener("astro:before-preparation", () => {
        const progressBar = document.getElementById("top-progress-bar");
        if (!progressBar) return;

        // MATIKAN transisi & Sembunyikan dulu agar tidak ada efek mundur ke kiri
        progressBar.style.transition = "none";
        progressBar.style.opacity = "0";
        progressBar.style.width = "0%";

        // Paksa browser menerapkan reset di atas secara instan (hack reflow)
        void progressBar.offsetWidth;

        clearInterval(progressInterval);
        currentProgress = 0;

        // Sekarang jalankan animasi maju ke 30%
        progressBar.style.transition = "width 0.4s ease-out, opacity 0.2s ease";
        progressBar.style.opacity = "1";
        currentProgress = 30;
        progressBar.style.width = `${currentProgress}%`;

        // Efek merangkak pelan (Trickle)
        progressInterval = setInterval(() => {
            if (currentProgress < 80) {
                currentProgress += Math.random() * 3 + 1;
                progressBar.style.transition = "width 0.3s ease";
                progressBar.style.width = `${currentProgress}%`;
            }
        }, 250);

        // Catat progress terakhir tepat sebelum halaman di-swap
        document.addEventListener(
            "astro:before-swap",
            () => {
                clearInterval(progressInterval);
                sessionStorage.setItem(
                    "last-progress",
                    currentProgress.toString(),
                );
            },
            { once: true },
        );
    });

    // 2. Saat SETELAH berhasil pindah halaman (Halaman Baru)
    document.addEventListener("astro:after-swap", () => {
        const progressBar = document.getElementById("top-progress-bar");
        const lastProgress = sessionStorage.getItem("last-progress");

        if (!progressBar || !lastProgress) return;

        // Pasang posisi terakhir secara instan tanpa animasi agar tidak berkedip
        progressBar.style.transition = "none";
        progressBar.style.opacity = "1";
        progressBar.style.width = `${lastProgress}%`;

        // Paksa browser membaca style (reflow)
        void progressBar.offsetWidth;

        // MELUNCUR MAJU KE KANAN!
        progressBar.style.transition =
            "width 0.25s cubic-bezier(0.4, 0, 0.2, 1)";
        progressBar.style.width = "100%";

        // Setelah menyentuh ujung kanan, pudar hilang
        setTimeout(() => {
            progressBar.style.transition = "opacity 0.2s ease-out";
            progressBar.style.opacity = "0";
        }, 250);

        // Hapus catatan agar bersih
        sessionStorage.removeItem("last-progress");
    });
</script>
