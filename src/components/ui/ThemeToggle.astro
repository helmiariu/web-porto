---
// ThemeToggle.astro
const uniqueId = "theme-switch-" + Math.random().toString(36).substr(2, 9);
---

<div class="space-y-2">
  <p
    class="text-[10px] font-semibold uppercase tracking-[.3em] text-primary lg:text-foreground/70 pl-3"
  >
    THEMING
  </p>

  <div class="space-y-1.5">
    <label
      for={uniqueId}
      class="flex items-center justify-between rounded-xl border border-transparent bg-transparent duration-150 cursor-pointer relative py-[6px] px-[12px] group text-primary lg:text-foreground/70 hover:bg-secondary hover:text-foreground select-none"
    >
      <span class="flex items-center gap-3">
        <span
          class="theme-icon-container flex shrink-0 items-center justify-center w-[26px] h-[26px] text-primary lg:text-foreground/70 group-hover:text-foreground"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="sun-icon w-[15px] h-[15px] block"
            ><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"
            ></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"
            ></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"
            ></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"
            ></path><path d="m19.07 4.93-1.41 1.41"></path></svg
          >

          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="moon-icon w-[15px] h-[15px] hidden"
            ><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
          >
        </span>
        <span class="font-medium text-[14px]">Dark Mode</span>
      </span>

      <div class="relative w-[44px] h-[20px]">
        <input
          id={uniqueId}
          type="checkbox"
          aria-label="Toggle Dark Mode"
          class="theme-switch-input sr-only peer"
        />

        <div
          class="absolute inset-0 bg-input rounded-full
           peer-checked:bg-primary transition-colors duration-200 ease-in-out
           
           after:content-[''] after:absolute after:top-[3px] after:left-[3px]
           after:bg-background after:shadow-sm after:rounded-full after:h-[14px] after:w-[14px]
           after:transition-all after:duration-300 after:ease-[cubic-bezier(0.175,0.885,0.32,1.275)]
           peer-checked:after:translate-x-[24px]"
        >
        </div>

        <span
          class="pointer-events-none absolute right-0 top-0 flex h-full items-center pr-1.5 text-[8px] font-bold tracking-wider text-primary lg:text-muted-foreground transition-opacity duration-150 peer-checked:opacity-0"
        >
          OFF
        </span>

        <span
          class="pointer-events-none absolute left-0 top-0 flex h-full items-center pl-2 text-[8px] font-bold tracking-wider text-primary-foreground opacity-0 transition-opacity duration-150 peer-checked:opacity-100"
        >
          ON
        </span>
      </div>
    </label>
  </div>
</div>

<script is:inline data-astro-rerun>
  (function () {
    try {
      const theme = localStorage.getItem("astro-theme");
      const isDark = theme
        ? theme === "dark"
        : window.matchMedia?.("(prefers-color-scheme: dark)").matches;

      document.querySelectorAll(".theme-switch-input").forEach((el) => {
        el.checked = isDark;
      });

      document
        .querySelectorAll(".theme-icon-container")
        .forEach((container) => {
          const sun = container.querySelector(".sun-icon");
          const moon = container.querySelector(".moon-icon");
          if (isDark) {
            sun?.classList.replace("block", "hidden");
            moon?.classList.replace("hidden", "block");
          } else {
            sun?.classList.replace("hidden", "block");
            moon?.classList.replace("block", "hidden");
          }
        });
    } catch (e) {}
  })();
</script>

<script>
  document.addEventListener("astro:page-load", () => {
    const storageKey = "astro-theme";
    const html = document.documentElement;

    const checkboxes = document.querySelectorAll(
      ".theme-switch-input",
    ) as NodeListOf<HTMLInputElement>;
    const iconContainers = document.querySelectorAll(".theme-icon-container");

    const updateUI = (dark: boolean) => {
      checkboxes.forEach((checkbox) => {
        if (checkbox.checked !== dark) checkbox.checked = dark;
      });

      iconContainers.forEach((container) => {
        const sun = container.querySelector(".sun-icon");
        const moon = container.querySelector(".moon-icon");
        if (dark) {
          sun?.classList.replace("block", "hidden");
          moon?.classList.replace("hidden", "block");
        } else {
          sun?.classList.replace("hidden", "block");
          moon?.classList.replace("block", "hidden");
        }
      });
    };

    const getSavedTheme = () => {
      try {
        return localStorage.getItem(storageKey);
      } catch {
        return null;
      }
    };

    const getPreferredTheme = () =>
      window.matchMedia?.("(prefers-color-scheme: dark)").matches;
    const savedTheme = getSavedTheme();
    const isDark = savedTheme ? savedTheme === "dark" : getPreferredTheme();

    updateUI(isDark);

    checkboxes.forEach((checkbox) => {
      checkbox.addEventListener("change", () => {
        const nextTheme = checkbox.checked;
        html.classList.add("no-transitions");
        html.classList.toggle("dark", nextTheme);
        updateUI(nextTheme);

        try {
          localStorage.setItem(storageKey, nextTheme ? "dark" : "light");
        } catch (e) {}

        setTimeout(() => {
          html.classList.remove("no-transitions");
        }, 50);
      });
    });

    let isObserving = true;
    const observer = new MutationObserver((mutations) => {
      if (!isObserving) return;
      mutations.forEach((mutation) => {
        if (mutation.attributeName === "class") {
          isObserving = false;
          updateUI(html.classList.contains("dark"));
          isObserving = true;
        }
      });
    });
    observer.observe(html, { attributes: true });
  });
</script>
