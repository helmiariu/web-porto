---
// ThemeToggle.astro
// Membuat ID unik untuk setiap instance komponen agar label tidak salah target
const uniqueId = "theme-switch-" + Math.random().toString(36).substr(2, 9);
---

<div class="space-y-2">
  <p
    class="text-[10px] font-semibold uppercase tracking-[0.3em] text-[hsl(var(--foreground)/0.65)] pl-3"
  >
    THEMING
  </p>
  <div class="space-y-1.5">
    <label
      for={uniqueId}
      class="flex items-center justify-between rounded-xl border border-transparent bg-transparent transition-all duration-200 cursor-pointer relative py-[6px] px-[12px] group text-[hsl(var(--foreground)/0.6)] hover:bg-[hsl(var(--secondary))] hover:text-[hsl(var(--foreground))] select-none"
    >
      <span class="flex items-center gap-3">
        <span
          class="theme-icon-container flex shrink-0 items-center justify-center transition-all duration-200 w-[26px] h-[26px] [&>svg]:block [&>svg]:w-[15px] [&>svg]:h-[15px] text-[hsl(var(--foreground)/0.6)] group-hover:text-[hsl(var(--foreground))]"
        >
        </span>
        <span class="font-medium text-[13px]">Dark Mode</span>
      </span>
      <div
        class="relative inline-block w-11 h-5 shrink-0 pointer-events-none"
      >
        <input
          id={uniqueId}
          type="checkbox"
          class="theme-switch-input peer appearance-none w-11 h-5 bg-slate-200 dark:bg-zinc-800 rounded-full checked:bg-slate-800 dark:checked:bg-emerald-500 cursor-pointer transition-colors duration-300"
        />
        <span
          class="absolute top-0 left-0 w-5 h-5 bg-white rounded-full border border-slate-300 dark:border-zinc-700 shadow-sm transition-transform duration-300 peer-checked:translate-x-6 peer-checked:border-slate-800 dark:peer-checked:border-emerald-500 cursor-pointer"
        >
        </span>
        
        <script is:inline data-astro-rerun>
          (function () {
            try {
              const theme = localStorage.getItem("astro-theme");
              const isDark = theme
                ? theme === "dark"
                : window.matchMedia?.("(prefers-color-scheme: dark)").matches;
              
              document.querySelectorAll(".theme-switch-input").forEach(el => {
                el.checked = isDark;
              });
            } catch (e) {
              // ignore
            }
          })();
        </script>
      </div>
    </label>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const storageKey = "astro-theme";
    const html = document.documentElement;
    
    const checkboxes = document.querySelectorAll(".theme-switch-input") as NodeListOf<HTMLInputElement>;
    const icons = document.querySelectorAll(".theme-icon-container");

    const SunIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sun"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>`;
    const MoonIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>`;

    // Dipisah: Fungsi khusus untuk update tampilan tombol & ikon saja
    const updateUI = (dark: boolean) => {
      checkboxes.forEach((checkbox) => {
        checkbox.checked = dark;
      });
      icons.forEach((icon) => {
        icon.innerHTML = dark ? MoonIcon : SunIcon;
      });
    };

    const setTheme = (dark: boolean) => {
      html.classList.toggle("dark", dark);
      updateUI(dark);
    };

    const getSavedTheme = () => {
      try {
        return localStorage.getItem(storageKey);
      } catch {
        return null;
      }
    };

    const getPreferredTheme = () =>
      window.matchMedia?.("(prefers-color-scheme: dark)").matches;
    const savedTheme = getSavedTheme();
    const isDark = savedTheme ? savedTheme === "dark" : getPreferredTheme();

    // Set kondisi awal saat ganti halaman
    setTheme(isDark);

    // Event listener untuk klik tombol switch tema
    checkboxes.forEach((checkbox) => {
      checkbox.addEventListener("change", () => {
        const nextTheme = checkbox.checked;
        try {
          localStorage.setItem(storageKey, nextTheme ? "dark" : "light");
        } catch {
          // ignore
        }
        // Langsung ubah class html, biarkan MutationObserver yang memperbarui UI
        html.classList.toggle("dark", nextTheme);
      });
    });

    // Mengamati perubahan class global secara real-time
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === "class") {
          const isCurrentlyDark = html.classList.contains("dark");
          // Perbarui UI semua tombol secara serentak
          updateUI(isCurrentlyDark);
        }
      });
    });
    observer.observe(html, { attributes: true });
  });
</script>