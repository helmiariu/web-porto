---
// src/pages/3Dgallery/index.astro
import { getImage } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Gallerycard from "@components/components/gallery-card.tsx";

// 1. Ambil GAMBAR SAJA
const allImages = import.meta.glob(
  "/src/assets/3Dgallery/**/*.{jpeg,jpg,png,gif,webp,avif,svg}",
  { eager: true },
);

// 2. AMANKAN FILE 3D: Tambahkan properti query secara eksplisit di dalam opsi!
// Jika terlewat, Vite di server production bisa bingung dan mencoba membaca file .glb sebagai modul JS.
const allModels = import.meta.glob("/src/assets/3Dgallery/**/*.glb", {
  eager: true,
  query: "?url", // 👈 WAJIB DI SINI, bukan cuma di komentar komentar sebelumnya bener, kodenya lupa ditulis hhehe
});

interface AlbumRaw {
  images: any[];
  modelUrl?: string;
  wireframeUrl?: string;
}
const rawAlbumsData: Record<string, AlbumRaw> = {};

// Kelompokkan Gambar 2D (Urutkan secara alfabetis agar urutan slide tidak acak-acakan)
Object.keys(allImages)
  .sort()
  .forEach((path) => {
    const parts = path.split("/3Dgallery/");
    if (parts.length > 1) {
      const albumName = parts[1].split("/")[0];
      if (!rawAlbumsData[albumName]) {
        rawAlbumsData[albumName] = { images: [] };
      }
      rawAlbumsData[albumName].images.push((allImages[path] as any).default);
    }
  });

// Kelompokkan File 3D (.glb)
Object.keys(allModels).forEach((path) => {
  const parts = path.split("/3Dgallery/");
  if (parts.length > 1) {
    const albumName = parts[1].split("/")[0];
    if (!rawAlbumsData[albumName]) {
      rawAlbumsData[albumName] = { images: [] };
    }

    const fileUrl = (allModels[path] as any).default;

    if (path.toLowerCase().includes("wireframe")) {
      rawAlbumsData[albumName].wireframeUrl = fileUrl;
    } else {
      rawAlbumsData[albumName].modelUrl = fileUrl;
    }
  }
});

// 3. Proses Optimasi Gambar & Satukan Data Akhir
const albumList = await Promise.all(
  Object.keys(rawAlbumsData).map(async (name) => {
    const album = rawAlbumsData[name];

    const optimizedImages = await Promise.all(
      album.images.map(async (imgMetadata) => {
        if (imgMetadata.format === "svg") return imgMetadata.src;

        // OPTIMASI VISUAL: Naikkan width ke 1200
        // Jika hanya 600, gambar akan terlihat pecah/blur saat user membuka mode MODAL FULLSCREEN di monitor desktop.
        // Berkat format "webp", ukuran file 1200px akan tetap sangat kecil (kecerahan & ketajaman terjaga).
        const optimized = await getImage({
          src: imgMetadata,
          width: 1200,
          format: "webp",
          quality: "normal",
        });

        return optimized.src;
      }),
    );

    return {
      name: name,
      images: optimizedImages,
      modelUrl: album.modelUrl,
      wireframeUrl: album.wireframeUrl,
    };
  }),
);
---

<Layout>
  <div class="max-w-6xl mx-auto">
    {/* Page Header */}
    <div
      class="sticky top-0 z-30 flex flex-col justify-center bg-background/95 backdrop-blur-md border-b pb-4 pt-4"
    >
      <h2 class="text-xl font-semibold tracking-tight text-foreground">
        3D Gallery
      </h2>
      <p class="text-muted-foreground text-xs sm:text-sm">
        Semua album ter-update secara otomatis
      </p>
    </div>

    <div
      class="flex flex-col gap-10 mb-8 md:mb-0"
    >
      {
        albumList.map((album) => (
          <Gallerycard
            client:visible
            albumName={album.name}
            images={album.images}
            modelUrl={album.modelUrl}
            wireframeUrl={album.wireframeUrl}
          />
        ))
      }
    </div>
  </div>
</Layout>
