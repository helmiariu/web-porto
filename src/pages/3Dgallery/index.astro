---
// src/pages/3Dgallery/index.astro
import Layout from "@layouts/Layout.astro";
import Gallerycard from "@components/components/gallery-card.tsx";
import { getCfEnv, getDB } from "@lib/cloudflare";
import { drizzle } from "drizzle-orm/d1";
import { softwareTools, albumMetadata } from "../../db/schema";

export const prerender = false;

// 1. Inisialisasi Database D1
const rawDb = getDB();
const db = drizzle(rawDb);

let allSoftware: any[] = [];
let allMeta: any[] = [];

try {
  allSoftware = await db.select().from(softwareTools);
  allMeta = await db.select().from(albumMetadata);
} catch (e) {
  console.error("Gagal mengambil data dari database D1:", e);
}

// Buat Map untuk mempercepat pencarian data
const softwareMap = new Map(allSoftware.map((s) => [s.slug, s]));
const metaMap = new Map(allMeta.map((m) => [m.albumSlug, m]));

// 2. Inisialisasi R2 Bucket
const cfEnv = getCfEnv();
const bucket = cfEnv.GALLERY_BUCKET;

interface AlbumData {
  name: string;
  title?: string;
  images: string[];
  modelUrl?: string;
  wireframeUrl?: string;
  softwareTools: any[];
}

const albumsMap: Record<string, AlbumData> = {};

if (bucket) {
  try {
    const response = await bucket.list({ prefix: "assets/3Dgallery/" });
    
    for (const obj of response.objects) {
      const key = obj.key; // Contoh: "assets/3Dgallery/helmet/model.glb"
      const parts = key.split("/");
      
      if (parts.length >= 4) {
        const albumSlug = parts[2]; // "helmet"
        const fileName = parts[3];  // "model.glb"
        
        // Lewati jika file berada langsung di folder root assets/3Dgallery/
        if (!albumSlug) continue;

        if (!albumsMap[albumSlug]) {
          const dbMeta = metaMap.get(albumSlug);
          let tools: any[] = [];
          
          if (dbMeta) {
            try {
              const slugList = JSON.parse(dbMeta.softwareList) as string[];
              tools = slugList
                .map((slug) => softwareMap.get(slug))
                .filter(Boolean);
            } catch (jsonErr) {
              console.error(`Gagal melakukan parse softwareList untuk ${albumSlug}:`, jsonErr);
            }
          }

          albumsMap[albumSlug] = {
            name: albumSlug,
            title: dbMeta?.title,
            images: [],
            softwareTools: tools,
          };
        }

        const fileUrl = `/api/assets/${key}`;

        // Kategorikan File
        if (fileName.endsWith(".glb")) {
          if (fileName.toLowerCase().includes("wireframe")) {
            albumsMap[albumSlug].wireframeUrl = fileUrl;
          } else {
            albumsMap[albumSlug].modelUrl = fileUrl;
          }
        } else if (/\.(jpg|jpeg|png|webp|avif|gif|svg)$/i.test(fileName)) {
          albumsMap[albumSlug].images.push(fileUrl);
        }
      }
    }
  } catch (r2Err) {
    console.error("Gagal melakukan list object R2:", r2Err);
  }
}

const albumList = Object.values(albumsMap);
---

<Layout>
  <div class="max-w-6xl mx-auto">
    {/* Page Header */}
    <div
      class="sticky top-0 z-30 flex flex-col justify-center bg-background/95 backdrop-blur-md border-b pb-4 pt-4 mb-6"
    >
      <h2 class="text-xl font-semibold tracking-tight text-foreground">
        3D Gallery
      </h2>
      <p class="text-muted-foreground text-xs sm:text-sm">
        Semua album ter-update secara otomatis dari Cloudflare R2 & D1
      </p>
    </div>

    <div class="flex flex-col gap-10 mb-8 md:mb-0">
      {
        albumList.length > 0 ? (
          albumList.map((album) => (
            <Gallerycard
              client:load
              albumName={album.name}
              title={album.title}
              images={album.images}
              modelUrl={album.modelUrl}
              wireframeUrl={album.wireframeUrl}
              softwareTools={album.softwareTools}
            />
          ))
        ) : (
          <div class="flex flex-col items-center justify-center p-12 border border-dashed rounded-xl">
            <p class="text-muted-foreground text-sm">Tidak ada album galeri 3D yang ditemukan di R2.</p>
          </div>
        )
      }
    </div>
  </div>
</Layout>
