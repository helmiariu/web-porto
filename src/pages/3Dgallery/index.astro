---
// src/pages/gallery.astro
import { getImage } from "astro:assets"; // <-- 1. Import fungsi optimasi Astro
import Layout from "@layouts/Layout.astro";
import Gallerycard from "@components/components/gallery-card.tsx";

const allImages = import.meta.glob(
  "/src/assets/3Dgallery/**/*.{jpeg,jpg,png,gif,webp,avif,svg}",
  { eager: true },
);

// Tempat menampung data mentah gambar per album
const rawAlbumsData: Record<string, any[]> = {};

Object.keys(allImages).forEach((path) => {
  const parts = path.split("/3Dgallery/");
  if (parts.length > 1) {
    const albumName = parts[1].split("/")[0];
    if (!rawAlbumsData[albumName]) {
      rawAlbumsData[albumName] = [];
    }
    // PENTING: Masukkan metadata objek gambar secara utuh, JANGAN hanya .src nya
    rawAlbumsData[albumName].push((allImages[path] as any).default);
  }
});

// 2. Proses Optimasi Gambar secara paralel menggunakan Promise.all
const albumList = await Promise.all(
  Object.keys(rawAlbumsData).map(async (name) => {
    const optimizedImages = await Promise.all(
      rawAlbumsData[name].map(async (imgMetadata) => {
        // Jika file adalah SVG, lewati optimasi karena SVG adalah vektor
        if (imgMetadata.format === "svg") return imgMetadata.src;

        // Optimasi gambar di sini!
        const optimized = await getImage({
          src: imgMetadata,
          width: 600, // Ukuran lebar maksimal gambar di dalam card (sesuaikan kebutuhan)
          format: "webp", // Otomatis konversi semua gambar jadi WebP yang super ringan
          quality: "normal", // Kualitas kompresi (low, normal, high, max atau angka 1-100)
        });

        return optimized.src; // Mengembalikan URL gambar yang SUDAH DIOPTIMASI
      }),
    );

    return {
      name: name,
      images: optimizedImages,
    };
  }),
);
---

<Layout>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-3xl font-bold text-primary mb-2 text-center">3D Gallery</h1>
    <p class="text-gray-500 text-center mb-10 font-desc">
      Semua album ter-update secara otomatis
    </p>

    <div
      class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 lg:gap-10 xl:gap-6"
    >
      {
        albumList.map((album) => (
          <div class="bg-card px-0 rounded-xl border overflow-hidden flex flex-col justify-start">
            <Gallerycard
              albumName={album.name}
              images={album.images}
              client:visible
            />
          </div>
        ))
      }
    </div>
  </div>
</Layout>
