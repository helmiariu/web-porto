---
import Layout from '../../layouts/Layout.astro';
import CardBlog from '../../components/CardBlog.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blogs');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout>
  <div class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl font-bold tracking-tight text-[hsl(var(--foreground))]">Artikel Blog</h1>
      <p class="text-[hsl(var(--foreground)/0.7)]">Tulisan tentang teknologi, pemrograman, dan kehidupan sehari-hari.</p>
    </div>
    
    <div class="flex flex-col gap-4">
      {sortedPosts.map(post => (
        <CardBlog 
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={post.id}
        />
      ))}
    </div>
  </div>
</Layout>
