---
// src/pages/blog/index.astro
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import { CategoryDropdown } from "@components/components/ui/blog-dropdown.tsx";

// 1. KITA HANYA MENGIMPOR VERSI REACT (.tsx) DENGAN KURUNG KURAWAL { }
import { CardBlog } from "@components/components/blog-card.tsx";

const allPosts = await getCollection("blogs");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog">
  <div class="w-full space-y-8 max-w-5xl mx-auto px-4">
    <div
      class="sticky top-0 z-40 flex items-center justify-between border-b bg-background/95 pb-4 pt-4 backdrop-blur-sm"
    >
      <div>
        <h2 class="text-xl font-semibold tracking-tight">Articles</h2>
        <p class="text-muted-foreground text-xs sm:text-sm">
          Explore our latest insights and tutorials
        </p>
      </div>

      <CategoryDropdown client:load />
    </div>

    <div class="mb-10"></div>

    <div class="space-y-10">
      {
        sortedPosts.map((post) => (
          /* Menggunakan class `blog-card-lazy` untuk optimasi performa & `flex` agar tinggi card sejajar */
          <div class="blog-card-lazy flex">
            {/* 2. PROPS DIUBAH MENJADI postData={post.data} AGAR TERBACA OLEH REACT */}
            <CardBlog postData={post.data} />
          </div>
        ))
      }
    </div>
  </div>
</Layout>
