---
// src/pages/blog/index.astro
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import { CategoryDropdown } from "@components/components/ui/blog-dropdown.tsx";
import { CardBlog } from "@components/components/blog-card.tsx";

const allPosts = await getCollection("blogs");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog">
  <div class="w-full space-y-8 max-w-[52rem]">
    <div
      class="sticky top-0 z-40 flex items-center justify-between bg-background border-b pb-4 pt-4 backdrop-blur-sm"
    >
      <div>
        <h2 class="text-xl font-semibold tracking-tight">Articles</h2>
        <p class="text-muted-foreground text-xs sm:text-sm">
          Explore our latest insights and tutorials
        </p>
      </div>

      <CategoryDropdown client:visible />
    </div>

    <div class="mb-10"></div>

    <div class="space-y-10">
      {
        sortedPosts.map((post, index) => (
          /* Menggunakan Fragment <> untuk menggabungkan card dan sisipan news */
          <>
            {/* CARD ARTIKEL UTAMA */}
            <div class="blog-card-lazy flex w-full ">
              {post.slug || post.id ? (
                <CardBlog
                  postData={post.data}
                  url={`/blog/${post.slug ?? post.id}`}
                />
              ) : null}
            </div>

            {/* SISIPAN BREAKING NEWS: Muncul tepat setelah Artikel Pertama (index === 0) */}
            {index === 0 && (
              <div class=" my-4  pb-6 -mx-4 px-4 sm:mx-0 sm:px-0 rounded-none sm:rounded-xl ">
                {/* Header Section News */}
                <div class="flex items-center gap-2 mb-4">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">
                    Breaking News
                  </h4>
                  <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse" />
                </div>

                {/* KONTEN BERITA SUPER COMPACT */}
                {/* Di HP: Menjadi baris horizontal yang bisa di-scroll kesamping */}
                {/* Di Desktop (sm ke atas): Otomatis berjajar rapi 3 kolom memenuhi layar */}
                <div class="flex overflow-x-auto snap-x snap-mandatory gap-3 sm:gap-4 pb-3 scrollbar-none sm:grid sm:grid-cols-2 lg:grid-cols-3 sm:overflow-visible sm:pb-0">
                  {[1, 2, 3].map((item) => (
                    <a
                      href="#"
                      class="group w-[85vw] shrink-0 snap-start rounded-lg border border-border/50 bg-card p-1.5 transition-all hover:border-primary/40 hover:shadow-sm sm:w-full flex gap-3 items-center"
                    >
                      {/* --- GAMBAR BERITA --- */}
                      <div class="relative shrink-0 w-14 h-14 sm:w-16 sm:h-16 overflow-hidden rounded-md bg-muted">
                        <img
                          alt="News Thumbnail"
                          class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                          src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=150&auto=format&fit=crop&q=60"
                          loading="lazy"
                        />
                      </div>

                      {/* --- TEKS BERITA --- */}
                      <div class="flex-1 min-w-0 flex flex-col justify-center pr-2">
                        {/* METADATA */}
                        <div class="flex items-center gap-1.5 text-[10px] sm:text-[11px] font-medium text-muted-foreground mb-1">
                          <span class="text-primary font-semibold">
                            TechCrunch
                          </span>
                          <span>•</span>
                          <span>5m ago</span>
                        </div>

                        {/* JUDUL */}
                        <h5 class="font-medium text-xs sm:text-sm text-foreground line-clamp-2 leading-snug transition-colors group-hover:text-primary">
                          OpenAI Announces New Advanced AI Models for Everyday
                          Developers
                        </h5>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </>
        ))
      }
    </div>
  </div>
</Layout>
