---
import Layout from "@layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { ArrowLeft, ExternalLink } from "@lucide/astro";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blogs");
  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout>
  <article class="space-y-8 max-w-2xl mx-auto px-0 sm:px-0">
    <div class="space-y-3.5">
      <h1
        class="text-2xl md:text-4xl font-bold tracking-tight text-[hsl(var(--foreground))] leading-tight"
      >
        {entry.data.title}
      </h1>
      <div
        class="text-xs font-medium tracking-wide text-[hsl(var(--foreground)/0.5)] uppercase"
      >
        <time datetime={entry.data.pubDate.toISOString()}>
          {
            entry.data.pubDate.toLocaleDateString("id-ID", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
      </div>
      <p
        class="text-base md:text-lg text-[hsl(var(--foreground)/0.75)] leading-relaxed"
      >
        {entry.data.description}
      </p>

      <div class="flex flex-wrap gap-1.5 pt-1">
        {
          entry.data.tags.map((tag: string) => (
            <span class="rounded bg-[hsl(var(--secondary))] px-2.5 py-0.5 text-[12px] font-medium text-[hsl(var(--foreground)/0.75)] border border-[hsl(var(--border))]">
              {tag}
            </span>
          ))
        }
      </div>
    </div>

    {
      entry.data.image && (
        <div class="aspect-video w-full overflow-hidden rounded-xl border border-[hsl(var(--border))] bg-muted shadow-xs">
          <img
            src={entry.data.image}
            alt={entry.data.title}
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>
      )
    }

    {/* Ditambahkan class blog-content untuk sinkronisasi CSS */}
    <div class="blog-content prose dark:prose-invert max-w-none">
      <Content />
    </div>
  </article>
</Layout>

<style is:global>
  .blog-content {
    width: 100%;
    margin-top: 2rem;
  }

  /* --- UX TYPOGRAPHY OPTIMIZATION (GEMINI STYLE) --- */

  .blog-content p {
    font-size: 1rem; /* 16px standar kenyamanan membaca teks panjang */
    line-height: 1.75; /* Spasi antar baris yang lega agar mata tidak lelah */
    color: hsl(var(--foreground) / 0.88); /* Kontras tinggi untuk layar HP */
    margin-bottom: 1.5rem;
  }

  .blog-content h1,
  .blog-content h2,
  .blog-content h3 {
    color: hsl(var(--foreground)) !important;
    font-weight: 600 !important;
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin-bottom: 1rem !important;
  }

  .blog-content h2 {
    font-size: 1.4rem !important; /* Proporsional dan tegas di HP */
    margin-top: 2.5rem !important;
    border-bottom: 1px solid hsl(var(--border) / 0.5);
    padding-bottom: 0.4rem;
  }

  .blog-content h3 {
    font-size: 1.2rem !important;
    margin-top: 1.75rem !important;
  }

  @media (min-width: 768px) {
    .blog-content h2 {
      font-size: 1.625rem !important;
    }
    .blog-content h3 {
      font-size: 1.3rem !important;
    }
  }

  .blog-content ul,
  .blog-content ol {
    margin-top: 0.5rem !important;
    margin-bottom: 1.5rem !important;
    padding-left: 1.5rem !important;
  }

  .blog-content li {
    font-size: 1rem;
    line-height: 1.7;
    color: hsl(var(--foreground) / 0.88);
    margin-bottom: 0.5rem !important;
  }

  .blog-content blockquote {
    background-color: hsl(var(--muted) / 0.3) !important;
    border-left: 4px solid hsl(var(--primary)) !important;
    padding: 1rem 1.25rem !important;
    margin: 1.75rem 0 !important;
    border-radius: 0 6px 6px 0;
  }

  .blog-content blockquote p {
    font-style: italic;
    color: hsl(var(--foreground) / 0.75) !important;
    font-size: 1rem !important;
    line-height: 1.65;
    margin-bottom: 0 !important;
  }

  .blog-content a {
    color: #10b981 !important; /* Mempertahankan preferensi warna emerald-500 Anda */
    text-decoration: none !important;
    border-bottom: 1.5px solid rgba(16, 185, 129, 0.4);
    font-weight: 500;
    transition: border-color 0.15s ease;
  }

  .blog-content a:hover {
    border-bottom-color: #10b981;
  }

  .blog-content hr {
    border: 0;
    border-top: 1px solid hsl(var(--border) / 0.8) !important;
    margin: 2.5rem 0 !important;
  }

  /* --- CODE BLOCK & UX BUTTON OPTIMIZATION --- */
  .blog-content pre {
    position: relative;
    padding-top: 3rem !important; /* Jarak aman di atas agar teks kode tidak tertutup tombol */
    font-size: 0.875rem !important; /* 14px untuk font mono agar tidak terlalu lebar ke samping */
    line-height: 1.6;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .copy-code-btn {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    padding: 0.4rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;

    display: inline-flex;
    align-items: center;
    gap: 0.35rem;

    color: hsl(var(--foreground) / 0.65);
    background-color: hsl(var(--muted) / 0.8);
    border: 1px solid hsl(var(--border) / 0.8);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;

    /* Selalu tampil di HP karena perangkat sentuh tidak mendeteksi hover */
    opacity: 1;
  }

  /* Di Desktop, tombol disembunyikan dan baru muncul saat kursor diarahkan */
  @media (min-width: 1024px) {
    .copy-code-btn {
      opacity: 0;
    }
    .blog-content pre:hover .copy-code-btn {
      opacity: 1;
    }
  }

  .copy-code-btn:hover {
    color: hsl(var(--foreground));
    background-color: hsl(var(--muted));
    border-color: hsl(var(--border));
  }

  .copy-code-btn.copied {
    color: #10b981;
    border-color: rgba(16, 185, 129, 0.4);
    background-color: rgba(16, 185, 129, 0.1);
  }
</style>

<script>
  function attachCopyButtons() {
    const codeBlocks = document.querySelectorAll("div.blog-content pre");

    codeBlocks.forEach((block) => {
      if (block.querySelector(".copy-code-btn")) return;

      (block as HTMLElement).style.position = "relative";

      const copyButton = document.createElement("button");
      copyButton.className = "copy-code-btn";

      const copyIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;
      const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"/></svg>`;

      copyButton.innerHTML = `${copyIcon} <span>Copy</span>`;
      block.appendChild(copyButton);

      copyButton.addEventListener("click", async () => {
        const codeElement = block.querySelector("code");
        const codeText = codeElement ? codeElement.innerText : "";

        try {
          await navigator.clipboard.writeText(codeText);

          copyButton.innerHTML = `${checkIcon} <span>Copied!</span>`;
          copyButton.classList.add("copied");

          setTimeout(() => {
            copyButton.innerHTML = `${copyIcon} <span>Copy</span>`;
            copyButton.classList.remove("copied");
          }, 2000);
        } catch (err) {
          console.error("Gagal menyalin kode: ", err);
          copyButton.innerHTML = "Error";
        }
      });
    });
  }

  document.addEventListener("astro:page-load", attachCopyButtons);
</script>
