---
// src/pages/blog/[...slug].astro
import Layout from "@layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { formatDate } from "/utils/formatDate";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blogs");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug || entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, description, summary, subtitle, publishedAt, pubDate, image } =
  entry.data;
const { Content, headings } = await render(entry);

const person = {
  name: "Author Name",
  avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100",
};

const baseURL = Astro.site || "http://localhost:4321";
const currentURL = new URL(Astro.url.pathname, baseURL).href;

const allPosts = await getCollection("blogs");
const recentPosts = allPosts
  .filter((p) => (p.slug || p.id) !== (entry.slug || entry.id))
  .slice(0, 2);

const rawDate = publishedAt || pubDate || new Date();
const dateParam = rawDate instanceof Date ? rawDate.toISOString() : rawDate;
const displayDate = formatDate
  ? formatDate(dateParam)
  : new Date(rawDate).toLocaleDateString("en-US");
---

<Layout
  title={title}
  description={summary || description}
  image={image || `/api/og/generate?title=${encodeURIComponent(title)}`}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description: summary || description,
      datePublished: publishedAt || pubDate,
      image:
        image ||
        `${baseURL}/api/og/generate?title=${encodeURIComponent(title)}`,
      author: {
        "@type": "Person",
        name: person.name,
        image: person.avatar,
      },
    })}
  />

  {
    /* 
    PERBAIKAN 1: Menghapus max-w-5xl, mx-auto, dan px-4. 
    Sekarang grid ini mentok 100% mengikuti lebar tag <main> milik layout Anda.
  */
  }
  <div
    class="w-full grid grid-cols-1 lg:grid-cols-[1fr_180px] gap-10 xl:gap-10 items-start"
  >
    {/* ================= KOLOM UTAMA (KIRI) ================= */}
    {/* Mengubah items-center menjadi items-start agar konten rapat kiri */}
    <div class="w-full flex flex-col items-start gap-8 overflow-hidden">
      {/* HEADER ARTIKEL */}
      {/* Menghapus max-w-2xl dan mengubah text-center menjadi text-left */}
      <div class="w-full flex flex-col items-start text-left gap-2.5">
        <a
          href="/blog"
          class="text-[11px] font-bold uppercase tracking-wider text-primary hover:underline"
        >
          Blog
        </a>

        <h1
          class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-foreground leading-snug"
        >
          {title}
        </h1>

        {
          /* PERUBAHAN: Ukuran disederhanakan menjadi text-base hingga sm:text-lg */
        }
        {
          subtitle && (
            <p class="text-base sm:text-lg text-muted-foreground italic font-normal content-slide">
              {subtitle}
            </p>
          )
        }
      </div>

      {/* METADATA & AVATAR PENULIS */}
      <div
        class="flex items-center gap-3 border-y py-3 w-full border-border/60 text-xs text-muted-foreground"
      >
        <img
          src={person.avatar}
          alt={person.name}
          class="w-6 h-6 rounded-full object-cover border"
        />
        <span class="font-medium text-foreground">{person.name}</span>
        <span>•</span>
        <span>{displayDate}</span>
      </div>

      {/* GAMBAR UTAMA (BANNER) */}
      {
        image && (
          <div class="w-full aspect-video overflow-hidden rounded-xl border bg-muted shadow-xs">
            <img
              src={image}
              alt={title}
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        )
      }

      {/* ================= ISI ARTIKEL MDX / MARKDOWN ================= */}
      {
        /* 
        PERBAIKAN 2: 
        - Menggunakan `max-w-none` agar teks memanfaatkan 100% ruang kolom grid kiri.
        - Mempertahankan skala `prose-base md:prose-lg` agar tipografi Markdown otomatis estetik.
      */
      }
      <article
        class="w-full max-w-none prose prose-neutral dark:prose-invert prose-base md:prose-lg tracking-normal leading-relaxed
        prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-foreground
        prose-a:text-primary prose-a:no-underline hover:prose-a:underline
        prose-strong:text-foreground prose-code:text-foreground
        prose-img:rounded-xl prose-img:border"
      >
        <Content />
      </article>

      {/* ================= RECENT POSTS SECTION ================= */}
      {
        /* Menghapus max-w-2xl agar section rekomendasi ikut melebar rata kanan-kiri */
      }
      <div class="w-full border-t pt-10 mt-6 flex flex-col items-start gap-6">
        <h2
          id="recent-posts"
          class="text-lg font-bold tracking-tight text-foreground"
        >
          Recent posts
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 w-full">
          {
            recentPosts.map((post) => (
              <a
                href={`/blog/${post.slug || post.id}/`}
                class="group flex flex-col gap-3 w-full"
              >
                {post.data.image && (
                  <div class="aspect-video w-full rounded-lg overflow-hidden border bg-muted">
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-103"
                    />
                  </div>
                )}
                <h3 class="font-semibold text-base text-foreground group-hover:text-primary transition-colors line-clamp-2">
                  {post.data.title}
                </h3>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    {
      /* ================= SIDEBAR NAVIGASI KANAN (TABLE OF CONTENTS) ================= */
    }
    <aside
      class="hidden lg:flex flex-col sticky top-32 max-h-[calc(100vh-160px)] overflow-y-auto pr-4 pb-4 gap-4 w-full [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      {/* 💡 PERUBAHAN DI ATAS:
    1. [scrollbar-width:none] -> Menghilangkan scrollbar di Firefox
    2. [&::-webkit-scrollbar]:hidden -> Menghilangkan scrollbar di Chrome, Safari, dan Edge
    3. Mengubah pr-2 menjadi pr-4 & menambah pb-4 -> Memberi ruang napas tambahan agar efek membal tidak terpotong (clipped)
  */}
    >
      <h3
        class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground/80"
      >
        On This Page
      </h3>
      <nav
        class="flex flex-col gap-2.5 text-xs border-l border-border relative py-1"
      >
        {
          headings.map((heading) => (
            <a
              href={`#${heading.slug}`}
              class={`block text-muted-foreground hover:text-primary transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] leading-normal border-l-2 border-transparent -ml-[1px] font-medium whitespace-normal break-words pb-0.5 origin-left ${
                heading.depth === 3 ? "pl-6 text-[11px]" : "pl-3"
              }`}
            >
              {heading.text}
            </a>
          ))
        }
      </nav>
    </aside>
  </div>
</Layout>

<script>
  function initScrollSpy() {
    const headings = document.querySelectorAll("article h2, article h3");
    const tocLinks = document.querySelectorAll("aside nav a");

    if (headings.length === 0 || tocLinks.length === 0) return;

    const options = {
      root: null,
      rootMargin: "0px 0px -80% 0px",
      threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute("id");

          tocLinks.forEach((link) => {
            const href = link.getAttribute("href")?.substring(1);

            if (href === id) {
              // 💡 SUNTIKKAN: scale-105 dipadukan dengan cubic-bezier akan menghasilkan efek membal yang elastis
              link.classList.add("text-primary", "border-primary", "scale-105");
              link.classList.remove(
                "text-muted-foreground",
                "border-transparent",
              );
            } else {
              link.classList.remove(
                "text-primary",
                "border-primary",
                "scale-105",
              );
              link.classList.add("text-muted-foreground", "border-transparent");
            }
          });
        }
      });
    }, options);

    headings.forEach((heading) => observer.observe(heading));
  }

  // Menjamin script berjalan saat pertama dimuat maupun setelah transisi Astro selesai
  document.addEventListener("astro:page-load", initScrollSpy);
</script>
