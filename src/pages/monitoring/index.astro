---
import Layout from '@layouts/Layout.astro';
---

<Layout>
  <!-- Main container menggunakan variabel tema shadcn Anda (mendukung Light/Dark Mode) -->
  <main class=" relative min-h-[400px] flex items-center justify-center bg-[hsl(var(--background))] text-[hsl(var(--foreground))] font-sans antialiased overflow-hidden transition-colors duration-300">
    
    <!-- Efek Grid Halus yang menyesuaikan dengan warna border tema -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--border))_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--border))_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] opacity-30 pointer-events-none"></div>

    <!-- Konten Box -->
    <div class="relative z-10 text-center px-6 max-w-md mx-auto flex flex-col items-center">
      
      <!-- Icon Spinner Minimalis menggunakan warna muted -->
        <div 
        style="border-radius: var(--radius);" 
        class="mb-6 flex h-12 w-12 items-center justify-center border border-[hsl(var(--border))] bg-[hsl(var(--muted))]/50 text-[hsl(var(--foreground))]"
        >
        <svg 
            xmlns="http://www.w3.org/2000/svg"
            width="24" 
            height="24" 
            viewBox="0 0 24 24" 
            fill="none" 
            stroke="currentColor" 
            stroke-width="2" 
            stroke-linecap="round" 
            stroke-linejoin="round" 
            class="w-5 h-5 animate-spin"
        >
            <path d="M21 12a9 9 0 1 1-6.219-8.56" />
        </svg>
        </div>

      <!-- Judul -->
      <h1 class="text-3xl font-bold tracking-tight text-[hsl(var(--foreground))] sm:text-4xl mb-3">
        Monitoring
      </h1>
      <h2 class="text-2xl font-bold tracking-tight text-[hsl(var(--foreground))] sm:text-3xl mb-5">
        Under Development
      </h2>

      <!-- Deskripsi menggunakan opasitas atau warna teks sekunder -->
      <p class="text-sm text-[hsl(var(--foreground))]/70 mb-8 leading-relaxed max-w-[320px]">
        Halaman ini sedang dalam proses pengembangan. Saya akan segera kembali.
      </p>

      <!-- Tombol "Back" - Menggunakan Style Varian Outline asli shadcn/ui -->
      <a 
        href="/"
        style="border-radius: var(--radius);"
        class="inline-flex items-center justify-center gap-2 text-sm font-medium border border-[hsl(var(--border))] bg-[hsl(var(--background))] text-[hsl(var(--foreground))] shadow-sm hover:bg-[hsl(var(--secondary))] hover:text-[hsl(var(--foreground))] h-9 px-4 py-2 cursor-pointer transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[hsl(var(--primary))] disabled:pointer-events-none disabled:opacity-50"
      >
        <!-- Icon panah kiri -->
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Back
      </a>

    </div>

  </main>
</Layout>