---
import Layout from "@layouts/Layout.astro";
import { ChatContainer } from "@components/myAI/ChatContainer";
import { getSession } from "auth-astro/server";

const session = await getSession(Astro.request);
const isLoggedIn = !!session?.user;
---

<Layout title="myAI Playground - Assistant" fullHeight={true}>
  <div
    transition:animate="none"
    class="relative w-full h-full bg-background text-foreground font-sans antialiased overflow-hidden flex flex-col"
  >
    <!-- {/* Dynamic Background Pattern */}
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] opacity-25 pointer-events-none"
    >
    </div> -->

    <div class="relative z-10 mx-auto flex flex-col flex-1 w-full min-h-0">
      {/* Main Interactive Chat Panel Component */}
      <div class="w-full flex-1 min-h-0 flex flex-col md:mt-2 mt-0">
        <ChatContainer client:only="react" isLoggedIn={isLoggedIn} />
      </div>
    </div>
  </div>
</Layout>
