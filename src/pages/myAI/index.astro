<Layout title="myAI Playground - Assistant" fullHeight={true}>
  <div
    transition:animate="none"
    className="relative w-full min-h-screen bg-background text-foreground font-sans antialiased overflow-hidden"
  >
    <!-- {/* Dynamic Background Pattern */}
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] opacity-25 pointer-events-none"
    >
    </div> -->

    <div class="relative z-10 mx-auto flex flex-col gap-6">
      {/* Main Interactive Chat Panel Component */}
      <main class="w-full mt-2">
        <ChatContainer client:load />
      </main>
    </div>
  </div>
</Layout>
