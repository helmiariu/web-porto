---
// Jangan import Layout.astro lagi
import { LoginForm } from "@components/components/login-form";

// PENTING: Import file CSS global Tailwind/Shadcn kamu di sini
// (Sesuaikan path-nya dengan letak file global CSS milikmu)
import "@styles/global.css";
import { getSession } from "auth-astro/server";
export const prerender = false;

const session = await getSession(Astro.request);
if (session) {
    return Astro.redirect("/");
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/gif" href="/3d.png" />
        <title>Helmi Arimbawa - Auth</title>
        <!-- Tambahkan favicon atau meta tags lain di sini jika perlu -->
        <script is:inline>
            const getThemePreference = () => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                return window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light";
            };
            const isDark = getThemePreference() === "dark";
            document.documentElement.classList[isDark ? "add" : "remove"](
                "dark",
            );
        </script>
    </head>

    <body class="bg-background text-foreground antialiased">
        <!-- Kontainer ini akan mengambil full tinggi layar (min-h-screen) 
         dan menengahkan form di tengah-tengah secara vertikal & horizontal -->
        <main class="flex min-h-screen items-center justify-center p-4">
            <LoginForm client:load />
        </main>
    </body>
</html>
