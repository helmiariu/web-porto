---
// src/pages/project/[...slug].astro
import Layout from "@layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { ChevronLeft } from "@lucide/astro";
import { Icon } from "@iconify/react";

export async function getStaticPaths() {
  const projectEntries = await getCollection("project");
  return projectEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, description, heroImage, techStack = [] } = entry.data;
const { Content } = await render(entry);
---

<Layout title={title}>
  <div class="w-full max-w-[52rem] flex flex-col gap-6">
    {/* Back to Projects */}
    <div>
      <a
        href="/project"
        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-muted-foreground hover:text-primary transition-colors duration-200"
      >
        <ChevronLeft class="h-3.5 w-3.5 sm:h-4 sm:w-4" />
        <span>Back to Projects</span>
      </a>
    </div>

    {/* Header Section */}
    <div class="flex flex-col gap-2">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-foreground leading-snug"
      >
        {title}
      </h1>
      <p
        class="text-sm sm:text-base text-muted-foreground leading-relaxed italic"
      >
        {description}
      </p>
    </div>

    {/* Hero Image */}
    {
      heroImage && (
        <div class="w-full aspect-video overflow-hidden rounded-xl border bg-muted shadow-sm">
          <img
            src={heroImage}
            alt={title}
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      )
    }

    {/* Tech Stack Badge Row */}
    {
      techStack.length > 0 && (
        <div class="flex flex-wrap gap-2 items-center border-y py-3 w-full border-border/60">
          <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground mr-1">
            Tech Stack:
          </span>
          {techStack.map((tech) => {
            // 1. Ekstrak nama ikon dan warna secara dinamis
            const isString = typeof tech === "string";
            const iconName = isString ? tech : tech.icon;
            const iconColor = isString ? undefined : tech.color;

            // Jika karena alasan tertentu data ikon kosong, lewati
            if (!iconName) return null;

            // 2. Ambil nama untuk teks di dalam badge
            const displayName = iconName.split(":").pop()?.replace("-icon", "");

            return (
              <div class="flex items-center gap-1.5 bg-muted/40 border border-border/20 px-2.5 py-1 rounded-md text-xs font-medium text-foreground">
                <Icon
                  icon={iconName}
                  className="h-4 w-4 shrink-0"
                  style={iconColor ? { color: iconColor } : undefined}
                  client:load
                />
                <span class="capitalize">{displayName}</span>
              </div>
            );
          })}
        </div>
      )
    }

    {/* MDX Content */}
    <article
      class="w-full max-w-none prose prose-neutral dark:prose-invert prose-base tracking-normal leading-relaxed
      prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-foreground
      prose-a:text-primary prose-a:no-underline hover:prose-a:underline
      prose-strong:text-foreground prose-code:text-foreground
      prose-img:rounded-xl prose-img:border"
    >
      <Content />
    </article>
  </div>
</Layout>
