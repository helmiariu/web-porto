---
import Layout from "@layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { ArrowLeft, ExternalLink } from "@lucide/astro";

export async function getStaticPaths() {
  const projectEntries = await getCollection("projects");
  return projectEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout>
  <article class="space-y-8 max-w-3xl px-0 pb-10 md:pb-0 sm:px-4">
    <div class="space-y-3.5">
      <h1
        class="text-2xl md:text-3xl font-bold tracking-tight text-[hsl(var(--foreground))] leading-tight"
      >
        {entry.data.title}
      </h1>
      <p class="text-base text-[hsl(var(--foreground)/0.8)] leading-relaxed">
        {entry.data.description}
      </p>

      <div class="flex flex-wrap gap-1.5 pt-1">
        {
          entry.data.tags.map((tag: string) => (
            <span class="rounded bg-[hsl(var(--secondary))] px-2.5 py-0.5 text-[12px] font-medium text-[hsl(var(--foreground)/0.75)] border border-[hsl(var(--border))]">
              {tag}
            </span>
          ))
        }
      </div>

      <div class="flex items-center gap-2.5 pt-2">
        {
          entry.data.github && (
            <a
              href={entry.data.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-md bg-[hsl(var(--secondary))] px-3 py-2 text-sm font-medium text-[hsl(var(--foreground))] border border-[hsl(var(--border))] hover:bg-[hsl(var(--muted))] transition-colors"
            >
              <svg
                class="w-4 h-4"
                viewBox="0 0 15 15"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M7.49933 0.25C3.49635 0.25 0.25 3.49593 0.25 7.50024C0.25 10.703 2.32715 13.4206 5.2081 14.3797C5.57084 14.446 5.70302 14.2222 5.70302 14.0299C5.70302 13.8576 5.69679 13.4019 5.69323 12.797C3.67661 13.235 3.25112 11.825 3.25112 11.825C2.92132 10.9874 2.44599 10.7644 2.44599 10.7644C1.78773 10.3149 2.49584 10.3238 2.49584 10.3238C3.22353 10.375 3.60629 11.0711 3.60629 11.0711C4.25298 12.1788 5.30335 11.8588 5.71638 11.6732C5.78225 11.205 5.96962 10.8854 6.17658 10.7043C4.56675 10.5209 2.87415 9.89918 2.87415 7.12104C2.87415 6.32925 3.15677 5.68257 3.62053 5.17563C3.54576 4.99226 3.29697 4.25521 3.69174 3.25691C3.69174 3.25691 4.30015 3.06196 5.68522 3.99973C6.26337 3.83906 6.8838 3.75895 7.50022 3.75583C8.1162 3.75895 8.73619 3.83906 9.31523 3.99973C10.6994 3.06196 11.3069 3.25691 11.3069 3.25691C11.7026 4.25521 11.4538 4.99226 11.3795 5.17563C11.8441 5.68257 12.1245 6.32925 12.1245 7.12104C12.1245 9.9063 10.4292 10.5192 8.81452 10.6985C9.07444 10.9224 9.30633 11.3648 9.30633 12.0413C9.30633 13.0102 9.29742 13.7922 9.29742 14.0299C9.29742 14.2239 9.42828 14.4496 9.79591 14.3788C12.6746 13.4179 14.75 10.7025 14.75 7.50024C14.75 3.49593 11.5036 0.25 7.49933 0.25Z"
                  fill="currentColor"
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                />
              </svg>
              Source Code
            </a>
          )
        }
        {
          entry.data.link && (
            <a
              href={entry.data.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-md bg-[hsl(var(--primary))] px-3 py-2 text-sm font-medium text-[hsl(var(--background))] hover:opacity-90 transition-opacity"
            >
              <ExternalLink class="h-4 w-4" />
              Live Demo
            </a>
          )
        }
      </div>
    </div>

    {
      entry.data.image && (
        <div class="aspect-video w-full overflow-hidden rounded-lg border border-[hsl(var(--border))] bg-muted shadow-xs">
          <img
            src={entry.data.image}
            alt={entry.data.title}
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>
      )
    }

    <div class="blog-content prose dark:prose-invert">
      <Content />
    </div>
  </article>
</Layout>

<style is:global>
  .blog-content {
    width: 100%;
    margin-top: 2rem;
  }

  /* --- UX TYPOGRAPHY OPTIMIZATION (GEMINI STYLE) --- */

  .blog-content p {
    font-size: 1rem; /* 16px standar emas membaca di HP & Web Gemini */
    line-height: 1.75; /* Jarak baris lebih renggang agar mata tidak lelah di layar kecil */
    color: hsl(
      var(--foreground) / 0.88
    ); /* Kontras teks utama ditingkatkan sedikit */
    margin-bottom: 1.5rem;
  }

  .blog-content h1,
  .blog-content h2,
  .blog-content h3 {
    color: hsl(var(--foreground)) !important;
    font-weight: 600 !important;
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin-bottom: 1rem !important;
  }

  .blog-content h2 {
    font-size: 1.4rem !important; /* Ukuran heading yang tegas namun pas di HP */
    margin-top: 2.5rem !important;
    border-bottom: 1px solid hsl(var(--border) / 0.5);
    padding-bottom: 0.4rem;
  }

  .blog-content h3 {
    font-size: 1.2rem !important;
    margin-top: 1.75rem !important;
  }

  @media (min-width: 768px) {
    .blog-content h2 {
      font-size: 1.625rem !important;
    }
    .blog-content h3 {
      font-size: 1.3rem !important;
    }
  }

  .blog-content ul,
  .blog-content ol {
    margin-top: 0.5rem !important;
    margin-bottom: 1.5rem !important;
    padding-left: 1.5rem !important;
  }

  .blog-content li {
    font-size: 1rem;
    line-height: 1.7;
    color: hsl(var(--foreground) / 0.88);
    margin-bottom: 0.5rem !important;
  }

  .blog-content blockquote {
    background-color: hsl(var(--muted) / 0.3) !important;
    border-left: 4px solid hsl(var(--primary)) !important;
    padding: 1rem 1.25rem !important;
    margin: 1.75rem 0 !important;
    border-radius: 0 6px 6px 0;
  }

  .blog-content blockquote p {
    font-style: italic;
    color: hsl(var(--foreground) / 0.75) !important;
    font-size: 1rem !important;
    line-height: 1.65;
    margin-bottom: 0 !important;
  }

  .blog-content a {
    color: hsl(var(--primary)) !important;
    text-decoration: none !important;
    border-bottom: 1.5px solid hsl(var(--primary) / 0.4);
    font-weight: 500;
    transition: border-color 0.15s ease;
  }

  .blog-content a:hover {
    border-bottom-color: hsl(var(--primary));
  }

  .blog-content hr {
    border: 0;
    border-top: 1px solid hsl(var(--border) / 0.8) !important;
    margin: 2.5rem 0 !important;
  }

  /* --- CODE BLOCK & UX BUTTON OPTIMIZATION --- */
  .blog-content pre {
    position: relative;
    padding-top: 3rem !important; /* Ruang ekstra di atas agar kode tidak tertimpa tombol di HP */
    font-size: 0.875rem !important; /* 14px untuk blok kode agar muat lebih banyak karakter */
    line-height: 1.6;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .copy-code-btn {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    padding: 0.4rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;

    display: inline-flex;
    align-items: center;
    gap: 0.35rem;

    color: hsl(var(--foreground) / 0.65);
    background-color: hsl(var(--muted) / 0.8);
    border: 1px solid hsl(var(--border) / 0.8);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;

    /* UX FIX: Di HP (Layar Sentuh) tombol harus selalu terlihat karena tidak ada state hover */
    opacity: 1;
  }

  /* Di Desktop (Layar Lebar), kita kembalikan efek hover agar bersih */
  @media (min-width: 1024px) {
    .copy-code-btn {
      opacity: 0;
    }
    .blog-content pre:hover .copy-code-btn {
      opacity: 1;
    }
  }

  .copy-code-btn:hover {
    color: hsl(var(--foreground));
    background-color: hsl(var(--muted));
    border-color: hsl(var(--border));
  }

  .copy-code-btn.copied {
    color: hsl(var(--primary));
    border-color: hsl(var(--primary) / 0.4);
    background-color: hsl(var(--primary) / 0.1);
  }
</style>

<script>
  function attachCopyButtons() {
    const codeBlocks = document.querySelectorAll("div.blog-content pre");

    codeBlocks.forEach((block) => {
      if (block.querySelector(".copy-code-btn")) return;

      (block as HTMLElement).style.position = "relative";

      const copyButton = document.createElement("button");
      copyButton.className = "copy-code-btn";

      const copyIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;
      const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"/></svg>`;

      copyButton.innerHTML = `${copyIcon} <span>Copy</span>`;
      block.appendChild(copyButton);

      copyButton.addEventListener("click", async () => {
        const codeElement = block.querySelector("code");
        const codeText = codeElement ? codeElement.innerText : "";

        try {
          await navigator.clipboard.writeText(codeText);

          copyButton.innerHTML = `${checkIcon} <span>Copied!</span>`;
          copyButton.classList.add("copied");

          setTimeout(() => {
            copyButton.innerHTML = `${copyIcon} <span>Copy</span>`;
            copyButton.classList.remove("copied");
          }, 2000);
        } catch (err) {
          console.error("Gagal menyalin kode: ", err);
          copyButton.innerHTML = "Error";
        }
      });
    });
  }

  document.addEventListener("astro:page-load", attachCopyButtons);
</script>
