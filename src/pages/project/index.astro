---
import Layout from '@layouts/Layout.astro';
import CardProject from '@components/ui/CardProject.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout>
  <div class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl font-bold tracking-tight text-[hsl(var(--foreground))]">Semua Proyek</h1>
      <p class="text-[hsl(var(--foreground)/0.7)]">Daftar lengkap proyek yang pernah saya kerjakan.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedProjects.map(project => (
        <CardProject 
          title={project.data.title}
          description={project.data.description}
          image={project.data.image}
          tags={project.data.tags}
          slug={project.id}
          featured={project.data.featured}
        />
      ))}
    </div>
  </div>
</Layout>
