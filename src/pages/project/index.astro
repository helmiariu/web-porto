---
import Layout from "@layouts/Layout.astro";
import CardProject from "@components/ui/CardProject.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const sortedProjects = allProjects.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout>
  <div class="space-y-6 animate-fade-in-up">
    <div class="space-y-1">
      <h1
        class="text-[clamp(1.3rem,6vw,1.4rem)] font-bold tracking-tight text-foreground"
      >
        All Projects
      </h1>
      <p class="text-sm text-[hsl(var(--foreground)/0.7)]">
        Daftar lengkap proyek yang pernah saya kerjakan.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {
        sortedProjects.map((project) => (
          /* Ditambahkan class `flex` agar tinggi semua card sejajar rapi */
          <div class="project-card-lazy flex">
            <CardProject
              title={project.data.title}
              description={project.data.description}
              image={project.data.image}
              tags={project.data.tags}
              slug={project.id}
              featured={project.data.featured}
            />
          </div>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  /* 1. Optimasi Animasi untuk HP Spek Lama */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.4s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    will-change: transform, opacity;
  }

  /* 2. LAZY RENDERING: Disesuaikan dimensinya agar pas dengan rasio grid 3 kolom */
  .project-card-lazy {
    content-visibility: auto;
    contain-intrinsic-size: 0 400px; /* Diatur ke ~400px karena kartu vertikal di grid 3 kolom sedikit lebih tinggi ke bawah */
  }

  /* Matikan animasi jika user mengaktifkan mode hemat daya */
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in-up {
      animation: none;
      will-change: auto;
    }
  }
</style>
