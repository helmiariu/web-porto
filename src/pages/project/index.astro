---
// src/pages/project/index.astro
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import { ProjectCard } from "@components/components/ProjectCard";

// Fetch all project entries
const allproject = await getCollection("project");

// Mengurutkan agar proyek 'featured' berada di atas (opsional, silakan hapus .sort jika ingin urutan bebas)
const sortedproject = allproject.sort((a, b) => {
  return (b.data.isFeatured ? 1 : 0) - (a.data.isFeatured ? 1 : 0);
});
---

<Layout title="project">
  <div class="w-full space-y-10 max-w-[52rem]">
    {/* Page Header */}
    <div
      class="sticky top-0 z-30 flex flex-col justify-center backdrop-blur-md border-b pb-4 pt-4"
    >
      <h2 class="text-xl font-semibold tracking-tight text-foreground">
        Project
      </h2>
      <p class="text-muted-foreground text-xs sm:text-sm">
        A gallery of my technical builds, automation scripts, and creative
        designs.
      </p>
    </div>

    {/* All project Grid */}
    {
      sortedproject.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {sortedproject.map((project) => (
            <ProjectCard
              key={project.id}
              project={project.data}
              slug={project.id}
              client:load
            />
          ))}
        </div>
      )
    }

    {/* Empty State */}
    {
      sortedproject.length === 0 && (
        <div class="flex flex-col items-center justify-center py-20 border border-dashed rounded-xl border-border/80">
          <p class="text-muted-foreground text-sm">No project found.</p>
        </div>
      )
    }
  </div>
</Layout>
