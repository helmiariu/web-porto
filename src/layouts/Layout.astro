---
import "@styles/global.css";
import Sidebar from "@components/layout/Sidebar.astro";
import MobileBottomNav from "@components/layout/MobileBottomNav.astro";
import MobileMenuDrawer from "@components/layout/MobileMenuDrawer.astro";
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          const theme = localStorage.getItem("astro-theme");
          const isDark = theme
            ? theme === "dark"
            : window.matchMedia?.("(prefers-color-scheme: dark)").matches;
          if (isDark) document.documentElement.classList.add("dark");
          else document.documentElement.classList.remove("dark");
        } catch (e) {
          // ignore
        }
      })();
    </script>
  </head>

  <body
    class="font-sans antialiased bg-[hsl(var(--background))] text-[hsl(var(--foreground))] min-h-screen"
  >
    <div
      class="mx-auto max-w-[1400px] w-full px-4 sm:px-6 md:pl-0 md:pr-8 lg:pr-12 pt-8 pb-0 md:pt-0 flex flex-col md:grid md:grid-cols-[auto_1fr] gap-6 md:gap-8 lg:gap-12 min-h-screen"
    >
      <Sidebar />

      <main class="flex-1 min-w-0 w-full pt-3 md:pt-16 pb-12 md:pb-20">
        <slot />
      </main>
    </div>

    <MobileBottomNav />
    <MobileMenuDrawer />
  </body>
</html>
