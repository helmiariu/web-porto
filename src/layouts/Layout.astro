---
// src/layouts/Layout.astro
import "@styles/global.css";
import Sidebar from "@components/layout/Sidebar.astro";
import MobileBottomNav from "@components/layout/MobileBottomNav.astro";
import MobileMenuDrawer from "@components/layout/MobileMenuDrawer.astro";
import TopProgressBar from "@components/ui/TopProgressBar.astro";
import "@fontsource-variable/montserrat";
interface Props {
  title: string;
}

const { title } = Astro.props;

// Mengimpor ClientRouter dari modul transitions Astro
import { ClientRouter } from "astro:transitions";
import ChatWidget from "@components/AiAssistant/ChatWidget.astro";
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script
      type="module"
      src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"
    ></script>
    <link rel="icon" type="image/gif" href="/3d.png" />
    <title>Helmi Arimbawa - Portfolio</title>
    <meta
      name="description"
      content="Portofolio Helmi, Full-Stack Developer & Designer..."
    />

    <!-- <link
      rel="preload"
      href="/_astro/montserrat-variable-latin-woff2.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    /> -->

    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("astro-theme");
          const isDark = theme
            ? theme === "dark"
            : window.matchMedia?.("(prefers-color-scheme: dark)").matches;

          if (isDark) {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
        } catch (e) {}
      })();

      // Jalankan tepat sebelum konten halaman ditukar oleh ClientRouter
      document.addEventListener("astro:before-swap", (e) => {
        try {
          const theme = localStorage.getItem("astro-theme");
          const isDark = theme
            ? theme === "dark"
            : window.matchMedia?.("(prefers-color-scheme: dark)").matches;
          if (isDark) e.newDocument.documentElement.classList.add("dark");
          else e.newDocument.documentElement.classList.remove("dark");
        } catch (err) {}
      });
    </script>

    <ClientRouter />
  </head>

  <body class="antialiased bg-background text-foreground min-h-screen">
    <div class="prose dark:prose-invert hidden"></div>
    <TopProgressBar />
    <div
      class="mx-auto max-w-[1250px] w-full px-6 sm:px-9 md:pl-0 md:pr-6 lg:pr-8 pt-8 pb-0 md:pt-0 flex flex-col md:grid md:grid-cols-[250px_1fr] gap-6 md:gap-6 lg:gap-7 min-h-screen"
    >
      <Sidebar />

      <main class="flex-1 min-w-0 w-full pt-0 md:pt-13 pb-16 md:pb-20">
        <slot />
      </main>
    </div>

    <MobileBottomNav />
    <MobileMenuDrawer />
    <ChatWidget />
  </body>
</html>

<script>
  // ==========================================
  // 1. SINKRONISASI TEMA ANTAR-TAB
  // ==========================================
  const syncThemeAcrossTabs = () => {
    window.addEventListener("storage", (event) => {
      if (event.key === "astro-theme" && event.newValue) {
        if (event.newValue === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      }
    });
  };

  // ==========================================
  // 2. MANAJEMEN SCROLL SIDEBAR
  // ==========================================
  const handleSidebarScroll = () => {
    const sidebar =
      document.querySelector("aside") ||
      document.querySelector("#sidebar-container");

    if (sidebar) {
      const savedScrollTop = sessionStorage.getItem("sidebar-scroll-position");
      if (savedScrollTop) {
        sidebar.scrollTop = parseInt(savedScrollTop, 10);
      }

      sidebar.addEventListener("scroll", () => {
        sessionStorage.setItem(
          "sidebar-scroll-position",
          sidebar.scrollTop.toString(),
        );
      });
    }
  };

  // ==========================================
  // INISIALISASI SAAT HALAMAN DI-LOAD
  // ==========================================
  document.addEventListener("astro:page-load", () => {
    handleSidebarScroll();
    syncThemeAcrossTabs();
  });

  document.addEventListener("astro:before-swap", () => {
    const sidebar =
      document.querySelector("aside") ||
      document.querySelector("#sidebar-container");
    if (sidebar) {
      sessionStorage.setItem(
        "sidebar-scroll-position",
        sidebar.scrollTop.toString(),
      );
    }
  });
</script>
