---
import "@styles/global.css";
import Sidebar from "@components/layout/Sidebar.astro";
import MobileBottomNav from "@components/layout/MobileBottomNav.astro";
import MobileMenuDrawer from "@components/layout/MobileMenuDrawer.astro";

// 1. Mengimpor ClientRouter dari modul transitions Astro
import { ClientRouter } from 'astro:transitions';
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <title>Helmi Arimbawa - Portfolio</title>
    <meta name="description" content="Portofolio Helmi Arimbawa, Full-Stack Developer & Designer..." />
    
    <ClientRouter />

    <script is:inline>
      const applyTheme = () => {
        try {
          const theme = localStorage.getItem("astro-theme");
          const isDark = theme
            ? theme === "dark"
            : window.matchMedia?.("(prefers-color-scheme: dark)").matches;
          
          if (isDark) {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
        } catch (e) {
          // ignore
        }
      };

      // Jalankan langsung saat website pertama kali dibuka (Hard Refresh)
      applyTheme();

      // Jalankan tepat saat konten halaman ditukar oleh ClientRouter, SEBELUM digambar di layar
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
  </head>

  <body
    class="font-sans antialiased bg-[hsl(var(--background))] text-[hsl(var(--foreground))] min-h-screen"
  >
    <div
      class="mx-auto max-w-[1200px] w-full px-4 sm:px-6 md:pl-0 md:pr-8 lg:pr-12 pt-8 pb-0 md:pt-0 flex flex-col md:grid md:grid-cols-[auto_1fr] gap-6 md:gap-8 lg:gap-12 min-h-screen"
    >
      <Sidebar />

      <main class="flex-1 min-w-0 w-full pt-3 md:pt-20 pb-12 md:pb-20">
        <slot />
      </main>
    </div>

    <MobileBottomNav />
    <MobileMenuDrawer />
  </body>
</html>

<script>
  // Fungsi utama untuk merekam dan mengembalikan posisi scroll
  const handleSidebarScroll = () => {
    // Mencari elemen sidebar. Kita gunakan querySelector untuk mencari tag <aside> atau elemen sidebar kamu
    const sidebar = document.querySelector("aside") || document.querySelector("#sidebar-container");
    
    if (sidebar) {
      // 1. Kembalikan posisi scroll jika sebelumnya pernah disimpan di memori sesi browser
      const savedScrollTop = sessionStorage.getItem("sidebar-scroll-position");
      if (savedScrollTop) {
        sidebar.scrollTop = parseInt(savedScrollTop, 10);
      }

      // 2. Simpan posisi scroll terbaru setiap kali user melakukan scroll di area sidebar
      sidebar.addEventListener("scroll", () => {
        sessionStorage.setItem("sidebar-scroll-position", sidebar.scrollTop.toString());
      });
    }
  };

  // Jalankan ketika halaman selesai dimuat ulang (baik hard refresh maupun via ClientRouter)
  document.addEventListener("astro:page-load", handleSidebarScroll);

  // Cadangan darurat: Simpan posisi scroll tepat sedetik sebelum halaman ditukar
  document.addEventListener("astro:before-swap", () => {
    const sidebar = document.querySelector("aside") || document.querySelector("#sidebar-container");
    if (sidebar) {
      sessionStorage.setItem("sidebar-scroll-position", sidebar.scrollTop.toString());
    }
  });
</script>