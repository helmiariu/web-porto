---
import "@styles/global.css";
import Sidebar from "@components/layout/Sidebar.astro";
import MobileBottomNav from "@components/layout/MobileBottomNav.astro";
import MobileMenuDrawer from "@components/layout/MobileMenuDrawer.astro";
// Impor semua weight versi Normal (100 - 900)
import "@fontsource/montserrat/100.css";
import "@fontsource/montserrat/200.css";
import "@fontsource/montserrat/300.css";
import "@fontsource/montserrat/400.css";
import "@fontsource/montserrat/500.css";
import "@fontsource/montserrat/600.css";
import "@fontsource/montserrat/700.css";
import "@fontsource/montserrat/800.css";
import "@fontsource/montserrat/900.css";

// Impor semua weight versi Italic (100 - 900)
import "@fontsource/montserrat/100-italic.css";
import "@fontsource/montserrat/200-italic.css";
import "@fontsource/montserrat/300-italic.css";
import "@fontsource/montserrat/400-italic.css";
import "@fontsource/montserrat/500-italic.css";
import "@fontsource/montserrat/600-italic.css";
import "@fontsource/montserrat/700-italic.css";
import "@fontsource/montserrat/800-italic.css";
import "@fontsource/montserrat/900-italic.css";

// 1. Mengimpor ClientRouter dari modul transitions Astro
import { ClientRouter } from 'astro:transitions';
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Helmi Arimbawa - Portfolio</title>
    <meta name="description" content="Portofolio Helmi Arimbawa, Full-Stack Developer & Designer..." />
    
    <ClientRouter />

    <script is:inline>
      const applyTheme = () => {
        try {
          const theme = localStorage.getItem("astro-theme");
          const isDark = theme
            ? theme === "dark"
            : window.matchMedia?.("(prefers-color-scheme: dark)").matches;
          
          if (isDark) {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
        } catch (e) {
          // ignore
        }
      };

      // Jalankan langsung saat website pertama kali dibuka (Hard Refresh)
      applyTheme();

      // Jalankan tepat saat konten halaman ditukar oleh ClientRouter, SEBELUM digambar di layar
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
  </head>

  <body
    class="font-sans antialiased bg-[hsl(var(--background))] text-[hsl(var(--foreground))] min-h-screen"
  >
    <div
      class="mx-auto max-w-[1200px] w-full px-4 sm:px-6 md:pl-0 md:pr-8 lg:pr-12 pt-18 pb-0 md:pt-0 flex flex-col md:grid md:grid-cols-[auto_1fr] gap-6 md:gap-8 lg:gap-12 min-h-screen"
    >
      <Sidebar />

      <main class="flex-1 min-w-0 w-full pt-3 md:pt-13 pb-12 md:pb-20">
        <slot />
      </main>
    </div>

    <MobileBottomNav />
    <MobileMenuDrawer />
  </body>
</html>

<script>
  // ==========================================
  // 1. SINKRONISASI TEMA ANTAR-TAB
  // ==========================================
  const syncThemeAcrossTabs = () => {
    window.addEventListener("storage", (event) => {
      // Memastikan yang berubah adalah key tema kita
      if (event.key === "astro-theme" && event.newValue) {
        if (event.newValue === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      }
    });
  };

  // ==========================================
  // 2. MANAJEMEN SCROLL SIDEBAR
  // ==========================================
  const handleSidebarScroll = () => {
    const sidebar = document.querySelector("aside") || document.querySelector("#sidebar-container");
    
    if (sidebar) {
      const savedScrollTop = sessionStorage.getItem("sidebar-scroll-position");
      if (savedScrollTop) {
        sidebar.scrollTop = parseInt(savedScrollTop, 10);
      }

      sidebar.addEventListener("scroll", () => {
        sessionStorage.setItem("sidebar-scroll-position", sidebar.scrollTop.toString());
      });
    }
  };

  // ==========================================
  // INISIALISASI SAAT HALAMAN DI-LOAD
  // ==========================================
  document.addEventListener("astro:page-load", () => {
    handleSidebarScroll();
    syncThemeAcrossTabs(); // Jalankan listener sinkronisasi di sini
  });

  // Cadangan darurat scroll sidebar sebelum halaman ditukar
  document.addEventListener("astro:before-swap", () => {
    const sidebar = document.querySelector("aside") || document.querySelector("#sidebar-container");
    if (sidebar) {
      sessionStorage.setItem("sidebar-scroll-position", sidebar.scrollTop.toString());
    }
  });
</script>